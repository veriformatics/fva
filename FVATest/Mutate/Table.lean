import FVATest.Mutate.Util

/-!
# Results rows, local cache, rulings (contract R1, R4, L1–L2)

Row = `id ⇥ key ⇥ outcome ⇥ killer ⇥ deps`: `key` = sha256 of the module bytes + the edits,
`deps` = sha256 of the execution manifest + the outcome's input files (R2). Ruling =
`id ⇥ snippet ⇥ verdict ⇥ decl digest ⇥ contract ⇥ reviewer ⇥ reason`.
-/

namespace FVA.Mutate

/-- One mutant's recorded execution. -/
structure Row where
  /-- Mutant id. -/
  id : String
  /-- Mutant key. -/
  key : String
  /-- `killed` `unviable` `downstream-unviable` `survived` `inconclusive`. -/
  outcome : String
  /-- Deciding stage + location, test name, or reason (`-` when none). -/
  killer : String
  /-- Dependency digest. -/
  deps : String
deriving BEq, Inhabited, Repr

/-- The TSV line. -/
def Row.line (r : Row) : String := s!"{r.id}\t{r.key}\t{r.outcome}\t{r.killer}\t{r.deps}"

/-- Recorded outcomes (`error` never gets a row). -/
def outcomes : List String :=
  ["killed", "unviable", "downstream-unviable", "survived", "inconclusive"]

/-- Parse a TSV line; an unknown outcome makes it malformed. -/
def Row.parse (l : String) : Option Row :=
  match l.splitOn "\t" with
  | [id, key, outcome, killer, deps] =>
    if outcomes.contains outcome then some { id, key, outcome, killer, deps } else none
  | _ => none

/-- Outcomes that need a ruling. -/
def needsRuling (outcome : String) : Bool := outcome == "survived" || outcome == "inconclusive"

/-- Header of the committed table. -/
def tableHeader : String :=
  "# fvamut results (generated by scripts/test-mutation --update; contract " ++
  "docs/contracts/U12-mutation.md R1): id, key, outcome, killer, deps"

/-- Rows of a table file; `none` entries = malformed lines. -/
def readTable (path : System.FilePath) : IO (Array (Option Row)) := do
  unless ← path.pathExists do return #[]
  let ls := (← IO.FS.readFile path).splitOn "\n"
  return (ls.filter fun l => !l.isEmpty && !l.startsWith "#").toArray.map Row.parse

/-- Write rows sorted by id. -/
def writeTable (path : System.FilePath) (rows : Array Row) : IO Unit := do
  let sorted := rows.qsort (·.id < ·.id)
  IO.FS.writeFile path ("\n".intercalate (tableHeader :: (sorted.map Row.line).toList) ++ "\n")

/-- Cache file of one execution. -/
def cacheFile (dir : System.FilePath) (idHash key : String) : System.FilePath :=
  dir / "exec" / s!"{idHash.take 24}-{key.take 24}.tsv"

/-- A recorded execution from the local cache. -/
def readCache (dir : System.FilePath) (idHash key : String) : IO (Option Row) := do
  let f := cacheFile dir idHash key
  unless ← f.pathExists do return none
  return Row.parse ((← IO.FS.readFile f).trimAscii.toString)

/-- Record an execution in the local cache. -/
def writeCache (dir : System.FilePath) (idHash : String) (r : Row) : IO Unit := do
  IO.FS.createDirAll (dir / "exec")
  IO.FS.writeFile (cacheFile dir idHash r.key) (r.line ++ "\n")

/-- A ruling line. -/
structure Ruling where
  /-- Mutant id. -/
  id : String
  /-- Escaped `orig → repl`. -/
  snippet : String
  /-- `equivalent` `unspecified` `resource`. -/
  verdict : String
  /-- sha256 (16 hex) of the mutated declaration's source text. -/
  decl : String
  /-- `path@<16 hex>` of the governing contract, or `-`. -/
  contract : String
  /-- Who ruled. -/
  reviewer : String
  /-- The argument. -/
  reason : String
deriving Inhabited, Repr

/-- Parse the rulings file; malformed lines reported as errors. -/
def readRulings (path : System.FilePath) : IO (Array Ruling × Array String) := do
  unless ← path.pathExists do return (#[], #[])
  let mut out := #[]
  let mut bad := #[]
  for l in (← IO.FS.readFile path).splitOn "\n" do
    if l.isEmpty || l.startsWith "#" then continue
    match l.splitOn "\t" with
    | [id, snippet, verdict, decl, contract, reviewer, reason] =>
      if out.any (·.id == id) then bad := bad.push s!"duplicate ruling id {id}"
      else if ["equivalent", "unspecified", "resource"].contains verdict then
        out := out.push { id, snippet, verdict, decl, contract, reviewer, reason }
      else bad := bad.push s!"unknown verdict {verdict}: {id}"
    | _ => bad := bad.push s!"malformed ruling line: {l.take 80}"
  return (out, bad)

/-- Escaped snippet of a mutant (`orig → repl`). -/
def snippetOf (orig repl : String) : String := s!"{esc orig} → {esc repl}"

end FVA.Mutate
