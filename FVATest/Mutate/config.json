{
  "srcRoots": ["FVA", "FVATest", "Main.lean", "FVA.lean"],
  "exclude": ["FVATest/Mutate", "FVATest/Cheats", "FVATest/Examples", "FVATest/Certs/Neg"],
  "exeRoots": ["Main", "FVATest.Main"],
  "proofRoots": ["FVA", "FVATest.Certs"],
  "exes": ["fva", "fvatest"],
  "shared": [".lake/packages", ".tools", ".cache/corpus"],
  "tools": [".tools/bin/wasmtime", ".tools/bin/wasm-tools"],
  "versions": [["lean", "--version"], ["lake", "--version"]],
  "keyFiles": ["lakefile.toml", "lake-manifest.json", "lean-toolchain"],
  "tests": [
    {"name": "decoder", "cmd": ["scripts/test-decoder"],
     "exeRoots": ["FVA.Tool.Decode", "FVA.Tool.Lift", "FVA.Tool.Encode", "FVA.Lifted"],
     "files": ["scripts/test-decoder", "scripts/fetch-corpus", "scripts/fetch-tools", "Main.lean",
               "FVATest/Main.lean"]},
    {"name": "numerics", "cmd": ["scripts/test-numerics"], "exeRoots": ["FVATest.Numeric"],
     "files": ["scripts/test-numerics", "scripts/fetch-corpus", "scripts/fetch-tools",
               "FVATest/Main.lean"]},
    {"name": "floatdiff", "cmd": ["scripts/test-floatdiff", "--fast"],
     "exeRoots": ["FVATest.FloatDiff"],
     "files": ["scripts/test-floatdiff", "scripts/fetch-tools", "FVATest/Main.lean"]},
    {"name": "spec", "cmd": ["scripts/test-spec", "--fast"], "exeRoots": ["FVATest.Spec"],
     "files": ["scripts/test-spec", "scripts/fetch-corpus", "scripts/fetch-tools",
               "FVATest/Main.lean"]},
    {"name": "difftest", "cmd": ["scripts/test-difftest", "--fast"],
     "exeRoots": ["FVA.Tool.Difftest"],
     "files": ["scripts/test-difftest", "scripts/fetch-corpus", "scripts/fetch-tools", "Main.lean",
               "bench/subjects/wasm"]}
  ],
  "groups": [
    {"name": "decode", "dirs": ["FVA/Impl/Decode"], "reachFrom": [], "within": "",
     "stages": ["module", "proofs", "exes", "test:decoder", "test:numerics", "test:spec",
                "test:difftest"]},
    {"name": "float", "dirs": ["FVA/Impl/Numerics"], "reachFrom": [], "within": "",
     "stages": ["module", "proofs", "exes", "test:floatdiff", "test:numerics", "test:spec",
                "test:difftest"]},
    {"name": "exec", "dirs": ["FVA/Impl/Exec"], "reachFrom": [], "within": "",
     "stages": ["module", "exes", "test:spec", "test:difftest", "proofs"]},
    {"name": "trust", "dirs": ["FVA/Trust/Verdict.lean"], "reachFrom": [], "within": "",
     "stages": ["module", "exes", "proofs"]},
    {"name": "cert", "dirs": ["FVA/Impl/Cert"], "reachFrom": [], "within": "",
     "stages": ["module", "proofs"]},
    {"name": "valid", "dirs": ["FVA/Impl/Valid.lean"], "reachFrom": [], "within": "",
     "stages": ["module", "exes", "test:spec", "proofs"]},
    {"name": "helpers", "dirs": [],
     "reachFrom": ["decode", "float", "exec", "trust", "cert", "valid"], "within": "FVA.Spec",
     "stages": ["module", "exes", "test:spec", "test:numerics", "test:floatdiff",
                "test:difftest", "test:decoder", "proofs"]}
  ],
  "results": "FVATest/Mutate/results.tsv",
  "rulings": "FVATest/Mutate/rulings.tsv",
  "cacheDir": ".cache/mutate",
  "workers": 0,
  "spotChecks": 3,
  "minLimit": 60
}
