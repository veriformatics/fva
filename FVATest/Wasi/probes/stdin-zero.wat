(module
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "readone") (result i32 i32)
    (i32.store (i32.const 0) (i32.const 64)) (i32.store (i32.const 4) (i32.const 1))
    (i32.store (i32.const 40) (i32.const 0x1234))
    (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 40))
    (i32.load (i32.const 40)))
  (func (export "readzero") (result i32 i32)
    (i32.store (i32.const 0) (i32.const 64)) (i32.store (i32.const 4) (i32.const 0))
    (i32.store (i32.const 40) (i32.const 0x1234))
    (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 40))
    (i32.load (i32.const 40)))
  (func (export "readnone") (result i32 i32)
    (i32.store (i32.const 40) (i32.const 0x1234))
    (call $read (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 40))
    (i32.load (i32.const 40)))
  (func (export "writezero") (result i32 i32)
    (i32.store (i32.const 0) (i32.const 64)) (i32.store (i32.const 4) (i32.const 0))
    (i32.store (i32.const 40) (i32.const 0x1234))
    (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 40))
    (i32.load (i32.const 40))))
