#!/usr/bin/env bash
# Regenerate one fixed-seed corpus; --check validates committed generated bytes.
set -euo pipefail
src=$(cd "$(dirname "$0")" && pwd)
check=0
if (($#)); then
	[[ $# == 1 && $1 == --check ]] || exit 2
	check=1
fi
root=$(cd "$src/../../.." && pwd)
mkdir -p "$root/.cache/wasi-run"
tmp=$(mktemp -d "$root/.cache/wasi-run/make.XXXXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
jq -nc -f "$src/cases.jq" >"$tmp/cases.json"
jq '[.cases[].id]' "$tmp/cases.json" >"$tmp/case-ids.json"
jq -r '["id","basis","rows","program"],(.cases[]|[.id,.basis,(.rows|join(",")),.program])|@tsv' "$tmp/cases.json" >"$tmp/cases.tsv"
"$src/build" "$tmp/build"
cp "$tmp/build/sha256" "$tmp/wasm.sha256"
for name in cases.json case-ids.json cases.tsv wasm.sha256; do
	if ((check)); then
		cmp "$src/$name" "$tmp/$name" || {
			printf 'STALE %s\n' "$name" >&2
			exit 1
		}
	else
		cp "$tmp/$name" "$src/$name"
	fi
done
printf 'wasi-run make: %s cases, WAT hashes current\n' "$(jq '.cases|length' "$tmp/cases.json")"
