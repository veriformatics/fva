(func (export "_start") (local $fd i32)
  (local.set $fd (call $file (i32.const 3) (i32.const 16448) (i32.const 10) (i32.const 1) (i64.const 64)))
  (call $emit (local.get $fd) (i32.const 16512) (i32.const 2))
  (call $ok (call $close (local.get $fd)))
  (local.set $fd (call $file (i32.const 4) (i32.const 16448) (i32.const 10) (i32.const 1) (i64.const 64)))
  (call $emit (local.get $fd) (i32.const 16514) (i32.const 4))
  (call $ok (call $close (local.get $fd)))
  (call $ok (call $close (i32.const 3)))
  (call $ok (call $close (i32.const 4))))
