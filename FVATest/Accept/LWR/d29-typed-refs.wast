;; D29/U28a-c: typed calls, null refinements, table initializers, unset nondefaultable locals.
(module
  (type $sig (func (param i32) (result i32)))
  (func $id (type $sig) (param i32) (result i32) (local.get 0))
  (elem declare func $id)
  (table 1 1 (ref $sig) (ref.func $id))
  (func $on-null (param (ref null $sig)) (result i32)
    (block $null
      (i32.const 17)
      (local.get 0)
      (br_on_null $null)
      (call_ref $sig)
      (return))
    (i32.const -1))
  (func $on-non-null (param (ref null $sig)) (result i32)
    (block $nonnull (result (ref $sig))
      (local.get 0)
      (br_on_non_null $nonnull)
      (return (i32.const -2)))
    (local.set 0)
    (call_ref $sig (i32.const 18) (ref.as_non_null (local.get 0))))
  (func (export "null-branch") (result i32) (call $on-null (ref.null $sig)))
  (func (export "nonnull-branch") (result i32) (call $on-null (ref.func $id)))
  (func (export "null-fallthrough") (result i32) (call $on-non-null (ref.null $sig)))
  (func (export "nonnull-taken") (result i32) (call $on-non-null (ref.func $id)))
  (func (export "as-non-null") (result i32)
    (call_ref $sig (i32.const 19) (ref.as_non_null (ref.func $id))))
  (func (export "null-as-non-null") (drop (ref.as_non_null (ref.null $sig))))
  (func (export "null-call-ref") (result i32)
    (call_ref $sig (i32.const 20) (ref.null $sig)))
  (func (export "table-initializer") (result i32)
    (call_ref $sig (i32.const 21) (table.get (i32.const 0))))
  (func (export "set-before-get") (param i32) (result i32)
    (local $f (ref $sig))
    (local.set $f (ref.func $id))
    (call_ref $sig (local.get 0) (local.get $f)))
)
(assert_return (invoke "null-branch") (i32.const -1))
(assert_return (invoke "nonnull-branch") (i32.const 17))
(assert_return (invoke "null-fallthrough") (i32.const -2))
(assert_return (invoke "nonnull-taken") (i32.const 18))
(assert_return (invoke "as-non-null") (i32.const 19))
(assert_trap (invoke "null-as-non-null") "null reference")
(assert_trap (invoke "null-call-ref") "null reference")
(assert_return (invoke "table-initializer") (i32.const 21))
(assert_return (invoke "set-before-get" (i32.const -2147483648)) (i32.const -2147483648))
(assert_invalid
  (module (type $t (func))
    (func (local $unset (ref $t)) (drop (local.get $unset))))
  "uninitialized local")
(assert_invalid
  (module (type $t (func)) (func $f) (elem declare func $f)
    (func (param i32) (local $maybe (ref $t))
      (if (local.get 0) (then (local.set $maybe (ref.func $f))))
      (drop (local.get $maybe))))
  "uninitialized local")
