;; D29/U28b: throw_ref keeps the tag address + payload; handlers disappear on tail calls.
(module
  (type $sig (func (param i32) (result i32)))
  (tag $one (param i32))
  (tag $same-shape (param i32))
  (func $raise (type $sig) (param i32) (result i32)
    (throw $one (local.get 0)))
  (elem declare func $raise)
  (table funcref (elem $raise))
  (func (export "rethrow-address-payload") (result i32)
    (local $saved exnref)
    (block $outer (result i32)
      (try_table (catch $one $outer)
        (block $wrong (result i32)
          (try_table (catch $same-shape $wrong)
            (block $again (result exnref)
              (try_table (catch_all_ref $again)
                (block $first (result i32 exnref)
                  (try_table (catch_ref $one $first) (throw $one (i32.const 1234567)))
                  (unreachable))
                (local.set $saved)
                (drop)
                (throw_ref (local.get $saved)))
              (unreachable))
            (throw_ref))
          (unreachable))
        (drop)
        (return (i32.const -99)))
      (unreachable)))
  (func $direct (type $sig) (param i32) (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught) (return_call $raise (local.get 0)))
      (return))
    (drop) (i32.const -1))
  (func $indirect (type $sig) (param i32) (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught)
        (return_call_indirect (type $sig) (local.get 0) (i32.const 0)))
      (return))
    (drop) (i32.const -2))
  (func $typed (type $sig) (param i32) (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught)
        (return_call_ref $sig (local.get 0) (ref.func $raise)))
      (return))
    (drop) (i32.const -3))
  (func (export "tail-direct") (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught) (call $direct (i32.const 101)))
      (return)))
  (func (export "tail-indirect") (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught) (call $indirect (i32.const 102)))
      (return)))
  (func (export "tail-ref") (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $one $caught) (call $typed (i32.const 103)))
      (return)))
)
(assert_return (invoke "rethrow-address-payload") (i32.const 1234567))
(assert_return (invoke "tail-direct") (i32.const 101))
(assert_return (invoke "tail-indirect") (i32.const 102))
(assert_return (invoke "tail-ref") (i32.const 103))
