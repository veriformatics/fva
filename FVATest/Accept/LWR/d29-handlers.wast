;; D29/U28b: ordered tag-address matching; catch targets are outside try_table's label.
(module
  (tag $pair (param i32 i64))
  (tag $other)
  (func $raise (param i32) (local.get 0) (i64.const -7) (throw $pair))
  (func $middle (param i32) (call $raise (local.get 0)))
  (func (export "catch-payload") (param i32) (result i32 i64)
    (block $caught (result i32 i64)
      (try_table (catch $pair $caught) (call $middle (local.get 0)))
      (unreachable)))
  (func (export "catch-ref-payload") (param i32) (result i32 i64 i32)
    (block $caught (result i32 i64 exnref)
      (try_table (catch_ref $pair $caught) (call $raise (local.get 0)))
      (unreachable))
    (ref.is_null))
  (func (export "catch-all") (result i32)
    (block $caught
      (try_table (catch_all $caught) (throw $pair (i32.const 99) (i64.const 17)))
      (unreachable))
    (i32.const 23))
  (func (export "catch-all-ref") (result i32)
    (block $caught (result exnref)
      (try_table (catch_all_ref $caught) (throw $other))
      (unreachable))
    (ref.is_null))
  (func (export "first-duplicate") (result i32)
    (block $second
      (block $first
        (try_table (catch $other $first) (catch $other $second) (throw $other))
        (unreachable))
      (return (i32.const 11)))
    (i32.const 22))
  (func (export "all-before-specific") (result i32)
    (block $second
      (block $first
        (try_table (catch_all $first) (catch $other $second) (throw $other))
        (unreachable))
      (return (i32.const 33)))
    (i32.const 44))
  (func (export "wrong-tag") (result i32)
    (block $outer
      (try_table (catch_all $outer)
        (block $inner
          (try_table (catch $other $inner) (throw $pair (i32.const 8) (i64.const 9)))
          (unreachable))
        (return (i32.const 55)))
      (unreachable))
    (i32.const 66))
  (func (export "null-throw-ref") (throw_ref (ref.null exn)))
  (func (export "trap-not-caught")
    (block $caught (try_table (catch_all $caught) (unreachable))))
  (func (export "div-not-caught")
    (block $caught
      (try_table (catch_all $caught)
        (drop (i32.div_u (i32.const 1) (i32.const 0))))))
  (func (export "uncaught") (call $middle (i32.const 71)))
  (func (export "branch-through") (result i32)
    (block $exit (result i32)
      (block $caught
        (try_table (catch_all $caught) (br $exit (i32.const 81)))
        (unreachable))
      (i32.const 82)))
  (func (export "return-through") (result i32)
    (block $caught
      (try_table (catch_all $caught) (return (i32.const 91))))
    (i32.const 92))
  (func (export "handler-does-not-catch-itself")
    (block $caught
      (try_table (catch $other $caught) (throw $other))
      (unreachable))
    (throw $other))
)
(assert_return (invoke "catch-payload" (i32.const -2147483648))
  (i32.const -2147483648) (i64.const -7))
(assert_return (invoke "catch-payload" (i32.const 2147483647))
  (i32.const 2147483647) (i64.const -7))
(assert_return (invoke "catch-ref-payload" (i32.const 123))
  (i32.const 123) (i64.const -7) (i32.const 0))
(assert_return (invoke "catch-all") (i32.const 23))
(assert_return (invoke "catch-all-ref") (i32.const 0))
(assert_return (invoke "first-duplicate") (i32.const 11))
(assert_return (invoke "all-before-specific") (i32.const 33))
(assert_return (invoke "wrong-tag") (i32.const 66))
(assert_trap (invoke "null-throw-ref") "null reference")
(assert_trap (invoke "trap-not-caught") "unreachable")
(assert_trap (invoke "div-not-caught") "integer divide by zero")
(assert_exception (invoke "uncaught"))
(assert_return (invoke "branch-through") (i32.const 81))
(assert_return (invoke "return-through") (i32.const 91))
(assert_exception (invoke "handler-does-not-catch-itself"))
