#!/usr/bin/env bash
# D28/U29c: build the count-only bustools wasm (docs/contracts/U29c-bustools.md C1) from bustools
# d4d7a283's sources (each file sha256-pinned, staged in a clean directory), FVA's stubs.cpp (the
# 17 aborting entry points) and the pinned wasi-sdk 34.0; the emitted bytes must be the pinned ones.
# Usage: build [OUT.wasm] (default: the placed bustools-count.wasm). Exit: 0 built, the pinned
# bytes; 1 other bytes; 2 setup (a fetch or pin failure, the SDK missing or not the pinned one,
# a compiler failure).
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
out=${1:-$here/bustools-count.wasm}
want=c6ee7ee98d218707fbfbab0dd728643476dc85d5234b78b661a833dd87a95297
src=https://raw.githubusercontent.com/BUStools/bustools/d4d7a283dbe9d34d2106e9ba31e2566413be6a70
files=(
	"src/BUSData.cpp 8119395570c3773a8bdd8b591ed0a0fded1a65598d3ffe737945e73a1afa0c4e"
	"src/BUSData.h 01175b6fad945d8a38dcec9799b7df554f1f63035c0c4b5410f8faee46d9e4ba"
	"src/bustools_capture.h deb0917bc23e211420d37a3bb4622efac5c3ee9ca5e8313ecf174b25e538c710"
	"src/bustools_clusterhist.h e0650b748ff17b36f97df0ba3d6b2545cf91cee7d07008ed9b505b42a9e438f5"
	"src/bustools_collapse.h 4616a6953b623b5b35e59349c717e397ad33572e35b0ef37312d3eedd0f5fa7d"
	"src/bustools_compress.h 43559e295dd45cffab95c511e1b7d3c6c4f3cc3d49f8cb1fa0236a2222d085bd"
	"src/bustools_correct.h 1116a0aa6e9df41ac92dd4bd4badc4429f39c260074b39cc3b9846740f3f9c20"
	"src/bustools_count.cpp d71cf645102c27083a8cf9e9ac467f28b4da0b6ad7ce99b312ea0b3a48e9723d"
	"src/bustools_count.h d1645f3064c01eb2b664e1cf1b1b409ab4c6c046efc8f57d830a4c9af291ade8"
	"src/bustools_decompress.h 4c6b5a9e195c983a7130c36c033f54ca437c4b782a58431eb0ac45b729594f36"
	"src/bustools_extract.h b90d29bbfff58d4720578960055af72b32919127ac2a5a6d96ee7e6a15da229a"
	"src/bustools_inspect.h 56c1bef9c4e34ed6aae3950acaf2c509eaaca06940d9c8544dc579e0f4306bb7"
	"src/bustools_linker.h f44f7872c43cb9e8c910c7393b67bcbb43a685421f4606a021cc9f624bcd80af"
	"src/bustools_main.cpp 44e834f8926efbca6803f718f0570dff2f56973d7c1de8e4bca712c332b4d412"
	"src/bustools_mash.h 53e11c5bf76426b95885934c75126f31016058d6e723f171eac8d3385796b629"
	"src/bustools_merge.h caf413366e49e733f7768638afa0afc3e18fb52909dca7eade6e48f837122a6f"
	"src/bustools_predict.h 2e4fdf388c30402dc362d814d476876cac5e5e49b8aee961d21d43f177096a29"
	"src/bustools_project.h d200252d74296b6f99c84aa41e45a17b4fee0f71e8c6f3fa2720a5e7b5663634"
	"src/bustools_sort.h 48d2e810bf83fb860eef3b4904ee6aae5144c0fcdb5d2b98ab77367d555c4ac9"
	"src/bustools_text.cpp 92f2367630947c1b30dd1683b8eb95d8ea0e4493789e0713f2f4666050bfdcac"
	"src/bustools_text.h ed07659ef505d24651aae2eda5a3b69e103dc5481d4eb5ccd0ddd43018a8abea"
	"src/bustools_umicorrect.h 0dd5c9a2b13dad2d47d19b4ec9685e1762108dd99340f34f904ece2eb4aaf5c4"
	"src/bustools_whitelist.h 03cd583ff4c8d6ae5ec1b2f11316148904f5c260a34b831f25e83055238abbc8"
	"src/Common.cpp 18964c13ce6f6de50707bc5860796f7ab56dc87037405e8812e762f141f86c46"
	"src/Common.hpp 12735e64d688652e54458b2783b41254a9bc6cfc31aa8458739abc2b7b533df4"
	"src/hash.cpp 25e758696da7311eee4e8d2f02a0ab59ca620db8598a83f40083f0d1b0be84fe"
	"src/hash.hpp 1d175a3131a04dfbfc31fede3d9126102b5251129c3c07e692ca92b4cedd50e4"
	"src/roaring.h 774132ce51ad4ad89cee4d3b099fb7bf0fcc69d015dca96bf5757e42382ae55a"
	"src/roaring.hh 98ba1140f52cbb7de34e12405b31ab2ccf3e194e09990a60c371cf8556ccb7f0"
)
if [[ -n ${WASI_SDK_PATH:-} ]]; then
	sdk=$WASI_SDK_PATH
else
	sdk=$root/.tools/wasi-sdk
	if [[ ! -e $sdk/.pin-34.0 ]]; then
		"$root/scripts/fetch-bench-tools" wasi-sdk >&2 || {
			echo "build: fetching wasi-sdk 34.0 failed" >&2
			exit 2
		}
	fi
fi
pinned='34.0
wasi-libc: 2e6fb9d8ee0c
llvm: 895aa2c896ad
llvm-version: 23.1.0
config: f992bcc08219'
if [[ $(cat "$sdk/VERSION" 2>/dev/null) != "$pinned" ]]; then
	echo "build: $sdk is not the pinned wasi-sdk 34.0 (its VERSION differs)" >&2
	exit 2
fi
stage=$(mktemp -d) || exit 2
trap 'rm -rf "$stage"' EXIT
# each source: its cached copy when it matches the pin, else a download; every file checked
cache=$root/.cache/bench/bustools-d4d7a283
mkdir -p "$cache" "$stage/obj" || exit 2
for row in "${files[@]}"; do
	read -r path sha <<<"$row"
	c=$cache/${path//\//_}
	if [[ ! -f $c || $(sha256sum "$c" | cut -d' ' -f1) != "$sha" ]]; then
		curl -fsSL --retry 3 -o "$c.part" "$src/$path" || {
			echo "build: fetching $path failed" >&2
			exit 2
		}
		mv "$c.part" "$c" || exit 2
	fi
	if [[ $(sha256sum "$c" | cut -d' ' -f1) != "$sha" ]]; then
		echo "build: $path does not match its pinned sha256" >&2
		exit 2
	fi
	mkdir -p "$stage/$(dirname "$path")" && cp "$c" "$stage/$path" || exit 2
done
# every source compiles from the stage under one prefix map: an assert's __FILE__ (BUSData.cpp)
# lands in the binary, so a host path would make the bytes host-dependent (and personal)
cp "$here/stubs.cpp" "$stage/src/stubs.cpp" || exit 2
cxx=("$sdk/bin/clang++" --target=wasm32-wasip1 -O2 -fwasm-exceptions -mllvm -wasm-use-legacy-eh=false
	"-ffile-prefix-map=$stage=/bustools")
for f in bustools_main bustools_count bustools_text Common BUSData hash; do
	"${cxx[@]}" -std=c++11 -D_WASI_EMULATED_GETPID -w -c "$stage/src/$f.cpp" -o "$stage/obj/$f.o" ||
		exit 2
done
"${cxx[@]}" -std=c++11 -I"$stage/src" -w -c "$stage/src/stubs.cpp" -o "$stage/obj/stubs.o" || exit 2
# link order + output basename pinned: wasm-ld writes the basename into the name section
objs=()
for o in BUSData Common bustools_count bustools_main bustools_text hash stubs; do objs+=("$stage/obj/$o.o"); done
"${cxx[@]}" "${objs[@]}" -o "$stage/bustools-count.wasm" \
	-lunwind -lwasi-emulated-getpid -Wl,--strip-debug || exit 2
cp "$stage/bustools-count.wasm" "$out" && chmod 644 "$out" || exit 2
got=$(sha256sum "$out" | cut -d' ' -f1)
if [[ $got != "$want" ]]; then
	echo "build: $out has sha256 $got, not the pinned $want" >&2
	exit 1
fi
