#!/usr/bin/env bash
# D28/U29c C1: the count-only bustools wasm's fingerprint over `wasm-tools print` (independent of
# FVA's decoder): exactly the 20 pinned WASI preview1 imports at their signatures, exports
# `memory` + `_start` alone, the 17 aborting stubs (functions named as stubs.cpp's entry points,
# each body exactly `call $abort` + `unreachable`), the unlinked `bustools_sort_orig` absent,
# standard exception handling alone (>= 1 try_table, no legacy try/catch/catch_all/delegate/rethrow).
# Usage: fingerprint WASM. Exit: 0 match, 1 a mismatch (named), 2 setup.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
wasm=${1:?usage: fingerprint WASM}
wat=$(mktemp) && trap 'rm -f "$wat"' EXIT
"$root/.tools/bin/wasm-tools" print "$wasm" >"$wat" 2>/dev/null || {
	echo "fingerprint: wasm-tools print failed on $wasm" >&2
	exit 2
}
imports='wasi_snapshot_preview1 args_get (param i32 i32) (result i32)
wasi_snapshot_preview1 args_sizes_get (param i32 i32) (result i32)
wasi_snapshot_preview1 environ_get (param i32 i32) (result i32)
wasi_snapshot_preview1 environ_sizes_get (param i32 i32) (result i32)
wasi_snapshot_preview1 clock_time_get (param i32 i64 i32) (result i32)
wasi_snapshot_preview1 fd_close (param i32) (result i32)
wasi_snapshot_preview1 fd_fdstat_get (param i32 i32) (result i32)
wasi_snapshot_preview1 fd_fdstat_set_flags (param i32 i32) (result i32)
wasi_snapshot_preview1 fd_prestat_get (param i32 i32) (result i32)
wasi_snapshot_preview1 fd_prestat_dir_name (param i32 i32 i32) (result i32)
wasi_snapshot_preview1 fd_read (param i32 i32 i32 i32) (result i32)
wasi_snapshot_preview1 fd_seek (param i32 i64 i32 i32) (result i32)
wasi_snapshot_preview1 fd_write (param i32 i32 i32 i32) (result i32)
wasi_snapshot_preview1 path_create_directory (param i32 i32 i32) (result i32)
wasi_snapshot_preview1 path_filestat_get (param i32 i32 i32 i32 i32) (result i32)
wasi_snapshot_preview1 path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)
wasi_snapshot_preview1 path_remove_directory (param i32 i32 i32) (result i32)
wasi_snapshot_preview1 path_unlink_file (param i32 i32 i32) (result i32)
wasi_snapshot_preview1 proc_exit (param i32)
wasi_snapshot_preview1 random_get (param i32 i32) (result i32)'
stubs='bustools_capture(Bustools_opt&)
bustools_clusterhist(Bustools_opt&)
bustools_collapse(Bustools_opt&)
bustools_compress(Bustools_opt const&)
bustools_split_correct(Bustools_opt&)
bustools_correct(Bustools_opt&)
bustools_decompress(Bustools_opt const&)
bustools_extract(Bustools_opt const&)
bustools_inspect(Bustools_opt&)
bustools_linker(Bustools_opt&)
bustools_mash(Bustools_opt const&)
bustools_merge_different_index(Bustools_opt const&)
bustools_predict(Bustools_opt&)
bustools_project(Bustools_opt&)
bustools_sort(Bustools_opt const&)
bustools_umicorrect(Bustools_opt const&)
bustools_whitelist(Bustools_opt&)'
bad=0
got=$(grep '^  (import "' "$wat" |
	sed -E 's/^ *\(import "([^"]*)" "([^"]*)" \(func \$[^ ]* \(;[0-9]+;\) \(type [0-9]+\)(.*)\)\)$/\1 \2\3/')
if [[ $got != "$imports" ]]; then
	echo "fingerprint: imports differ from the pinned 20 (< pinned, > found):"
	diff <(printf '%s\n' "$imports") <(printf '%s\n' "$got") | head -10
	bad=1
fi
exports=$(grep -o '^  (export "[^"]*"' "$wat" | cut -d'"' -f2 | tr '\n' ' ')
[[ $exports == "memory _start " ]] || {
	echo "fingerprint: exports are '$exports', want memory + _start"
	bad=1
}
while IFS= read -r s; do
	body=$(awk -v h="  (func \$\"$s\" " 'index($0, h) == 1 {f = 1; next} f && /^  \)/ {exit} f {print}' "$wat" |
		sed 's/^ *//' | tr '\n' ';')
	[[ $body == "call \$abort;unreachable;" ]] || {
		echo "fingerprint: stub $s is not exactly call \$abort + unreachable (body: ${body:0:80})"
		bad=1
	}
done <<<"$stubs"
if grep -q 'bustools_sort_orig' "$wat"; then
	echo "fingerprint: bustools_sort_orig is linked (stubs.cpp's dead entry)"
	bad=1
fi
tt=$(grep -c 'try_table' "$wat")
legacy=$(grep -cE '^\s*(try|catch|catch_all|delegate|rethrow)\b' "$wat")
((tt > 0 && legacy == 0)) || {
	echo "fingerprint: exception handling try_table $tt, legacy $legacy (want >= 1 and 0)"
	bad=1
}
echo "fingerprint: imports 20, exports memory _start, stubs 17, try_table $tt, legacy $legacy"
exit "$bad"
