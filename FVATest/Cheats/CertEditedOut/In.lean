import FVA.Lifted
import FVA.Spec.Cert
/-! Generated by `fva blob` from 6 bytes; `fva trust` compares them with the file. -/

set_option linter.all false

namespace FVATest.Cheats.CertEditedOut.In

/-- The file's bytes (hex in file order), packed little-endian. -/
def bytes : Nat := wasm_bytes% "330a310a320a"

/-- The file's length in bytes. -/
def len : Nat := 6

/-- The file's path from the project root (`fva trust` compares its bytes). -/
def source : String := "FVATest/Cheats/CertEditedOut/in.txt"

/-- The file as a certificate blob. -/
def blob : FVA.Cert.Blob := ⟨bytes, len⟩

end FVATest.Cheats.CertEditedOut.In
