import FVA.Lifted
import FVA.Spec.Cert
/-! Generated by `fva blob` from 4 bytes; `fva trust` compares them with the file. -/

set_option linter.all false

namespace FVATest.Certs.Neg.Trailing.Out

/-- The file's bytes (hex in file order), packed little-endian. -/
def bytes : Nat := wasm_bytes% "310a0000"

/-- The file's length in bytes. -/
def len : Nat := 4

/-- The file's path from the project root (`fva trust` compares its bytes). -/
def source : String := "FVATest/Certs/Neg/trailing-out.txt"

/-- The file as a certificate blob. -/
def blob : FVA.Cert.Blob := ⟨bytes, len⟩

end FVATest.Certs.Neg.Trailing.Out
