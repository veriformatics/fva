import FVA.Tool.Pack

/-!
# `fva blob`: a file as a Lean module of its bytes (a certificate's input or output)

The printer is untrusted: `fva trust` compares the numeral and the length with the file and
requires the module to be exactly this printer's output (no added declaration or syntax).
-/

namespace FVA.Tool.Blob

/-- The module `fva blob` writes for the file at `source` (project-relative) holding `bytes`. -/
def file (ns : String) (bytes : ByteArray) (source : String) : String :=
  "import FVA.Lifted\nimport FVA.Spec.Cert\n" ++
  s!"/-! Generated by `fva blob` from {bytes.size} bytes; `fva trust` compares them with the " ++
    "file. -/\n\n" ++
  "set_option linter.all false\n\n" ++
  s!"namespace {ns}\n\n" ++
  "/-- The file's bytes (hex in file order), packed little-endian. -/\n" ++
  s!"def bytes : Nat := wasm_bytes% \"{toHex bytes}\"\n\n" ++
  s!"/-- The file's length in bytes. -/\ndef len : Nat := {bytes.size}\n\n" ++
  "/-- The file's path from the project root (`fva trust` compares its bytes). -/\n" ++
  s!"def source : String := {source.quote}\n\n" ++
  "/-- The file as a certificate blob. -/\ndef blob : FVA.Cert.Blob := ⟨bytes, len⟩\n\n" ++
  s!"end {ns}\n"

end FVA.Tool.Blob
