#!/usr/bin/env bash
# Third-party bytes carry their notice (D57): every committed file whose `wasm_bytes% "<hex>"`
# literal is a third-party artifact of bench/subjects/manifest.json (`subjects` + `builds`, matched
# by sha256 of the bytes) needs a NOTICE in its directory or an ancestor naming that artifact's
# sha256, license, upstream, version and its corresponding source (the words "corresponding
# source"): BSD-2-Clause binary redistribution reproduces the notice, GPL-2.0 the source offer.
# rc 0 clean, 1 findings, 2 setup.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
manifest=bench/subjects/manifest.json
[[ -r $manifest ]] || exit 2
# A missing decoder would hash every literal as empty input: no artifact matches, the check passes.
command -v xxd >/dev/null || {
	echo "check-notices: xxd not found" >&2
	exit 2
}
declare -A fields
while IFS=$'\t' read -r sha license upstream version; do
	fields[$sha]=$license$'\t'$upstream$'\t'$version
done < <(jq -r '(.subjects + (.builds // []))[] | [.sha256, .license, .upstream, .version] | @tsv' \
	"$manifest") || exit 2
((${#fields[@]})) || exit 2
# the nearest-first NOTICE files of a path's directory and its ancestors
notices() {
	local d=${1%/*}
	[[ $d == "$1" ]] && d=.
	while :; do
		[[ -f $d/NOTICE ]] && printf '%s\n' "$d/NOTICE"
		[[ $d == . ]] && break
		[[ $d == */* ]] && d=${d%/*} || d=.
	done
}
fail=0
while IFS= read -r -d '' f; do
	while IFS= read -r hex; do
		[[ -n $hex ]] || continue
		sha=$(xxd -r -p <<<"$hex" | sha256sum | cut -d' ' -f1) || {
			echo "check-notices: $f: cannot decode a wasm_bytes% literal" >&2
			exit 2
		}
		[[ -n ${fields[$sha]+x} ]] || continue
		IFS=$'\t' read -r license upstream version <<<"${fields[$sha]}"
		ok=0
		while IFS= read -r n; do
			if grep -qF -- "$sha" "$n" && grep -qF -- "$license" "$n" && grep -qF -- "$upstream" "$n" &&
				grep -qF -- "$version" "$n" && grep -qi -- 'corresponding source' "$n"; then
				ok=1
				break
			fi
		done < <(notices "$f")
		if ((! ok)); then
			echo "check-notices: $f embeds $sha ($license, $upstream $version): no NOTICE here or above" \
				"names its sha256, license, upstream, version and corresponding source"
			fail=1
		fi
	done < <(grep -oE 'wasm_bytes% "[0-9a-f]+"' "$f" | sed 's/^wasm_bytes% "//; s/"$//')
done < <(git ls-files -z | xargs -0 grep -lZ 'wasm_bytes% "[0-9a-f]' --)
exit "$fail"
