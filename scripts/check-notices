#!/usr/bin/env bash
# Nothing third-party committed (Decisions: Repository contents; U33, was D57's notice rule): no
# committed file whose sha256 is an artifact of bench/subjects/manifest.json (`subjects`,
# `builds`, `archives`), and no committed `wasm_bytes% "<hex>"` literal whose bytes are one — a
# lifted third-party module stays generated (scripts/test-subjects), its binary fetched
# (scripts/fetch-subjects, fetch-corpus); a NOTICE no longer admits either. rc 0 clean,
# 1 findings, 2 setup.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
manifest=bench/subjects/manifest.json
[[ -r $manifest ]] || exit 2
# A missing decoder would hash every literal as empty input: no artifact matches, the check passes.
command -v xxd >/dev/null || {
	echo "check-notices: xxd not found" >&2
	exit 2
}
declare -A ids
while IFS=$'\t' read -r sha id; do
	ids[$sha]=$id
done < <(jq -r '(.subjects + (.builds // []) + (.archives // []))[] | [.sha256, .id] | @tsv' \
	"$manifest") || exit 2
((${#ids[@]})) || exit 2
fail=0
while IFS= read -r line; do
	sha=${line%% *} f=${line#*  }
	if [[ -n ${ids[$sha]+x} ]]; then
		echo "check-notices: $f is the third-party artifact ${ids[$sha]} ($sha): fetch it, never commit it"
		fail=1
	fi
done < <(git ls-files -z | xargs -0 -r sha256sum --) || exit 2
while IFS= read -r -d '' f; do
	while IFS= read -r hex; do
		[[ -n $hex ]] || continue
		sha=$(xxd -r -p <<<"$hex" | sha256sum | cut -d' ' -f1) || {
			echo "check-notices: $f: cannot decode a wasm_bytes% literal" >&2
			exit 2
		}
		if [[ -n ${ids[$sha]+x} ]]; then
			echo "check-notices: $f embeds the third-party artifact ${ids[$sha]} ($sha): a lifted" \
				"third-party module stays generated, never committed"
			fail=1
		fi
	done < <(grep -oE 'wasm_bytes% "[0-9a-f]+"' "$f" | sed 's/^wasm_bytes% "//; s/"$//')
done < <(git ls-files -z | xargs -0 grep -lZ 'wasm_bytes% "[0-9a-f]' --)
exit "$fail"
