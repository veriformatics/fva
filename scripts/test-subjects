#!/usr/bin/env bash
# U14 subject demonstrations (E1/E2, full gate): each subject package under FVATest/Subjects/
# is `fva trust` PASS with its review surface pinned, claims about the lifted subject (link check
# against the subject's .wasm: FVA's own committed, a third-party one fetched); each FVATest/Subjects/<Subj>/Neg/* module must fail to build (a
# mutated expected byte or weakened spec clause). rc 0 = all as pinned.
# --shard K/N = the checks of the directories `shard` maps to K (all = every one) of the gate's N
# (scripts/gate: CI job subjects-K); --list prints them and exits.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
fva=.lake/build/bin/fva
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fail=0 crash=0

# subject: root module, spec module, subject (lifted) module or - (a certificate), pinned surface
subjects=(
	"FVATest.Subjects.Lz4Wasm FVATest.Subjects.Lz4Wasm.Spec FVATest.Subjects.Lz4Wasm.Lifted 48"
	"FVATest.Subjects.GlmIround FVATest.Subjects.GlmIround.Spec FVATest.Subjects.GlmIround.Lifted 10"
	"FVATest.Subjects.GlmCall.Proof FVATest.Subjects.GlmCall.Spec FVATest.Subjects.GlmIround.Lifted 8"
	"FVATest.Subjects.Tmm.R3 FVATest.Subjects.Tmm.R3.Spec - 22"
	"FVATest.Subjects.Tmm.EdgeR FVATest.Subjects.Tmm.EdgeR.Spec - 78"
	"FVATest.Subjects.Tmm.RNAnorm FVATest.Subjects.Tmm.RNAnorm.Spec - 78"
	"FVATest.Subjects.EdgerCpm FVATest.Subjects.EdgerCpm.Spec FVATest.Subjects.EdgerCpm.Lifted 91"
	"FVATest.Subjects.Lz4C.Proof FVATest.Subjects.Lz4C.Spec FVATest.Subjects.Lz4C.Lifted 76"
)
# proof-only modules (no claims yet): U19 checkpoint 1, the lz4 C extension loop proven by both
# routes on the shipped -O2 bytes and on the -O1 perturbation; U20's spike statements (Short imports
# Copy), the decoder's cutpoint statements (Seg), the model + its format proofs (ModelProof), the
# memory-to-prefix adapters (Prefix, Match), R1-R3 from the cutpoint statements (Loop, Sim, Top)
# + the cutpoint proofs (Cut/* by stepping, Eval/* by engine C, Eval.Accept = their frozen types),
# the acceptance runs of Spec's R1-R3 (Accept) + its one-clause mutants refuted on
# the shipped bytes (Refute/*); --wfail turns a `sorry` into a failure
proofs=(FVATest.Subjects.Lz4C.ExtDirect FVATest.Subjects.Lz4C.ExtRefine
	FVATest.Subjects.Lz4C.O1.ExtDirect FVATest.Subjects.Lz4C.O1.ExtRefine FVATest.Subjects.Lz4C.Instance
	FVATest.Subjects.Lz4C.Short FVATest.Subjects.Lz4C.ModelProof FVATest.Subjects.Lz4C.Prefix
	FVATest.Subjects.Lz4C.Seg FVATest.Subjects.Lz4C.Loop FVATest.Subjects.Lz4C.Top
	FVATest.Subjects.Lz4C.Match FVATest.Subjects.Lz4C.Cut.ErrRet FVATest.Subjects.Lz4C.Cut.Entry
	FVATest.Subjects.Lz4C.Cut.ExtB FVATest.Subjects.Lz4C.Eval.Accept
	FVATest.Subjects.Lz4C.Accept FVATest.Subjects.Lz4C.Refute.LastWrite
	FVATest.Subjects.Lz4C.Refute.Length FVATest.Subjects.Lz4C.Refute.Nonnegative
	FVATest.Subjects.GlmCall.Step)
# the Neg roots are no default target; build them by module name, expecting failure
negs=(FVATest.Subjects.Lz4Wasm.Neg.EndClause FVATest.Subjects.Lz4Wasm.Neg.Byte
	FVATest.Subjects.GlmIround.Neg.Ret FVATest.Subjects.Tmm.Neg.Same FVATest.Subjects.Tmm.Neg.Exact)

# CI fan-out: each directory's rows, proof roots, negatives + own checks (`blocks`, guarded by
# `block`) run in one shard; the map fails closed before any fetch (rc 2): a directory without a
# shard or owning no check, a shard outside 1..N or holding no directory
declare -A shard=(
	[EdgerCpm]=1
	[GlmCall]=2
	[GlmIround]=2
	[Tmm]=2
	[Lz4C]=3
	[Lz4Wasm]=3
)
blocks=(GlmCall)
k=all n='' list=0
while (($#)); do
	case $1 in
	--shard)
		[[ ${2:-} =~ ^(all|[1-9][0-9]*)/([1-9][0-9]*)$ ]] || {
			echo "test-subjects: --shard K/N, K = 1..N or all (got '${2:-}')"
			exit 2
		}
		k=${BASH_REMATCH[1]} n=${BASH_REMATCH[2]}
		shift 2
		;;
	--list)
		list=1
		shift
		;;
	*)
		echo "test-subjects: unknown argument '$1' (--shard K/N, --list)"
		exit 2
		;;
	esac
done
bad() {
	echo "test-subjects: shard map: $*"
	exit 2
}
dir_of() { # FVATest.Subjects.<dir>[.…] → <dir>
	local m=${1#FVATest.Subjects.}
	echo "${m%%.*}"
}
declare -A owns=() held=()
for s in "${subjects[@]}"; do owns[$(dir_of "${s%% *}")]=1; done
for m in "${proofs[@]}" "${negs[@]}"; do owns[$(dir_of "$m")]=1; done
for d in "${blocks[@]}"; do owns[$d]=1; done
for d in "${!owns[@]}"; do [[ -n ${shard[$d]:-} ]] || bad "$d has no shard"; done
top=0
for d in "${!shard[@]}"; do
	[[ -n ${owns[$d]:-} ]] || bad "$d owns no check"
	[[ ${shard[$d]} =~ ^[1-9][0-9]*$ ]] || bad "$d → '${shard[$d]}', want 1..N"
	held[${shard[$d]}]+=" $d"
	((shard[$d] > top)) && top=${shard[$d]}
done
n=${n:-$top}
((top <= n)) || bad "${held[$top]# } → shard $top of $n"
[[ $k == all ]] || ((k <= n)) || bad "no shard $k of $n"
for ((s = 1; s <= n; s++)); do [[ -n ${held[$s]:-} ]] || bad "shard $s of $n holds no directory"; done
in_shard() { [[ $k == all || ${shard[$1]} == "$k" ]]; }
block() { # DIR → its own check runs in this shard (DIR listed in blocks)
	[[ " ${blocks[*]} " == *" $1 "* ]] || bad "block $1 is not in blocks"
	in_shard "$1"
}
keep=()
for s in "${subjects[@]}"; do in_shard "$(dir_of "${s%% *}")" && keep+=("$s"); done
subjects=("${keep[@]}") keep=()
for m in "${proofs[@]}"; do in_shard "$(dir_of "$m")" && keep+=("$m"); done
proofs=("${keep[@]}") keep=()
for m in "${negs[@]}"; do in_shard "$(dir_of "$m")" && keep+=("$m"); done
negs=("${keep[@]}")
if ((list)); then
	for s in "${subjects[@]}"; do echo "row ${s%% *}"; done
	for m in "${proofs[@]}"; do echo "proof $m"; done
	for m in "${negs[@]}"; do echo "neg $m"; done
	for d in "${blocks[@]}"; do in_shard "$d" && echo "block $d"; done
	exit 0
fi
echo "test-subjects: shard $k of $n:$(for d in "${!shard[@]}"; do in_shard "$d" && echo " $d"; done | sort | tr -d '\n')"
scripts/fetch-canaries || exit 2

# third-party subjects (Decisions: Repository contents) are fetched + lifted here, never committed:
# scripts/fetch-subjects places each binary, `fva lift` writes its Lifted module (rewritten only
# when its bytes change, so an unchanged module keeps Lake's trace)
scripts/fetch-subjects || exit 2
if ! lake --wfail build fva >"$tmp/build" 2>&1; then
	echo "test-subjects: fva build failed"
	exit 2
fi
for lift in EdgerCpm/edgeR.so:EdgerCpm Lz4Wasm/lz4-block-codec.wasm:Lz4Wasm Lz4C/lz4-c.wasm:Lz4C \
	Lz4C/O1/lz4-c-O1.wasm:Lz4C.O1 GlmIround/glm-iround.wasm:GlmIround; do
	bin=FVATest/Subjects/${lift%%:*} ns=Subjects.${lift#*:}.Lifted
	"$fva" lift "$bin" "$tmp/Lifted.lean" --ns "$ns" >/dev/null || exit 2
	cmp -s "$tmp/Lifted.lean" "${bin%/*}/Lifted.lean" || cp "$tmp/Lifted.lean" "${bin%/*}/Lifted.lean" ||
		exit 2
done

# D55: the GlmCall subject is `fva call`'s output for T7's input, byte for byte
if block GlmCall; then
	c=$tmp/call/FVATest/Subjects
	mkdir -p "$c/GlmIround" && cp FVATest/Subjects/GlmIround/{Lifted.lean,glm-iround.wasm} "$c/GlmIround/" ||
		exit 2
	(cd "$tmp/call" && "$OLDPWD/$fva" call FVATest/Subjects/GlmIround/Lifted.lean iround \
		f64:0x3fdfffffffffffff --spec FVATest/Subjects/GlmCall/Spec.lean \
		--proof FVATest/Subjects/GlmCall/Proof.lean --name iroundBelowHalf --ns Subjects.GlmCall) \
		>/dev/null || exit 2
	for f in Spec Proof; do
		if ! cmp -s "$c/GlmCall/$f.lean" "FVATest/Subjects/GlmCall/$f.lean"; then
			echo "test-subjects: FVATest/Subjects/GlmCall/$f.lean is not fva call's output (regenerate it)"
			fail=1
		fi
	done
fi

roots=(fva FVA "${proofs[@]}")
for s in "${subjects[@]}"; do
	read -r root _ _ _ <<<"$s"
	roots+=("$root")
done
if ! lake --wfail build "${roots[@]}" >"$tmp/build" 2>&1; then
	echo "test-subjects: subject build failed"
	grep '^error' "$tmp/build" | head -5
	exit 2
fi

# every subject's fva trust in default and --paranoid mode, fail closed (scripts/subject-matrix,
# docs/contracts/U22-subject-matrix.md)
# D74: a host that keeps .cache reuses each (root, mode) PASS whose input closure is unchanged
# (FVA_SUBJECT_CACHE= runs every subject; CI restores main's cache, D79)
if ((${#subjects[@]})); then
	printf '%s\n' "${subjects[@]}" | FVA=$fva FVA_SUBJECT_CACHE=${FVA_SUBJECT_CACHE-.cache/subjects} scripts/subject-matrix
	rc=$?
	((rc == 2)) && exit 2
	((rc == 3)) && crash=1
	((rc == 0)) || fail=1
fi

for neg in "${negs[@]}"; do
	if lake build "$neg" >"$tmp/neg" 2>&1; then
		echo "test-subjects: $neg built, but the mutated claim must not prove"
		fail=1
	fi
done

((fail)) || echo "test-subjects: ${#subjects[@]} subject(s) × default + paranoid PASS with pinned surface + ${#proofs[@]} proof module(s) built + ${#negs[@]} planted negatives checked"
((crash)) && exit 3
exit "$fail"
