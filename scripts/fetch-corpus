#!/usr/bin/env bash
# Fetch the pinned decoder corpus into .cache/corpus; every download is sha256-checked.
# Third-party binaries (GPL: lz4-wasm, edgeR) are fetched, never committed.
set -euo pipefail
cd "$(dirname "$0")/.."
dir=.cache/corpus
mkdir -p "$dir/testsuite"
ts=https://raw.githubusercontent.com/WebAssembly/testsuite/44f1503f98409fa3737437bf9449a37a5def4210
lz4wasm=https://raw.githubusercontent.com/gorhill/lz4-wasm/8995cdef7b3adc4a4d2fc4fc86b84a86789ff858

# destination url sha256
files=(
	"testsuite/binary.wast $ts/binary.wast 362e0bfa0075dfba9e7f5825deaaad1e8e3e1eeb5bc6f50f81284b0e1921a4dc"
	"testsuite/binary-leb128.wast $ts/binary-leb128.wast 785c4cbd50e3076200a8e7571cb6dc9cacd37009276fcfee633a7454368b6f61"
	"testsuite/custom.wast $ts/custom.wast 59067c2c216fe1d6ac1249dbf9fc33573fb23b45b1bf5cc8f8a6eca14cf96f10"
	"testsuite/utf8-custom-section-id.wast $ts/utf8-custom-section-id.wast 20f6802e8ae0c9515d10687934f8f43a9312dfc64a52761f629f5547a689cb3a"
	"testsuite/utf8-import-field.wast $ts/utf8-import-field.wast 1b9f2344c4b041c516079c5587c88d6fac1ec06c68d3328eaa5427f5b0242929"
	"testsuite/utf8-import-module.wast $ts/utf8-import-module.wast 20449f8bb0249777e33aee76472009b48ec2ea3d3ecc78a8b8004173b47223c0"
	"testsuite/utf8-invalid-encoding.wast $ts/utf8-invalid-encoding.wast 3a051a2d84a51c3bdb6f3eb34b4f498017b07dc065a6065ec24c63ae6f4545bf"
	"testsuite/i32.wast $ts/i32.wast f3b7e8fd641893ea0989a8ab801fce0654d276d27b5cad9cf482291a422cffe8"
	"testsuite/i64.wast $ts/i64.wast 7d0e27a617565e0685aef56cee01b2b4890084068e3989168c41d14c56b1945e"
	"testsuite/int_exprs.wast $ts/int_exprs.wast e8b884e16bdbed0270e9b912eaa60a0e8688831e7574be98c00a60dcc667ed2b"
	"testsuite/int_literals.wast $ts/int_literals.wast 1087900dd58f95f6c5db0c1ec7bbad1fb67b45accda5b079df2f3647cbb13038"
	"testsuite/f32.wast $ts/f32.wast 91c9e9edf5500659040c6b7657fbaa942ad6c0526d80d2ea558e406257a8674f"
	"testsuite/f64.wast $ts/f64.wast b8b85a753f13ae27d20ca8cb97ab58b30606854deb4fb829caac93785a90b0f7"
	"testsuite/f32_cmp.wast $ts/f32_cmp.wast dc16e4361250dbf9ef2b91481e25964d6c31f9f593f2e31f08d5b4f5028a376f"
	"testsuite/f64_cmp.wast $ts/f64_cmp.wast aabcd2c5af0670a9f7ce2cfd19befd3142c300fa5091575fad21a3726dcfb8c0"
	"testsuite/f32_bitwise.wast $ts/f32_bitwise.wast 8a514cd0c6c34cccbcd4deda8b3f1898cab2985a360d0ec10a4b1725027f0b64"
	"testsuite/f64_bitwise.wast $ts/f64_bitwise.wast efd4e70d58ee853b4509352292058841b775ccea4cfd3060ddd350b8ccd4db32"
	"testsuite/float_exprs.wast $ts/float_exprs.wast f1659759fc66b9d7d46738adaefd9d9ff6d6a433d3192c762aa32f052fe6d071"
	"testsuite/float_misc.wast $ts/float_misc.wast 03247e5060c34d2db3e3602cd25f1fa5179239ba175f95c6a509bd5c1859de81"
	"testsuite/float_literals.wast $ts/float_literals.wast 3702a2fa976e18929371b165b8bcdd63866fdc3dfdb1a4f4fdaa5b5ff7e53bb2"
	"testsuite/conversions.wast $ts/conversions.wast 70eeec77b5c5c4fa6c9547f97ac56c1e21ebd5e2a10e7318f2e22100d5f6f056"
	"lz4-wasm-block-codec.wasm $lz4wasm/dist/lz4-block-codec.wasm 4bda6947a0498618552cba53ab3780745fd34cc1a0d84696e83a0547dcd68acf"
	"edgeR_4.99.10.tgz https://r2.ropensci.org/4ebda0a8d813ab02392a397f984fd61bff853a0a9e23e3dcd658e0d157f0fb93 4ebda0a8d813ab02392a397f984fd61bff853a0a9e23e3dcd658e0d157f0fb93"
)

for f in "${files[@]}"; do
	read -r dest url sha <<<"$f"
	out=$dir/$dest
	if [[ ! -f $out ]] || ! echo "$sha  $out" | sha256sum -c --status; then
		curl -fsSL --retry 3 -o "$out.part" "$url"
		if ! echo "$sha  $out.part" | sha256sum -c --status; then
			echo "fetch-corpus: sha256 mismatch for $dest" >&2
			exit 1
		fi
		mv "$out.part" "$out"
	fi
done

# R-universe's emscripten build of edgeR 4.99.10: the shared library is the wasm module.
if [[ ! -f $dir/edgeR.so ]]; then
	tar -xzf "$dir/edgeR_4.99.10.tgz" -C "$dir" edgeR/libs/edgeR.so
	mv "$dir/edgeR/libs/edgeR.so" "$dir/edgeR.so"
	rm -r "$dir/edgeR"
fi
echo "e39434314a9eb0399edf943c6a0475d34ff9d0d7ec0bb4a1b8ba726b4a6a88fb  $dir/edgeR.so" | sha256sum -c --status
