#!/usr/bin/env bash
# U29c C2 (docs/contracts/U29c-bustools.md): `fva lift`'s chunked `decode_eq` (FVA/Tool/Lift.lean
# `chunked`) at test policies (threshold 0) on FVATest/LiftChunks/: toyp.wasm (the toy example
# with padded size + count LEBs, a custom section between two slots, a trailing one, absent slots)
# and full.wasm (`wasm-tools parse full.wat`: every section kind — imports, table, memory, tag,
# global, exports, start, elements, data count, code, data, customs) at targets 32 (one entry
# each, two of them larger than the target), 64 (two entries + one) and 1000 (one chunk) bytes,
# wide.wasm (`wasm-tools parse wide.wat`: three ≈ 150-byte entries, chunk 2 past byte 256) at
# 160 → each file compiles with no warning, its header on line 3 and `decode_eq` on the standard
# axioms. Plants, each failing in the kernel at its own declaration: chunk 1's bytes + entries
# replaced by chunk 2's (same length: the chunk holds, the section window in `slots_eq` fails),
# two entries of chunk 0 swapped (`chunk0_eq` fails), `len` ± 1 (`slots_eq` fails). rc 0 = as
# pinned, 1 = a case differs, 2 = setup.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
d=FVATest/LiftChunks t=.lake/build/bin/fvatest fail=0
# the generated files import FVA.Proof.Decode.Chunk, which no executable imports
if ! lake --wfail build fvatest FVA.Proof.Decode.Chunk >"$tmp/build" 2>&1; then
	echo "test-lift-chunks: build failed"
	tail -5 "$tmp/build"
	exit 2
fi
scripts/fetch-tools >/dev/null || exit 2
for w in full wide; do
	.tools/bin/wasm-tools parse "$d/$w.wat" -o "$tmp/$w.wasm" || exit 2
	if ! cmp -s "$tmp/$w.wasm" "$d/$w.wasm"; then
		echo "test-lift-chunks: $d/$w.wasm is not wasm-tools parse of $w.wat (regenerate it)"
		fail=1
	fi
done
bad() {
	echo "test-lift-chunks: $1"
	sed -n '1,6p' "$tmp/$2.out" | cut -c1-300
	fail=1
}
compile() { lake env lean -R "$tmp" "$tmp/$1.lean" >"$tmp/$1.out" 2>&1; }
for c in toyp:32 toyp:64 toyp:1000 full:32 full:64 full:1000 wide:160; do
	w=${c%:*} b=${c#*:}
	n=${w}_$b
	"$t" lift-chunked "$d/$w.wasm" "$tmp/$n.lean" "Chunks.$n" 0 "$b" || exit 2
	grep -q '^theorem chunk0_eq' "$tmp/$n.lean" || {
		echo "test-lift-chunks: $n is not chunked"
		exit 2
	}
	# scripts/check-format exempts lift output by its header on line 3
	# shellcheck disable=SC2016 # the backticks are literal header text
	[[ $(sed -n 3p "$tmp/$n.lean") == '/-! Generated by `fva lift`'* ]] || {
		echo "test-lift-chunks: $n: line 3 is not fva lift's header"
		fail=1
	}
	printf '\n#print axioms Chunks.%s.decode_eq\n' "$n" >>"$tmp/$n.lean"
	compile "$n"
	rc=$?
	if ((rc)); then
		bad "$n: rc $rc, want 0" "$n"
	elif grep -q warning "$tmp/$n.out" ||
		! grep -qF "depends on axioms: [propext, Classical.choice, Quot.sound]" "$tmp/$n.out"; then
		bad "$n: want no warning + the standard axioms" "$n"
	fi
done
# plant NAME FROM DECL: compile $tmp/NAME.lean (FROM edited); the first kernel error names DECL
plant() {
	if cmp -s "$tmp/$1.lean" "$tmp/$2.lean"; then
		echo "test-lift-chunks: plant $1 changed nothing"
		exit 2
	fi
	compile "$1"
	local rc=$? first
	first=$(grep -m1 'error' "$tmp/$1.out")
	if ((rc != 1)) || [[ $first != *"(kernel) declaration type mismatch, 'Chunks.$2.$3.kernel_rfl"* ]]; then
		bad "plant $1: rc $rc, want 1 with a kernel error in $3 first" "$1"
	fi
}
c2=$(sed -n 's/^noncomputable def code2 : Nat := //p' "$tmp/toyp_32.lean")
[[ -n $c2 ]] || exit 2
sed -e "s/^noncomputable def code1 : Nat := .*/noncomputable def code1 : Nat := $c2/" \
	-e 's/^  \[(func1\.locals, func1\.body)\]$/  [(func2.locals, func2.body)]/' \
	"$tmp/toyp_32.lean" >"$tmp/split.lean"
(($(grep -cF -- "$c2" "$tmp/split.lean") == 2)) || exit 2
plant split toyp_32 slots_eq
sed 's/^  \[(func0\.locals, func0\.body), (func1\.locals, func1\.body)\]$/  [(func1.locals, func1.body), (func0.locals, func0.body)]/' \
	"$tmp/toyp_64.lean" >"$tmp/swap.lean"
plant swap toyp_64 chunk0_eq
sed 's/^def len : Nat := 186$/def len : Nat := 187/' "$tmp/toyp_64.lean" >"$tmp/lenplus.lean"
plant lenplus toyp_64 slots_eq
sed 's/^def len : Nat := 186$/def len : Nat := 185/' "$tmp/toyp_64.lean" >"$tmp/lenminus.lean"
plant lenminus toyp_64 slots_eq
((fail)) || echo "test-lift-chunks: 7 chunked lifts compile on the standard axioms; 4 plants fail in the kernel"
exit "$fail"
