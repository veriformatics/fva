#!/usr/bin/env bash
# Writes trust/oleans.tsv (D48): for every module of each package FVA's lake-manifest pins (Mathlib
# + its dependencies, as `lake exe cache get` delivers them at the pinned revision), the digest
# `fva trust` checks a project's Mathlib modules against: sha256 of "h1 h2 h3", the sha256 of the
# module's .olean, .olean.server and .olean.private ("-" for an absent part). Computed here in
# bash, apart from fva's Lean digest (FVA/Trust/Olean.lean), so one digest bug cannot pass both.
# --check [FILE]: rc 1 when FILE (default trust/oleans.tsv) differs from the tree's pins.
set -euo pipefail
cd "$(dirname "$0")/.."
out=trust/oleans.tsv
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

gen() {
	local p lib
	: >"$tmp/list"
	for p in $(jq -r '.packages[] | select(.type == "git") | .name' lake-manifest.json); do
		lib=.lake/packages/$p/.lake/build/lib/lean
		[[ -d $lib ]] || continue # a package without a library build (Cli) has no modules
		find "$lib" -name '*.olean' -printf "$lib\t%P\n" >>"$tmp/list"
	done
	if [[ ! -s $tmp/list ]]; then
		echo "make-olean-pins: no package .oleans (run lake exe cache get)" >&2
		exit 2
	fi
	# every existing part's sha256, keyed by path
	awk -F'\t' '{f = $1 "/" $2; print f; print f ".server"; print f ".private"}' "$tmp/list" |
		while read -r f; do [[ -e $f ]] && printf '%s\0' "$f"; done |
		xargs -0 -P "$(nproc)" -n 256 sha256sum >"$tmp/parts"
	# one file per module holding "h1 h2 h3", then the digests of those files
	mkdir "$tmp/lines"
	awk -F'\t' -v dir="$tmp/lines" '
		NR == FNR { split($0, a, "  "); h[a[2]] = a[1]; next }
		{
			f = $1 "/" $2; m = $2; sub(/\.olean$/, "", m); gsub("/", ".", m)
			s = (f in h ? h[f] : "-") " " (f ".server" in h ? h[f ".server"] : "-") " " \
				(f ".private" in h ? h[f ".private"] : "-")
			printf "%s", s > (dir "/" m); close(dir "/" m)
		}' "$tmp/parts" "$tmp/list"
	printf '# generated by scripts/make-olean-pins (D48): module, sha256 of "h1 h2 h3" (its parts)\n'
	(cd "$tmp/lines" && find . -type f -printf '%P\0' | xargs -0 -P "$(nproc)" -n 512 sha256sum) |
		awk '{print $2 "\t" $1}' | LC_ALL=C sort
}

if [[ ${1:-} == --check ]]; then
	want=${2:-$out}
	if ! cmp -s <(gen) "$want"; then
		echo "make-olean-pins: $want differs from the package .oleans (run scripts/make-olean-pins)" >&2
		exit 1
	fi
	exit 0
fi
gen >"$tmp/out"
mv "$tmp/out" "$out"
