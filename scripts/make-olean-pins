#!/usr/bin/env bash
# Writes trust/oleans.tsv: for every module of each package FVA's lake-manifest pins (D48: Mathlib
# + its dependencies, as `lake exe cache get` delivers them at the pinned revision) and every FVA
# base module (D49: the sources FVA/Tool/BaseManifest.lean lists, as this tree's build compiled
# them; Lean builds them byte-identically on every host and path), the digest `fva trust` checks a
# project's Mathlib and base modules against: sha256 of "h1 h2 h3", the sha256 of the module's
# .olean, .olean.server and .olean.private ("-" for an absent part). Computed here in bash, apart
# from fva's Lean digest (FVA/Trust/Olean.lean), so one digest bug cannot pass both.
# --check [FILE]: rc 1 when a module this tree holds lacks its pin in FILE (default
# trust/oleans.tsv) or has other bytes.
set -euo pipefail
cd "$(dirname "$0")/.."
out=trust/oleans.tsv
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

gen() {
	local p lib
	: >"$tmp/list"
	for p in $(jq -r '.packages[] | select(.type == "git") | .name' lake-manifest.json); do
		lib=.lake/packages/$p/.lake/build/lib/lean
		[[ -d $lib ]] || continue # a package without a library build (Cli) has no modules
		find "$lib" -name '*.olean' -printf "$lib\t%P\n" >>"$tmp/list"
	done
	if [[ ! -s $tmp/list ]]; then
		echo "make-olean-pins: no package .oleans (run lake exe cache get)" >&2
		exit 2
	fi
	local f
	sed -n 's/^  ("\(.*\)\.lean",$/\1/p' FVA/Tool/BaseManifest.lean | while read -r f; do
		if [[ ! -e .lake/build/lib/lean/$f.olean ]]; then
			echo "make-olean-pins: .lake/build/lib/lean/$f.olean missing (run lake build)" >&2
			exit 2
		fi
		printf '.lake/build/lib/lean\t%s.olean\n' "$f"
	done >>"$tmp/list" || exit 2
	# every existing part's sha256, keyed by path
	awk -F'\t' '{f = $1 "/" $2; print f; print f ".server"; print f ".private"}' "$tmp/list" |
		while read -r f; do if [[ -e $f ]]; then printf '%s\0' "$f"; fi; done |
		xargs -0 -P "$(nproc)" -n 256 sha256sum >"$tmp/parts"
	# one file per module holding "h1 h2 h3", then the digests of those files
	mkdir "$tmp/lines"
	awk -F'\t' -v dir="$tmp/lines" '
		NR == FNR { split($0, a, "  "); h[a[2]] = a[1]; next }
		{
			f = $1 "/" $2; m = $2; sub(/\.olean$/, "", m); gsub("/", ".", m)
			s = (f in h ? h[f] : "-") " " (f ".server" in h ? h[f ".server"] : "-") " " \
				(f ".private" in h ? h[f ".private"] : "-")
			printf "%s", s > (dir "/" m); close(dir "/" m)
		}' "$tmp/parts" "$tmp/list"
	printf '# generated by scripts/make-olean-pins (D48, D49): module, sha256 of "h1 h2 h3" (its parts)\n'
	(cd "$tmp/lines" && find . -type f -printf '%P\0' | xargs -0 -P "$(nproc)" -n 512 sha256sum) |
		awk '{print $2 "\t" $1}' | LC_ALL=C sort
}

if [[ ${1:-} == --check ]]; then
	want=${2:-$out}
	# every module this tree holds must carry its pin; a pinned module this tree has not built (a
	# package executable's support module, such as Batteries' runLinter before `lake lint`) is
	# left out of the comparison
	gen >"$tmp/now"
	LC_ALL=C comm -23 <(LC_ALL=C sort "$tmp/now") <(LC_ALL=C sort "$want") >"$tmp/extra"
	if [[ -s $tmp/extra ]]; then
		echo "make-olean-pins: $want misses or mismatches these package .oleans (run scripts/make-olean-pins):" >&2
		head -5 "$tmp/extra" >&2
		exit 1
	fi
	exit 0
fi
gen >"$tmp/out"
mv "$tmp/out" "$out"
