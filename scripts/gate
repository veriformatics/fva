#!/usr/bin/env bash
# Full gate (default) or fast gate (--fast): every check this repo grades by, one rc.
# Prints each step's wall-clock; Lean steps run in sequence (one lake workspace), the rest in parallel.
# Fast = skips network/history scanners (osv-scanner, gitleaks history); full = CI + closing commits.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
fast=0
[[ ${1:-} == --fast ]] && fast=1
scripts/fetch-tools || exit 1
export PATH="$PWD/.tools/bin:$PATH"
logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT

run() { # name cmd... -> logs/name.{out,rc,sec}
	local name=$1 t0
	shift
	t0=$(date +%s%N)
	"$@" >"$logs/$name.out" 2>&1
	echo $? >"$logs/$name.rc"
	echo $((($(date +%s%N) - t0) / 1000000)) >"$logs/$name.ms"
}

# bash scripts by shebang (scripts/ also holds data such as Batteries' nolints.json)
mapfile -t shells < <(
	git ls-files -co --exclude-standard -- 'scripts/*' 'bench/*' | while IFS= read -r f; do
		head -n1 -- "$f" | grep -qx '#!/usr/bin/env bash' && printf '%s\n' "$f"
	done
)
mapfile -t workflows < <(git ls-files -co --exclude-standard -- '.github/workflows/*.yml')

lean_lane() {
	run build lake --wfail build
	# the planted checks need the built fvamut; they run beside the rest of this lane
	run checks scripts/test-checks &
	run test lake --wfail test
	run decoder scripts/test-decoder
	run numerics scripts/test-numerics
	if ((fast)); then run floatdiff scripts/test-floatdiff --fast; else run floatdiff scripts/test-floatdiff; fi
	if ((fast)); then run spec scripts/test-spec --fast; else run spec scripts/test-spec; fi
	if ((fast)); then run difftest scripts/test-difftest --fast; else run difftest scripts/test-difftest; fi
	run lint lake --wfail lint
	# fva trust: self package + cheat suite (≈ 5 min, kernel replay dominated): full gate only
	if ((! fast)); then run trust scripts/test-trust; fi
	# fva init end to end (a consumer project + its trust run): full gate only
	if ((! fast)); then run init scripts/test-init; fi
	if ((fast)); then run mutation scripts/test-mutation --fast; else run mutation scripts/test-mutation; fi
	wait
}
lean_lane &
run format-lean scripts/check-format &
run shellcheck shellcheck -x "${shells[@]}" &
run shfmt shfmt -d "${shells[@]}" &
run spec-lint .agent/spec-lint &
run pins scripts/check-pins &
run base-manifest scripts/make-base-manifest --check &
if ((${#workflows[@]})); then
	run actionlint actionlint "${workflows[@]}" &
	run zizmor zizmor --offline "${workflows[@]}" &
fi
run gitleaks-tree gitleaks dir --no-banner --redact --config .gitleaks.toml . &
if ((! fast)); then
	run gitleaks-history gitleaks git --no-banner --redact --config .gitleaks.toml . &
	run osv-scanner osv-scanner scan source -r --x-exclude .lake --x-exclude .tools --x-exclude .scratch --x-exclude .cache . &
fi
wait

status=0
printf '%-16s %8s  %s\n' step seconds result
for rc in "$logs"/*.rc; do
	name=$(basename "$rc" .rc)
	r=$(<"$rc")
	ms=$(<"$logs/$name.ms")
	printf '%-16s %5d.%01d  %s\n' "$name" $((ms / 1000)) $((ms % 1000 / 100)) "$([[ $r == 0 ]] && echo ok || echo "FAIL (rc $r)")"
	if [[ $r != 0 ]]; then
		status=1
		sed 's/^/    /' "$logs/$name.out" | tail -20
	fi
done
exit "$status"
