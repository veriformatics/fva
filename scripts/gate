#!/usr/bin/env bash
# Full gate (default) or fast gate (--fast): every check this repo grades by, one rc.
# Prints each step's wall-clock + verdict and appends both to the step ledger (scripts/gate-ledger);
# Lean steps run in sequence (one lake workspace), the rest in parallel. Fast = latency-bounded:
# skips the network/history scanners (osv-scanner, gitleaks history) and the mutation table, whose
# stale rows each unit updates before its commit (fva-mutation.md); full = CI + closing commits.
# --group G = the full gate's steps of CI group G alone (gate.yml: one job per group, D32);
# --groups = the group names. A full run fails when a step belongs to no group or gate.yml's
# matrix misses a group, so the CI fan-out always covers every step.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
declare -A groups=(
	[lean]="build checks test char accept decoder numerics floatdiff spec difftest fuzz-replay lint mutation pins olean-pins"
	[trust]="build trust"
	[init]="build init"
	[subjects]="build subjects"
	[static]="format-lean shellcheck shfmt spec-lint base-manifest scope json notices actionlint zizmor gitleaks-tree gitleaks-history osv-scanner"
)
fast=0 group=
case ${1:-} in
--fast) fast=1 ;;
--groups)
	printf '%s\n' "${!groups[@]}" | sort
	exit 0
	;;
--group)
	group=${2:-}
	[[ -n ${groups[$group]+x} ]] || {
		echo "gate: no group '$group' (--groups lists them)" >&2
		exit 1
	}
	;;
esac
want() { [[ -z $group || " ${groups[$group]} " == *" $1 "* ]]; }
started=$(date -u +%FT%TZ)
tree=$(scripts/gate-ledger tree)
mode=full
((fast)) && mode=fast
[[ -n $group ]] && mode=group:$group
scripts/fetch-tools || exit 1
export PATH="$PWD/.tools/bin:$PATH"
# Inputs the lanes read, fetched once before they start: parallel fetch-corpus runs share its
# .part files (two runs into an empty corpus: one fails the other's sha256 check).
# fetch-subjects first: it also places the edgeR archive (veriformatics/fva-artifacts; R-universe
# dropped 4.99.10) until fetch-corpus names it there (U33 M4, a mutation digest input: U28b).
scripts/fetch-subjects || {
	echo "gate: scripts/fetch-subjects failed" >&2
	exit 1
}
scripts/fetch-corpus >/dev/null || {
	echo "gate: scripts/fetch-corpus failed" >&2
	exit 1
}
logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT

run() { # name cmd... -> logs/name.{out,rc,sec}, when the selected group has the step
	local name=$1 t0
	want "$name" || return 0
	shift
	t0=$(date +%s%N)
	"$@" >"$logs/$name.out" 2>&1
	echo $? >"$logs/$name.rc"
	echo $((($(date +%s%N) - t0) / 1000000)) >"$logs/$name.ms"
}

# bash scripts by shebang (scripts/ also holds data such as Batteries' nolints.json); one awk pass:
# a fork per file costs ≈ 5 s over FVATest's ≈ 1,600 files
# shellcheck disable=SC2016 # awk's own $0
mapfile -t shells < <(
	git ls-files -co --exclude-standard -z -- 'scripts/*' 'bench/*' 'FVATest/*' |
		xargs -0 -r awk 'FNR == 1 { if ($0 == "#!/usr/bin/env bash") print FILENAME; nextfile }'
)
mapfile -t workflows < <(git ls-files -co --exclude-standard -- '.github/workflows/*.yml')

lean_lane() {
	# the executables the parallel steps below run (fvatest: test-checks + test-char beside
	# `lake test`), as gate.yml's build job builds them
	run build bash -c 'lake --wfail build && lake --wfail build fvatest fvafuzz'
	# the .olean pins (D48): the package files the Mathlib cache delivered
	run olean-pins scripts/make-olean-pins --check &
	# the planted checks need the built fvamut; they run beside the rest of this lane
	run checks scripts/test-checks &
	run test lake --wfail test
	# characterization goldens (official-script outcomes, CLI help, lifts): beside the rest, once
	# fvatest + fva are built
	if ((fast)); then run char scripts/test-char --fast & else run char scripts/test-char & fi
	# the acceptance checks merged so far (FVATest/Accept/LWR/merged): full gate only
	if ((! fast)); then run accept scripts/test-accept & fi
	run decoder scripts/test-decoder
	run numerics scripts/test-numerics
	if ((fast)); then run floatdiff scripts/test-floatdiff --fast; else run floatdiff scripts/test-floatdiff; fi
	if ((fast)); then run spec scripts/test-spec --fast; else run spec scripts/test-spec; fi
	if ((fast)); then run difftest scripts/test-difftest --fast; else run difftest scripts/test-difftest; fi
	# D70: the committed fuzz corpus + every crash input through the compiled readers
	run fuzz-replay scripts/fuzz-replay
	run lint lake --wfail lint
	# fva trust: self package + cheat suite (≈ 5 min, kernel replay dominated): full gate only
	if ((! fast)); then run trust scripts/test-trust; fi
	# fva init end to end (a consumer project + its trust run): full gate only
	if ((! fast)); then run init scripts/test-init; fi
	# U14 subject demonstrations (fva trust per subject + planted negatives): full gate only
	if ((! fast)); then run subjects scripts/test-subjects; fi
	# U12 mutation table current (check mode): full gate only, stale rows = each unit's --update
	if ((! fast)); then run mutation scripts/test-mutation; fi
	wait
}
lean_lane &
run format-lean scripts/check-format &
run shellcheck shellcheck -x "${shells[@]}" &
run shfmt shfmt -d "${shells[@]}" &
run spec-lint .agent/spec-lint &
run pins scripts/check-pins &
run base-manifest scripts/make-base-manifest --check &
run scope scripts/check-scope &
run json scripts/check-json &
run notices scripts/check-notices &
if ((${#workflows[@]})); then
	run actionlint actionlint "${workflows[@]}" &
	run zizmor zizmor --offline "${workflows[@]}" &
fi
run gitleaks-tree gitleaks dir --no-banner --redact --config .gitleaks.toml . &
if ((! fast)); then
	run gitleaks-history gitleaks git --no-banner --redact --config .gitleaks.toml . &
	run osv-scanner osv-scanner scan source -r --x-exclude .lake --x-exclude .tools --x-exclude .scratch --x-exclude .cache . &
fi
wait
# CI coverage: every step that ran belongs to a group, and gate.yml's matrix lists every group
if [[ -z $group ]] && ((! fast)); then
	for rc in "$logs"/*.rc; do
		name=$(basename "$rc" .rc)
		[[ " ${groups[*]} " == *" $name "* ]] || {
			echo "gate: step $name belongs to no CI group" >>"$logs/ci-groups.out"
			echo 1 >"$logs/ci-groups.rc"
		}
	done
	for g in "${!groups[@]}"; do
		grep -qE "^ +group: \[.*\b$g\b.*\]" .github/workflows/gate.yml || {
			echo "gate: gate.yml's matrix misses group $g" >>"$logs/ci-groups.out"
			echo 1 >"$logs/ci-groups.rc"
		}
	done
	[[ -e $logs/ci-groups.rc ]] || echo 0 >"$logs/ci-groups.rc"
	echo 0 >"$logs/ci-groups.ms"
fi

status=0
printf '%-16s %8s  %s\n' step seconds result
for rc in "$logs"/*.rc; do
	name=$(basename "$rc" .rc)
	r=$(<"$rc")
	ms=$(<"$logs/$name.ms")
	note=$(sed -n '/^gate-note: /{s///;p;q}' "$logs/$name.out" 2>/dev/null)
	printf '%-16s %5d.%01d  %s%s\n' "$name" $((ms / 1000)) $((ms % 1000 / 100)) \
		"$([[ $r == 0 ]] && echo ok || echo "FAIL (rc $r)")" "${note:+  ($note)}"
	if [[ $r != 0 ]]; then
		status=1
		sed 's/^/    /' "$logs/$name.out" | tail -20
	fi
done
scripts/gate-ledger append "$logs" "$started" "$tree" "$mode" || echo "gate: step ledger not written"
((status)) && echo "classify each red before a rerun: scripts/gate-ledger classify <step> product|gate|flake|planted"
exit "$status"
