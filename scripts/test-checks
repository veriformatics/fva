	.lake/build/bin/fvatest "${argv[@]}" >/dev/null 2>&1
	rc=$?
	if ((rc != 2)); then
		echo "test-checks: fvatest $args → rc $rc, want 2"
		fail=1
	fi
done
scripts/test-mutation-fixture || fail=1
scripts/test-subject-matrix || fail=1
scripts/test-char-fixture || fail=1
