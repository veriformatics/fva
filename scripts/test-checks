#!/usr/bin/env bash
# Planted-bad inputs for the purpose-built checks (check-format, check-pins, the mutation check via
# scripts/test-mutation-fixture, the subject matrix via scripts/test-subject-matrix, the
# characterization comparator + trace join via scripts/test-char-fixture, the P′ suite driver via
# FVATest/P2/check-driver): each must fail.
# Also the gate's step ledger (scripts/gate-ledger): a red step's row, its classification, the summary;
# and the full gate's CI-group coverage, over a stubbed copy of scripts/gate; and test-subjects'
# shard map (the subjects CI fan-out).
# Also the bench grading batteries (bench/grade/check-drivers, check-fidelity) over neutered drivers.
# Runs on a throwaway copy so the working tree is never touched.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
# the gate shows a failed step's last 20 lines: a failing run repeats its failure lines last
if [[ -z ${TEST_CHECKS_INNER:-} ]]; then
	out=$(mktemp) || exit 2
	TEST_CHECKS_INNER=1 "$PWD/scripts/test-checks" "$@" 2>&1 | tee "$out"
	rc=${PIPESTATUS[0]}
	if ((rc)); then
		echo "test-checks: rc $rc; its failure lines again:"
		grep -E '^test-[a-z-]+: ' "$out" | grep -vE ' PASS$|: [0-9]+ passed, 0 failed$'
	fi
	rm -f "$out"
	exit "$rc"
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fail=0
expect_fail() { # label dir cmd...
	local label=$1 dir=$2
	shift 2
	if (cd "$dir" && "$@" >/dev/null 2>&1); then
		echo "test-checks: $label passed a planted bad input"
		fail=1
	fi
}
fresh() { # copy the files a check reads into a scratch git repo
	local d=$tmp/$1
	mkdir -p "$d/scripts"
	cp scripts/check-format scripts/check-pins lean-toolchain lakefile.toml lake-manifest.json "$d/" 2>/dev/null
	cp scripts/check-format scripts/check-pins "$d/scripts/"
	git -C "$d" init -q
	echo "$d"
}
d=$(fresh long) && printf 'def x : Nat := %0101d\n' 0 >"$d/A.lean" && expect_fail "long line" "$d" scripts/check-format
d=$(fresh tab) && printf 'def\tx : Nat := 0\n' >"$d/A.lean" && expect_fail "tab" "$d" scripts/check-format
d=$(fresh trail) && printf 'def x : Nat := 0 \n' >"$d/A.lean" && expect_fail "trailing space" "$d" scripts/check-format
d=$(fresh eof) && printf 'def x : Nat := 0' >"$d/A.lean" && expect_fail "no final newline" "$d" scripts/check-format
d=$(fresh toolchain) && echo 'leanprover/lean4:v4.0.0' >"$d/lean-toolchain" && expect_fail "toolchain drift" "$d" scripts/check-pins
d=$(fresh rev) && sed -i 's/^rev = "v/rev = "x/' "$d/lakefile.toml" && expect_fail "mathlib rev drift" "$d" scripts/check-pins
d=$(fresh manifest) && jq '(.packages[] | select(.name == "mathlib") | .inputRev) = "master"' lake-manifest.json >"$d/lake-manifest.json" && expect_fail "manifest drift" "$d" scripts/check-pins
# shellcheck disable=SC2016 # backticks are Lean text
d=$(fresh late-marker) && printf 'import X\n\n-- x\n/-! Generated by `fva lift` -/\ndef x : Nat := %0101d\n' 0 >"$d/A.lean" &&
	expect_fail "lift marker off line 3" "$d" scripts/check-format
# shellcheck disable=SC2016 # backticks are Lean text
d=$(fresh other-marker) && printf 'import X\nimport Y\n/-! Generated by `fva sort` -/\ndef x : Nat := %0101d\n' 0 >"$d/A.lean" &&
	expect_fail "unknown generator marker" "$d" scripts/check-format
d=$(fresh good)
printf 'def x : Nat := 0\n' >"$d/A.lean"
# a generated lift file may exceed the column limit
# shellcheck disable=SC2016 # backticks are Lean text
printf 'import FVA.Lifted\n\n/-! Generated by `fva lift` from 1 bytes -/\ndef b : Nat := %0101d\n' 0 >"$d/L.lean"
# shellcheck disable=SC2016 # backticks are Lean text
printf 'import FVA.Lifted\nimport FVA.Spec.Cert\n/-! Generated by `fva blob` from 1 bytes -/\ndef b : Nat := %0101d\n' 0 >"$d/B.lean"
if ! (cd "$d" && scripts/check-format && scripts/check-pins) >/dev/null; then
	echo "test-checks: clean copy failed"
	fail=1
fi
# check-scope: a scope file with an `open … in` command fails; the clean scope passes
d=$tmp/scope && mkdir -p "$d/scripts" "$d/FVATest/Mutate" "$d/FVA/Spec" "$d/FVA/Impl/X"
cp scripts/check-scope "$d/scripts/" && cp FVATest/Mutate/config.json "$d/FVATest/Mutate/"
jq '.groups |= map(.dirs |= if length > 0 then ["FVA/Impl/X"] else . end)' \
	FVATest/Mutate/config.json >"$d/FVATest/Mutate/config.json"
printf 'open Nat in\ndef y : Nat := succ 0\n' >"$d/FVA/Impl/X/A.lean"
expect_fail "open-in in a scope file" "$d" scripts/check-scope
printf 'set_option maxRecDepth 100 in\ndef y : Nat := 0\n' >"$d/FVA/Impl/X/A.lean"
expect_fail "set_option-in in a scope file" "$d" scripts/check-scope
printf 'section\nopen Nat\ndef y : Nat := succ 0\nend\n' >"$d/FVA/Impl/X/A.lean"
if ! (cd "$d" && scripts/check-scope) >/dev/null; then
	echo "test-checks: check-scope failed a clean scope"
	fail=1
fi
# fetch-bench (U33: the sha256 pins of every fetched artifact): a pinned file fetches and its cached
# copy verifies (rc 0); a corrupted cached copy and a download missing its pin each fail (rc 1)
d=$tmp/fetch && mkdir -p "$d/src" "$d/cache" && printf 'pinned bytes\n' >"$d/src/x.bin"
sha=$(sha256sum "$d/src/x.bin" | cut -d' ' -f1)
fb_manifest() { # sha → a one-subject manifest on stdout
	jq -n --arg sha "$1" --arg url "file://$d/src/x.bin" '{schema: 1, subjects: [{id: "t", name: "t",
		version: "1", upstream: "u", url: $url, file: "x.bin", sha256: $sha, license: "MIT"}]}'
}
fb_manifest "$sha" >"$d/ok.json" && fb_manifest "${sha//[0-9]/0}" >"$d/bad.json"
if ! scripts/fetch-bench --manifest "$d/ok.json" --cache "$d/cache" t >/dev/null 2>&1; then
	echo "test-checks: fetch-bench failed a correctly pinned file"
	fail=1
fi
printf 'x' >>"$d/cache/t/x.bin"
expect_fail "fetch-bench: corrupted cached copy" . scripts/fetch-bench --manifest "$d/ok.json" --cache "$d/cache" t
expect_fail "fetch-bench: download missing its pin" . scripts/fetch-bench --manifest "$d/bad.json" --cache "$d/cache2" t
# check-notices (U33, Decisions: Repository contents): no committed third-party artifact or lifted
# literal of one, whatever NOTICE sits beside it
d=$tmp/notices && mkdir -p "$d/scripts" "$d/bench/subjects" "$d/runs/r1/Proofs"
cp scripts/check-notices "$d/scripts/" && cp bench/subjects/manifest.json "$d/bench/subjects/"
scripts/fetch-subjects || exit 2
hex=$(xxd -p FVATest/Subjects/Lz4Wasm/lz4-block-codec.wasm | tr -d '\n') && [[ -n $hex ]] || {
	echo "test-checks: xxd cannot dump the lz4-wasm codec (check-notices case setup)"
	exit 2
}
printf 'def bytes : Nat := wasm_bytes%% "%s"\n' "$hex" >"$d/runs/r1/Proofs/Lifted.lean"
git -C "$d" init -q && git -C "$d" add -A
expect_fail "embedded artifact without a NOTICE" "$d" scripts/check-notices
notice=$(jq -r '.subjects[] | select(.id == "lz4-wasm") |
	"sha256 \(.sha256)\nlicense \(.license)\nupstream \(.upstream)\nversion \(.version)"' \
	bench/subjects/manifest.json)
printf '%s\n' "$notice" >"$d/runs/NOTICE" && git -C "$d" add -A
expect_fail "NOTICE without the corresponding source" "$d" scripts/check-notices
# a decoder that fails (as a missing xxd did on one gate host) → rc 2, never a silent pass
mkdir -p "$d/stub" && printf '#!/usr/bin/env bash\nexit 127\n' >"$d/stub/xxd" && chmod +x "$d/stub/xxd"
(cd "$d" && PATH=$d/stub:$PATH scripts/check-notices) >/dev/null 2>&1
rc=$?
if ((rc != 2)); then
	echo "test-checks: check-notices with a failing xxd → rc $rc, want 2"
	fail=1
fi
printf '%s\ncorresponding source: the .wat\n' "$notice" >"$d/runs/NOTICE" && git -C "$d" add -A
expect_fail "embedded artifact beside a NOTICE naming every field" "$d" scripts/check-notices
git -C "$d" rm -q --cached runs/r1/Proofs/Lifted.lean && rm "$d/runs/r1/Proofs/Lifted.lean" &&
	cp FVATest/Subjects/Lz4Wasm/lz4-block-codec.wasm "$d/runs/codec.wasm" && git -C "$d" add -A
expect_fail "committed artifact binary" "$d" scripts/check-notices
git -C "$d" rm -q --cached runs/codec.wasm && rm "$d/runs/codec.wasm"
if ! (cd "$d" && scripts/check-notices) >/dev/null; then
	echo "test-checks: check-notices failed a tree without third-party artifacts"
	fail=1
fi
# make-olean-pins --check (D48): pins that miss one package module, or pin other bytes, fail
d=$tmp/oleans && mkdir -p "$d"
sed '2d' trust/oleans.tsv >"$d/missing" && expect_fail "olean pins missing a module" . \
	scripts/make-olean-pins --check "$d/missing"
sed -E '2s/\t[0-9a-f]+$/\tdeadbeef/' trust/oleans.tsv >"$d/other" && expect_fail "olean pin of other bytes" . \
	scripts/make-olean-pins --check "$d/other"
if ! scripts/make-olean-pins --check >/dev/null 2>&1; then
	echo "test-checks: make-olean-pins --check failed the committed pins"
	fail=1
fi
# D63: on a build failure `fva trust --json` keeps its JSON shape, and `fva explain` shows the
# failed proof check (rc 1) and stops before any model call
d=$tmp/nobuild && mkdir -p "$d"
printf 'name = "bad"\ndefaultTargets = ["Bad"]\n\n[[lean_lib]]\nname = "Bad"\n' >"$d/lakefile.toml"
printf 'def x : Nat := "a"\n' >"$d/Bad.lean"
echo '{"version": "1.3.0", "packagesDir": ".lake/packages", "packages": [], "name": "bad",' \
	'"lakeDir": ".lake"}' >"$d/lake-manifest.json"
cp lean-toolchain "$d/"
.lake/build/bin/fva trust "$d" --spec-module Bad --json >"$d/trust.json" 2>/dev/null
got=$(jq -r '.verdict + " " + .issues[0].tag' "$d/trust.json" 2>/dev/null)
if [[ $got != "fail build" ]]; then
	echo "test-checks: fva trust --json on a project that does not build → '$got', want 'fail build'"
	fail=1
fi
.lake/build/bin/fva explain "$d" --spec-module Bad >"$d/explain.out" 2>&1
rc=$?
if ((rc != 1)) || ! grep -qx '  Proof check (fva trust): FAIL' "$d/explain.out"; then
	echo "test-checks: fva explain on a project that does not build → rc $rc, want 1 + the FAIL line"
	fail=1
fi
# D66: a manifest packagesDir outside the project (a shared package store) stays visible, read-only,
# inside fva trust's sandbox: the project builds there (no `[build]`)
d=$tmp/store && mkdir -p "$d/src/dep" "$d/proj"
printf 'name = "dep"\n\n[[lean_lib]]\nname = "Dep"\n' >"$d/src/dep/lakefile.toml"
printf 'def depValue : Nat := 7\n' >"$d/src/dep/Dep.lean"
cp lean-toolchain "$d/src/dep/" && cp lean-toolchain "$d/proj/"
git -C "$d/src/dep" init -q -b main && git -C "$d/src/dep" add -A &&
	git -C "$d/src/dep" -c user.email=t@t -c user.name=t commit -qm dep
printf 'name = "proj"\ndefaultTargets = ["P"]\npackagesDir = "%s"\n\n[[require]]\nname = "dep"\n' \
	"$d/packages" >"$d/proj/lakefile.toml"
printf 'git = "%s"\nrev = "main"\n\n[[lean_lib]]\nname = "P"\n' "$d/src/dep" >>"$d/proj/lakefile.toml"
printf 'import Dep\ndef p : Nat := depValue\n' >"$d/proj/P.lean"
if ! (cd "$d/proj" && lake update && lake build) >"$d/setup.log" 2>&1; then
	echo "test-checks: the external-store project does not set up"
	exit 2
fi
.lake/build/bin/fva trust "$d/proj" --spec-module P --root-module P >"$d/trust.out" 2>&1
if grep -q '^  \[build\]' "$d/trust.out"; then
	echo "test-checks: a packagesDir outside the project is hidden from fva trust's sandbox ([build])"
	fail=1
fi
# test-init verdict reuse (D78; stub fva + lake that record each call and fail): the recorded key's
# inputs → reused, no run; the fva binary edited → a run, whose failure drops the entry; a failing
# pins check → no key
d=$tmp/init-reuse && mkdir -p "$d/bin" "$d/c" || exit 2
# shellcheck disable=SC2016 # the stub's own $0, expanded when it runs
printf '#!/bin/sh\necho "$0" >>"%s/calls"\nexit 1\n' "$d" >"$d/bin/lake" &&
	cp "$d/bin/lake" "$d/fva" && chmod +x "$d/bin/lake" "$d/fva" || exit 2
init_run() {
	FVA=$d/fva FVA_PINS_CHECK=${pins:-true} FVA_INIT_CACHE=$d/c FVA_FETCH_CANARIES=true \
		PATH=$d/bin:$PATH scripts/test-init "$@"
}
calls() { cat "$d/calls" 2>/dev/null | wc -l; }
key=$(init_run --key)
echo "$key" >"$d/c/key"
init_run >"$d/out" 2>&1
got="${#key} $? $(calls) $(grep -c '^gate-note: reused$' "$d/out")"
echo '# edited' >>"$d/fva"
init_run >"$d/out" 2>&1
got+=" $? $(calls) $([[ -e $d/c/key ]] && echo kept || echo dropped) $(pins=false init_run --key | wc -c)"
if [[ $got != "64 0 0 1 1 1 dropped 0" ]]; then
	echo "test-checks: test-init reuse → '$got', want '64 0 0 1 1 1 dropped 0'"
	fail=1
fi
# gate-ledger: one row per step (a red keeps its rc; note = the step's first `gate-note: `, else -),
# a classification clears the red + counts in the summary (a planted red: not a unique catch), a red
# classified twice or an unknown class fails
d=$tmp/ledger && mkdir -p "$d/logs"
echo 0 >"$d/logs/a.rc" && echo 1500 >"$d/logs/a.ms" && echo 1 >"$d/logs/b.rc" && echo 230 >"$d/logs/b.ms"
printf 'x\ngate-note: 3 of 4\truns reused\ngate-note: later\n' >"$d/logs/a.out"
ledger() { FVA_GATE_LEDGER=$d/l scripts/gate-ledger "$@"; }
ledger append "$d/logs" 2026-01-01T00:00:00Z t1 fast
got=$(cut -f3-8 "$d"/l/*.tsv 2>/dev/null | tr '\t\n' ' |')
want='t1 fast a 1.5 ok 3 of 4 runs reused|t1 fast b 0.2 rc 1 -|'
if [[ $got != "$want" ]]; then
	echo "test-checks: gate-ledger append → '$got', want '$want'"
	fail=1
fi
got=$(ledger reds | cut -f5)
ledger classify b planted
got+=" $(ledger reds | wc -l) $(ledger summary | awk -F'\t' '$1 == "b" { print $5, $9, $11 }')"
if [[ $got != "b 0 1 1 0" ]]; then
	echo "test-checks: gate-ledger reds/classify/summary → '$got', want 'b 0 1 1 0'"
	fail=1
fi
expect_fail "gate-ledger classify without an open red" . env FVA_GATE_LEDGER="$d/l" scripts/gate-ledger classify b product
expect_fail "gate-ledger unknown class" . env FVA_GATE_LEDGER="$d/l" scripts/gate-ledger classify a nonsense t1
# ci-groups (D32, D80): a full gate fails, naming each, when a step it ran belongs to no CI group or
# gate.yml's matrix misses a group; a copy of scripts/gate runs over stubs (`exit 0`) for every
# script it names and every tool its `run` lines call, beside a copy of gate.yml; stubs run under
# /bin/sh: `bash` is such a tool (the build step), and a bash stub found through PATH execs itself
d=$tmp/ci-groups && mkdir -p "$d/scripts" "$d/.agent" "$d/.tools/bin" "$d/.github/workflows" &&
	cp scripts/gate "$d/" || exit 2
for s in $({
	grep -oE 'scripts/[A-Za-z0-9-]+|\.agent/spec-lint' scripts/gate | grep -vx scripts/gate
	grep -v '^[[:space:]]*#' scripts/gate | grep -oE '\brun [a-z0-9-]+ [^ ;&/]+( |$)' | awk '{ print ".tools/bin/" $3 }'
} | sort -u); do
	printf '#!/bin/sh\nexit 0\n' >"$d/$s" && chmod +x "$d/$s" || exit 2
done
git -C "$d" init -q
gate_copy() { # gate.yml edit (sed) → the copy's full gate rc, its output in $d/out
	cp .github/workflows/gate.yml "$d/.github/workflows/" && sed -i "$1" "$d/.github/workflows/gate.yml" &&
		(cd "$d" && scripts/gate) >"$d/out" 2>&1
}
cp "$d/gate" "$d/scripts/gate" && gate_copy ''
rc=$?
if ((rc != 0)) || ! grep -qE '^ci-groups +[0-9]+\.[0-9]  ok$' "$d/out"; then
	echo "test-checks: the stubbed gate copy → rc $rc, want 0 + an ok ci-groups row"
	fail=1
fi
sed '/^run notices /a run extra-a true &\nrun extra-b true &' "$d/gate" >"$d/scripts/gate" && gate_copy ''
rc=$?
if ((rc != 1)) || ! grep -q 'step extra-a belongs to no CI group' "$d/out" ||
	! grep -q 'step extra-b belongs to no CI group' "$d/out"; then
	echo "test-checks: a gate with 2 steps outside every CI group → rc $rc, want 1 naming both"
	fail=1
fi
cp "$d/gate" "$d/scripts/gate" && gate_copy 's/^\( *group: \[.*\), static\]/\1]/'
rc=$?
if ((rc != 1)) || ! grep -q "gate.yml's matrix misses group static" "$d/out"; then
	echo "test-checks: gate.yml's matrix without the static group → rc $rc, want 1 naming it"
	fail=1
fi
cp "$d/gate" "$d/scripts/gate" && gate_copy 's/, subjects-2,/,/'
rc=$?
if ((rc != 1)) || ! grep -q "gate.yml's matrix misses group subjects-2" "$d/out"; then
	echo "test-checks: gate.yml's matrix without the subjects-2 shard → rc $rc, want 1 naming it"
	fail=1
fi
# subjects CI fan-out: test-subjects' shards (--list) partition its checks, and its shard map fails
# closed before any fetch (rc 2); a copy whose stub fetch-canaries marks a run past the map
d=$tmp/shards && mkdir -p "$d/scripts" && cp scripts/test-subjects "$d/" &&
	printf '#!/bin/sh\necho fetch-reached\nexit 2\n' >"$d/scripts/fetch-canaries" &&
	chmod +x "$d/scripts/fetch-canaries" || exit 2
n=$(sed -n 's/^subject_shards=\([1-9][0-9]*\)$/\1/p' scripts/gate) all='' parts=''
[[ -n $n ]] || {
	echo "test-checks: scripts/gate sets no subject_shards"
	n=1 fail=1
}
cp "$d/test-subjects" "$d/scripts/" && all=$("$d/scripts/test-subjects" --shard "all/$n" --list) &&
	parts=$(for ((k = 1; k <= n; k++)); do "$d/scripts/test-subjects" --shard "$k/$n" --list || echo "rc $?"; done)
if [[ -z $all || $(sort <<<"$parts") != "$(sort <<<"$all")" ]]; then
	echo "test-checks: test-subjects' $n shards do not partition its checks (each exactly once)"
	fail=1
fi
"$d/scripts/test-subjects" --shard "1/$n" >"$d/out" 2>&1
rc=$?
if ((rc != 2)) || ! grep -qx fetch-reached "$d/out"; then
	echo "test-checks: test-subjects --shard 1/$n → rc $rc without the stub fetch's marker, want the map passed + the stub's rc 2"
	fail=1
fi
shard_plant() { # label sed-edit shard → rc 2, a shard message, no fetch
	cp "$d/test-subjects" "$d/scripts/" && sed -i "$2" "$d/scripts/test-subjects" || exit 2
	if [[ -n $2 ]] && cmp -s "$d/test-subjects" "$d/scripts/test-subjects"; then
		echo "test-checks: shard plant '$1' changed nothing"
		fail=1
	fi
	"$d/scripts/test-subjects" --shard "$3" >"$d/out" 2>&1
	local rc=$?
	if ((rc != 2)) || ! grep -q '^test-subjects: .*shard' "$d/out" || grep -qx fetch-reached "$d/out"; then
		echo "test-checks: test-subjects with $1 → rc $rc, want 2 + a shard message before any fetch"
		fail=1
	fi
}
shard_plant "a directory without a shard" '/^\t\[Tmm\]=/d' "1/$n"
shard_plant "a directory past shard N" "s/^\t\[Tmm\]=.*/\t[Tmm]=$((n + 1))/" "1/$n"
shard_plant "a shard holding no directory" '' "1/$((n + 1))"
shard_plant "a map entry owning no check" 's/^declare -A shard=($/&\n\t[Elsewhere]=1/' "1/$n"
shard_plant "shard 0" '' "0/$n"
shard_plant "shard N + 1" '' "$((n + 1))/$n"
# test-accept (merged acceptance checks) over a stub suite printing canned lines: each listed ID
# prints `ok ID` exactly once, an `ID HOST` row off HOST its `pending ID:` line; suite setup → rc 2
# shellcheck disable=SC2016 # the stub expands its own variables
d=$tmp/accept && mkdir -p "$d" &&
	printf '#!/bin/sh\ncat "$ACCEPT_LINES"\nexit "$ACCEPT_RC"\n' >"$d/suite" && chmod +x "$d/suite" || exit 2
accept_case() { # label want-rc suite-rc merged-rows suite-lines
	printf '%s\n' "$4" >"$d/merged" && printf '%s\n' "$5" >"$d/lines" || exit 2
	env FVA_ACCEPT_SUITE="$d/suite" FVA_ACCEPT_MERGED="$d/merged" ACCEPT_LINES="$d/lines" \
		ACCEPT_RC="$3" scripts/test-accept >/dev/null 2>&1
	local rc=$?
	((rc == $2)) || {
		echo "test-checks: test-accept $1 → rc $rc, want $2"
		fail=1
	}
}
h=$(hostname -s)
accept_case all-ok 0 1 $'A.x\nA.y' $'ok A.x\nok A.y\npending A.z: unmerged'
accept_case merged-fail 1 1 $'A.x\nA.y' $'ok A.x\nFAIL A.y: wrong count'
accept_case merged-missing 1 0 $'A.x\nA.y' 'ok A.x'
accept_case merged-twice 1 0 A.x $'ok A.x\nok A.x'
accept_case id-prefix 1 0 A.x 'ok A.xy'
accept_case host-elsewhere 0 1 "A.w not-$h" 'pending A.w: other host'
accept_case host-here 1 1 "A.w $h" 'pending A.w: this host'
accept_case host-fail 1 1 "A.w not-$h" 'FAIL A.w: wrong count'
accept_case suite-setup 2 2 A.x 'ok A.x'
# bench grading drivers (D53): each battery passes, and fails once a driver it controls is neutered
export FVA_GRADE_OUT=$tmp/grade
bench/grade/check-drivers >/dev/null || fail=1
bench/grade/check-fidelity >/dev/null || fail=1
d=$tmp/grade-plant && mkdir -p "$d" && printf '#!/usr/bin/env bash\nexit 0\n' >"$d/pass" && chmod +x "$d/pass"
expect_fail "check-drivers over a check-output that passes everything" . env FVA_GRADE_OUTPUT_CHECK="$d/pass" bench/grade/check-drivers
expect_fail "check-drivers over a claims scan that lists nothing" . env FVA_GRADE_CLAIMS="$d/pass" bench/grade/check-drivers
sed 's/if task == "lz4-rust" then lines := lines.push artifact/if false then lines := lines.push artifact/' \
	bench/grade/Fidelity.lean >"$d/Fidelity.lean"
expect_fail "check-fidelity over one shared T3 instance" . env FVA_GRADE_FIDELITY="$d/Fidelity.lean" bench/grade/check-fidelity
# check-json (D70): a Json.parse call outside FVA/Json.lean fails; the bounded parser's own file passes
d=$tmp/json && mkdir -p "$d/scripts" "$d/FVA/Tool" && cp scripts/check-json "$d/scripts/" &&
	printf 'def parseJson := Json.parse\n' >"$d/FVA/Json.lean" && touch "$d/Main.lean"
if ! (cd "$d" && scripts/check-json) >/dev/null; then
	echo "test-checks: check-json failed FVA/Json.lean's own Json.parse"
	fail=1
fi
printf 'def x := Json.parse "1"\n' >"$d/FVA/Tool/X.lean"
expect_fail "Json.parse outside FVA/Json.lean" "$d" scripts/check-json
# check-profile (U28a E7): the probe tables name exactly the support manifest's classes; a manifest
# class without a probe, a probe naming another class and a binary probe's unknown class each fail
d=$tmp/profile && mkdir -p "$d" && cp -r FVATest/Profile/probes "$d/probes"
if ! .lake/build/bin/fvatest profile >"$d/profile.json" ||
	! scripts/check-profile "$d/profile.json" "$d/probes" >/dev/null; then
	echo "test-checks: check-profile failed the committed probe tables"
	fail=1
fi
jq '.excluded += ["planted-class"]' "$d/profile.json" >"$d/extra.json"
expect_fail "check-profile: a manifest class without a probe" . scripts/check-profile "$d/extra.json" "$d/probes"
cp -r "$d/probes" "$d/p2" && sed -i 's/^x-simd\tsimd/x-simd\tvector/' "$d/p2/expected.tsv"
expect_fail "check-profile: a probe class outside the manifest" . scripts/check-profile "$d/profile.json" "$d/p2"
cp -r "$d/probes" "$d/p3" && sed -i 's/\tunsupported:gc-types\t/\tunsupported:gc\t/' "$d/p3/binary.tsv"
expect_fail "check-profile: a binary probe class outside the manifest" . scripts/check-profile "$d/profile.json" "$d/p3"
# make-base-manifest --check (U28a E8): a stale base-lines table fails, as a stale manifest does;
# a stub fvatest prints the committed table, a stub lake runs `lake env`'s command
d=$tmp/base && mkdir -p "$d/scripts" "$d/trust" "$d/.lake/build/bin" "$d/bin"
cp scripts/make-base-manifest "$d/scripts/" && cp -r FVA FVA.lean "$d/" && cp trust/base-lines.tsv "$d/trust/"
printf '#!/usr/bin/env bash\ncat %q\n' "$PWD/trust/base-lines.tsv" >"$d/.lake/build/bin/fvatest"
# shellcheck disable=SC2016 # the stub's own arguments
printf '#!/usr/bin/env bash\n[[ $1 == env ]] && shift\nexec "$@"\n' >"$d/bin/lake"
chmod +x "$d/.lake/build/bin/fvatest" "$d/bin/lake"
if ! (cd "$d" && PATH="$d/bin:$PATH" scripts/make-base-manifest --check) >/dev/null 2>&1; then
	echo "test-checks: make-base-manifest --check failed a current copy"
	fail=1
fi
sed -i '1s/\t[0-9]*$/\t9999/' "$d/trust/base-lines.tsv"
expect_fail "make-base-manifest: a stale base-lines table" "$d" env PATH="$d/bin:$PATH" scripts/make-base-manifest --check
cp trust/base-lines.tsv "$d/trust/" && echo '-- planted' >>"$d/FVA/Spec/Syntax.lean"
expect_fail "make-base-manifest: an edited base file" "$d" env PATH="$d/bin:$PATH" scripts/make-base-manifest --check
# fuzz-replay (D70): a reader that aborts on one input fails the step and names that input; a
# clean corpus passes; an empty corpus root is setup (rc 2)
d=$tmp/fuzz && mkdir -p "$d/corpus/lift" "$d/crashes/lift" "$d/empty"
printf '#!/usr/bin/env bash\nshift\nif grep -q BOOM "$@"; then kill -ABRT $$; fi\n' >"$d/runner" && chmod +x "$d/runner"
echo fine >"$d/corpus/lift/a"
if ! FVA_FUZZ_BIN=$d/runner FVA_FUZZ_DIR=$d scripts/fuzz-replay >/dev/null 2>&1; then
	echo "test-checks: fuzz-replay failed a clean corpus"
	fail=1
fi
echo BOOM >"$d/crashes/lift/crash-1"
out=$(FVA_FUZZ_BIN=$d/runner FVA_FUZZ_DIR=$d scripts/fuzz-replay 2>&1)
rc=$?
if ((rc != 1)) || [[ $out != *"crashes on $d/crashes/lift/crash-1"* ]]; then
	echo "test-checks: fuzz-replay over a crashing input → rc $rc, '$out'"
	fail=1
fi
FVA_FUZZ_BIN=$d/runner FVA_FUZZ_DIR=$d/empty scripts/fuzz-replay >/dev/null 2>&1
rc=$?
if ((rc != 2)); then
	echo "test-checks: fuzz-replay over no corpus → rc $rc, want 2"
	fail=1
fi
# official-script runner (U25): a module that links fails `assert_unlinkable`, a module whose import
# does not match fails `module`, a well-formed binary fails `assert_malformed` (each rc 1); their
# true counterparts (a mismatch, an unknown import, a bad version) pass (rc 0)
d=$tmp/runner && mkdir -p "$d"
runner() { # name wast-text: rc of fvatest spec over it
	printf '%s\n' "$2" >"$d/$1.wast"
	.tools/bin/wasm-tools json-from-wast "$d/$1.wast" -o "$d/$1.json" --wasm-dir "$d/" >/dev/null 2>&1 ||
		return 2
	.lake/build/bin/fvatest spec "$d/$1.json" >/dev/null 2>&1
}
export_f='(module (func (export "f") (result i32) i32.const 0)) (register "M")'
for case in \
	"links|$export_f (assert_unlinkable (module (import \"M\" \"f\" (func (result i32)))) \"x\")" \
	"mismatch|$export_f (module (import \"M\" \"f\" (func (param i32))))" \
	'wellformed|(assert_malformed (module binary "\00asm" "\01\00\00\00") "x")'; do
	runner "${case%%|*}" "${case#*|}"
	rc=$?
	if ((rc != 1)); then
		echo "test-checks: runner on a planted ${case%%|*} case → rc $rc, want 1"
		fail=1
	fi
done
runner true "$export_f (assert_unlinkable (module (import \"M\" \"f\" (func (param i32)))) \"x\")
(assert_unlinkable (module (import \"M\" \"g\" (func))) \"unknown import\")
(assert_malformed (module binary \"\\00asm\" \"\\02\\00\\00\\00\") \"unknown binary version\")"
rc=$?
if ((rc != 0)); then
	echo "test-checks: runner on true link-error + malformed assertions → rc $rc, want 0"
	fail=1
fi
# null expectations (U28b N1, reference interpreter runner.ml:476): an expected null matches the
# one runtime null whatever either heap type (rc 0); a non-null reference never matches it (rc 1)
runner null-cross '(module (func (export "f") (result funcref) ref.null func))
(assert_return (invoke "f") (ref.null extern))'
rc=$?
if ((rc != 0)); then
	echo "test-checks: runner on a null under another heap's null expectation → rc $rc, want 0"
	fail=1
fi
# shellcheck disable=SC2016 # WAT identifiers, not shell expansions
runner null-nonnull '(module (func $g) (elem declare func $g)
  (func (export "f") (result funcref) ref.func $g))
(assert_return (invoke "f") (ref.null func))'
rc=$?
if ((rc != 1)); then
	echo "test-checks: runner on a non-null reference under a null expectation → rc $rc, want 1"
	fail=1
fi
scripts/test-mutation-fixture || fail=1
scripts/test-subject-matrix || fail=1
scripts/test-char-fixture || fail=1
# U28b E3: tester-3's driver battery over scripts/test-p2exec (20 stubbed cases)
if ! FVATest/P2/check-driver >"$tmp/p2-driver.log" 2>&1; then
	echo "test-checks: p2exec driver battery failed"
	tail -20 "$tmp/p2-driver.log"
	fail=1
fi
exit "$fail"
