	scripts/check-profile "$d/profile.json" "$d/probes" "$d/fetch-corpus"
# check-skips (U28e I6): a skip passes only on a reason the command manifest, the payload or a
# skipped predecessor module establishes; each planted reason below fails
d=$tmp/skips && mkdir -p "$d"
.tools/bin/wasm-tools parse - -o "$d/one.wasm" <<<'(module (memory 1))'
printf '{"commands":[%s,%s,%s,%s]}\n' \
	'{"line":1,"type":"module","filename":"one.wasm"}' \
	'{"line":2,"type":"module","filename":"two.wasm"}' \
	'{"line":3,"type":"assert_malformed","module_type":"text","filename":"x.wat"}' \
	'{"line":4,"type":"assert_return"}' >"$d/s.json"
printf 's\t0\t1\tmodule\tbinary\tp-prime\tok\ns\t1\t2\tmodule\tbinary\tgc-types\tunsupported:gc-types\n' \
	>"$d/commands.tsv"
printf 's\t2\t3\tassert_malformed\ttext\t-\t-\n' >>"$d/commands.tsv"
features=$(jq -r .wasmToolsFeatures "$tmp/profile/profile.json")
skips() { # rows…: check-skips over the fixture with these outcome rows
	printf '%s\n' "$@" >"$d/out.tsv"
	scripts/check-skips s "$d/s.json" "$d/out.tsv" "$d/commands.tsv" "$features" >/dev/null 2>&1
}
r1=$'1\tmodule\tpass' r3=$'3\tassert_malformed\tskip: line 3: text format'
r2=$'2\tmodule\tskip: line 2: outside P′: excluded: gc-types'
r4=$'4\tassert_return\tskip: line 4: rejected module: line 2'
if ! skips "$r1" "$r2" "$r3" "$r4"; then
	echo "test-checks: check-skips failed justified skips"
	fail=1
fi
for planted in \
	"class|$r1|${r2/gc-types/simd}|$r3|$r4" \
	"text on binary|1	module	skip: line 1: text format|$r2|$r3|$r4" \
	"provenance to a passing module|$r1|$r2|$r3|${r4/line 2/line 1}" \
	"unknown reason|$r1|$r2|$r3|4	assert_return	skip: line 4: unsupported expectation" \
	"oracle accepts|1	module	skip: line 1: outside P′: oracle rejects: x|$r2|$r3|$r4" \
	"one memory|1	module	skip: line 1: outside P′: more than one memory|$r2|$r3|$r4"; do
	IFS='|' read -r -a rows <<<"$planted"
