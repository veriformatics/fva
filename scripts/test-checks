for planted in \
	"undeclared import|/\"proc_exit\"/a\\  $imp" \
	"import of another module|/\"proc_exit\"/a\\  (import \"env\" \"f\" (func))" \
	"legacy try|0,/^\\( *\\)try_table/s//\\1try\\n\\1end\\n\\1try_table/" \
	"throw removed|s/^\\( *\\)throw .*/\\1unreachable/" \
	"extra export|/(export \"memory\"/a\\  (export \"extra\" (memory 0))"; do
	label=${planted%%|*}
	if ! sed "${planted#*|}" "$d/eh.wat" >"$d/p.wat" ||
		! .tools/bin/wasm-tools parse "$d/p.wat" -o "$d/p.wasm"; then
		echo "test-checks: fingerprint plant '$label' does not assemble"
		fail=1
		continue
	fi
	fingerprint "$d/p.wasm"
	rc=$?
	if ((rc != 1)); then
		echo "test-checks: fingerprint on a planted $label: rc $rc, want 1"
		fail=1
	fi
done
# make-base-manifest --check (U28a E8): a stale base-lines table fails, as a stale manifest does;
# a stub fvatest prints the committed table, a stub lake runs `lake env`'s command
d=$tmp/base && mkdir -p "$d/scripts" "$d/trust" "$d/.lake/build/bin" "$d/bin"
cp scripts/make-base-manifest "$d/scripts/" && cp -r FVA FVA.lean "$d/" && cp trust/base-lines.tsv "$d/trust/"
