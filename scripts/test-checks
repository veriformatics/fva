		echo "test-checks: check-skips passed a planted ${rows[0]} skip"
		fail=1
	fi
done
# fingerprint (U28f I2): the C++ subject's EH form + import boundary over `wasm-tools print`; the
# shipped artifact passes, each planted print text (re-encoded by `wasm-tools parse`) fails with rc 1
d=$tmp/fingerprint && mkdir -p "$d"
fingerprint() { PATH=$PWD/.tools/bin:$PATH FVATest/Subjects/CppEH/fingerprint "$@" >/dev/null 2>&1; }
if ! fingerprint FVATest/Subjects/CppEH/eh.wasm; then
	echo "test-checks: fingerprint failed the shipped C++ subject"
	fail=1
fi
.tools/bin/wasm-tools print FVATest/Subjects/CppEH/eh.wasm >"$d/eh.wat"
