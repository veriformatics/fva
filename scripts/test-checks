# official-script runner (U25): a module that links fails `assert_unlinkable`, a module whose import
# does not match fails `module`, a well-formed binary fails `assert_malformed` (each rc 1); their
# true counterparts (a mismatch, an unknown import, a bad version) pass (rc 0)
d=$tmp/runner && mkdir -p "$d"
runner() { # name wast-text: rc of fvatest spec over it
	printf '%s\n' "$2" >"$d/$1.wast"
	.tools/bin/wasm-tools json-from-wast "$d/$1.wast" -o "$d/$1.json" --wasm-dir "$d/" >/dev/null 2>&1 ||
		return 2
	.lake/build/bin/fvatest spec "$d/$1.json" >/dev/null 2>&1
}
export_f='(module (func (export "f") (result i32) i32.const 0)) (register "M")'
for case in \
	"links|$export_f (assert_unlinkable (module (import \"M\" \"f\" (func (result i32)))) \"x\")" \
	"mismatch|$export_f (module (import \"M\" \"f\" (func (param i32))))" \
	'wellformed|(assert_malformed (module binary "\00asm" "\01\00\00\00") "x")'; do
	runner "${case%%|*}" "${case#*|}"
	rc=$?
	if ((rc != 1)); then
		echo "test-checks: runner on a planted ${case%%|*} case → rc $rc, want 1"
		fail=1
	fi
done
runner true "$export_f (assert_unlinkable (module (import \"M\" \"f\" (func (param i32)))) \"x\")
(assert_unlinkable (module (import \"M\" \"g\" (func))) \"unknown import\")
(assert_malformed (module binary \"\\00asm\" \"\\02\\00\\00\\00\") \"unknown binary version\")"
rc=$?
if ((rc != 0)); then
	echo "test-checks: runner on true link-error + malformed assertions → rc $rc, want 0"
	fail=1
fi
# null expectations (U28b N1, reference interpreter runner.ml:476): an expected null matches the
# one runtime null whatever either heap type (rc 0); a non-null reference never matches it (rc 1)
runner null-cross '(module (func (export "f") (result funcref) ref.null func))
(assert_return (invoke "f") (ref.null extern))'
rc=$?
if ((rc != 0)); then
	echo "test-checks: runner on a null under another heap's null expectation → rc $rc, want 0"
	fail=1
fi
# shellcheck disable=SC2016 # WAT identifiers, not shell expansions
runner null-nonnull '(module (func $g) (elem declare func $g)
  (func (export "f") (result funcref) ref.func $g))
(assert_return (invoke "f") (ref.null func))'
rc=$?
if ((rc != 1)); then
	echo "test-checks: runner on a non-null reference under a null expectation → rc $rc, want 1"
	fail=1
fi
# U28e E5 controls (`fvatest spec`, docs/contracts/U28e-runner.md): rc + per-command outcome
# prefixes. control NAME WANT_RC WAST [LINE=OUTCOME_PREFIX…]
control() {
	local name=$1 want=$2 spec rc
	printf '%s\n' "$3" >"$d/$name.wast"
	shift 3
	if ! .tools/bin/wasm-tools json-from-wast "$d/$name.wast" -o "$d/$name.json" \
		--wasm-dir "$d/" >/dev/null 2>&1; then
		echo "test-checks: control $name: json-from-wast failed"
		fail=1
		return
	fi
	: >"$d/$name.out"
	FVA_SPEC_OUTCOMES="$d/$name.out" .lake/build/bin/fvatest spec "$d/$name.json" >/dev/null 2>&1
	rc=$?
	if ((rc != want)); then
		echo "test-checks: control $name → rc $rc, want $want"
		fail=1
	fi
	for spec in "$@"; do
		awk -F '\t' -v l="${spec%%=*}" -v w="${spec#*=}" '$1 == l && index($3, w) == 1 {f = 1}
			END {exit !f}' "$d/$name.out" || {
			echo "test-checks: control $name: line ${spec%%=*} is not ${spec#*=}"
			fail=1
		}
	done
}
# shellcheck disable=SC2016 # WAT identifiers, not shell expansions
controls() {
	local f='(module (func (export "f") (param i32) (result i32) (local.get 0)))'
	local g='(module (func (export "g") (param funcref) (result i32) (i32.const 1)))'
	# I4: argument count + literal types against the export's parameters (upstream runner.ml:411)
	control arg-type 1 "$f
(assert_return (invoke \"f\" (i64.const 7)) (i64.const 7))" '2=fail:'
	control arg-many 1 "$f
(assert_return (invoke \"f\" (i32.const 7) (i32.const 8)) (i32.const 7))" '2=fail:'
	control arg-few 1 "$f
(assert_return (invoke \"f\") (i32.const 7))" '2=fail:'
	control arg-ok 0 "$f
(assert_return (invoke \"f\" (i32.const 7)) (i32.const 7))" '2=pass'
	control arg-null-heap 1 "$g
(assert_return (invoke \"g\" (ref.null extern)) (i32.const 1))" '2=fail:'
	control arg-null 0 "$g
(assert_return (invoke \"g\" (ref.null func)) (i32.const 1))" '2=pass'
	# I2: initializers in allocation order (U28c R1 = B) on the shared candidates
	control init-prefix 0 '(module $M (global (export "g") (mut i32) (i32.const 0)))
(register "M" $M)
(assert_trap (module (import "M" "g" (global $g (mut i32)))
  (global $a i32 (i32.const 5)) (global $b i32 (global.get $a))
  (func $s (global.set $g (global.get $b)) unreachable) (start $s)) "unreachable")
(assert_return (get $M "g") (i32.const 5))' '3=pass' '6=pass'
	# I2 result matrix: uninstantiable = a trap or an uncaught exception (runner.ml:559)
	control start-trap 0 '(assert_trap (module (func $s unreachable) (start $s)) "unreachable")' \
		'1=pass'
	control start-throw 0 \
		'(assert_trap (module (tag $t) (func $s (throw $t)) (start $s)) "uncaught exception")' '1=pass'
	control start-throw-module 1 '(module (tag $t) (func $s (throw $t)) (start $s))' '1=fail:'
	control start-caught 1 \
		'(module (tag $t) (func $s (block $h (try_table (catch_all $h) (throw $t)))) (start $s))
(assert_trap (module (tag $t) (func $s (block $h (try_table (catch_all $h) (throw $t))))
  (start $s)) "x")' '1=pass' '2=fail:'
	# I3: assert_exception = an uncaught exception alone; its effects stay
	control exc-return 1 '(module (func (export "r") (result i32) (i32.const 1)))
(assert_exception (invoke "r"))' '2=fail:'
	control exc-trap 1 '(module (func (export "t") unreachable))
(assert_exception (invoke "t"))' '2=fail:'
	control exc-effects 0 '(module (tag $e) (global $g (mut i32) (i32.const 0))
  (func (export "w") (global.set $g (i32.const 9)) (throw $e))
  (func (export "g") (result i32) (global.get $g))
  (func (export "c") (result i32) (block $h (try_table (catch_all $h) (throw $e))) (i32.const 5)))
(assert_exception (invoke "w"))
(assert_return (invoke "g") (i32.const 9))
(assert_return (invoke "c") (i32.const 5))' '5=pass' '6=pass' '7=pass'
}
controls
