#!/usr/bin/env bash
# Mutation update over GitHub-hosted runners (user ruling; .github/workflows/mutation.yml):
#   scripts/mutation-ci push NAME     push HEAD to ci/mut-NAME (the tree whose table is stale);
#                                     prints the workflow run id once GitHub lists it
#   scripts/mutation-ci collect RUN   merge every shard's execution cache of run RUN into
#                                     .cache/mutate/exec (shard entries win: they are this tree's)
# then `scripts/test-mutation --update` here (CLAUDE.local.md's cgroup form) reuses the merged
# executions, runs what no shard finished, and writes results.tsv; the commit gets that table.
# rc 0 ok, 1 run not found or no shard cache, 2 usage or setup.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
case ${1:-} in
push)
	[[ ${2:-} =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 2
	git push -f -q origin "HEAD:refs/heads/ci/mut-$2" || exit 2
	head=$(git rev-parse HEAD)
	# GitHub lists the run a few seconds after the push; poll ≥ 60 s apart (fva-gate.md)
	for _ in 1 2 3 4 5; do
		sleep 60
		id=$(gh run list --workflow mutation --branch "ci/mut-$2" --limit 5 \
			--json databaseId,headSha --jq ".[] | select(.headSha == \"$head\") | .databaseId" |
			head -1)
		[[ -n $id ]] && {
			echo "$id"
			exit 0
		}
	done
	exit 1
	;;
collect)
	[[ ${2:-} =~ ^[0-9]+$ ]] || exit 2
	tmp=$(mktemp -d) && trap 'rm -rf "$tmp"' EXIT
	gh run download "$2" -p 'mutate-exec-*' -D "$tmp" || exit 1
	mkdir -p .cache/mutate/exec || exit 2
	n=0
	for d in "$tmp"/mutate-exec-*/.cache/mutate/exec; do
		[[ -d $d ]] || continue
		cp -f "$d"/* .cache/mutate/exec/ 2>/dev/null
		n=$((n + $(find "$d" -type f | wc -l)))
	done
	((n)) || exit 1
	echo "mutation-ci: $n shard executions merged into .cache/mutate/exec"
	;;
*)
	echo 'usage: scripts/mutation-ci push NAME | collect RUN_ID' >&2
	exit 2
	;;
esac
