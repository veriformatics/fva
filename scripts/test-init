#!/usr/bin/env bash
# `fva init` end to end (U11, full gate): a project made by `fva init --wasm` with the toy
# example's claims and proofs builds and passes `fva trust` (this binary, from outside the
# project) with a 14-line surface: the vendored FVA counts as base by content; the same project
# with one vendored spec file edited reviews that file; `lake check` (bwrap sandbox, no
# --from-export) accepts it and rejects an extra axiom; a lakefile target that writes beside its
# project fails in fva trust's sandbox (D12). The project reuses this checkout's
# Mathlib (hard links) and FVA build (copy), so nothing is fetched or rebuilt.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
fva=$PWD/.lake/build/bin/fva
[[ -x $fva ]] || exit 2
# the trust runs check the pinned canaries (test-trust fetches them too; this keeps the order free)
scripts/fetch-canaries || exit 2
tmp=$(mktemp -d "$PWD/.lake/test-init.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
# a project named like the package it requires cannot build: init refuses it before writing
"$fva" init "$tmp/fva" --lib Demo >/dev/null 2>&1
rc=$?
if ((rc != 2)) || [[ -e $tmp/fva ]]; then
	echo "test-init: init into a directory named fva → rc $rc, pinned 2 with nothing written"
	exit 1
fi
p=$tmp/demo
"$fva" init "$p" --lib Demo --wasm FVATest/Examples/Toy/toy.wasm >/dev/null || exit 2
ex=FVATest/Examples/Toy
sed 's/FVATest.Examples.Toy.Lifted/Demo.Lifted/; s/Examples.Toy/Demo/' "$ex/Spec.lean" \
	>"$p/Demo/Spec.lean"
sed 's/FVATest.Examples.Toy.Spec/Demo.Spec/; s/Examples.Toy/Demo/' "$ex/Proof.lean" \
	>"$p/Demo/Proof.lean"
mkdir -p "$p/.lake" "$p/fva/.lake"
# hard links, not a symlink: `lake check`'s sandbox sees the project alone (a link out of it
# dangles there, and dependency resolution then fails on the existing path)
cp -al "$PWD/.lake/packages" "$p/.lake/packages" || exit 2
cp -a .lake/build "$p/fva/.lake/build"
(cd "$p" && lake build >"$tmp/build.log" 2>&1) || {
	echo "test-init: the project does not build"
	tail -5 "$tmp/build.log"
	exit 1
}
fail=0
trust() { (cd "$p" && "$fva" trust . --spec-module Demo.Spec --root-module Demo) >"$tmp/$1" 2>&1; }
echo '{"surfaceBudget": 14}' >"$p/fva.json"
trust plain.out
if ! grep -q '^fva trust: PASS' "$tmp/plain.out" ||
	! grep -q '^Read these: 14 code lines' "$tmp/plain.out"; then
	echo "test-init: fresh project → $(head -1 "$tmp/plain.out"), surface $(grep '^Read these' "$tmp/plain.out")"
	fail=1
fi
# D23: the project's fva.json budget one line under the surface fails `[surface]`
echo '{"surfaceBudget": 13}' >"$p/fva.json"
trust budget.out
if ! grep -q '^  \[surface\] 14 code lines to review, budget 13' "$tmp/budget.out"; then
	echo "test-init: fva.json budget 13 → $(head -1 "$tmp/budget.out"), pinned [surface] 14 > 13"
	fail=1
fi
echo '{"surfaceBudget": null}' >"$p/fva.json"
# the project, vendored FVA included, builds + replays inside `lake check`'s bwrap sandbox
# (no --from-export); a proof resting on an extra axiom → rc 1 naming it
# the cheat copy = hard links (the sandbox only reads), its Proof.lean a new file; both side by side
cp -al "$p" "$tmp/cheat" || exit 2
rm "$tmp/cheat/Demo/Proof.lean"
{
	cat "$p/Demo/Proof.lean"
	printf '\naxiom fvaCheatAx : False\ntheorem cheat_uses : 1 = 2 := fvaCheatAx.elim\n'
} >"$tmp/cheat/Demo/Proof.lean"
(cd "$p" && lake check) >"$tmp/check.out" 2>&1 &
ok=$!
(cd "$tmp/cheat" && lake check) >"$tmp/cheat.out" 2>&1
rc_cheat=$?
wait "$ok"
rc=$?
if ((rc == 2 || rc_cheat == 2)); then
	tail -5 "$tmp/check.out" "$tmp/cheat.out"
	exit 2
fi
if ((rc != 0)); then
	echo "test-init: lake check on the fresh project → rc $rc"
	tail -5 "$tmp/check.out"
	fail=1
fi
if ((rc_cheat != 1)) || ! grep -q "Axiom 'fvaCheatAx' is not permitted" "$tmp/cheat.out"; then
	echo "test-init: lake check on a proof using an extra axiom → rc $rc_cheat, pinned 1 naming it"
	tail -5 "$tmp/cheat.out"
	fail=1
fi
# D12: the project's code (here a lakefile build target) runs in the sandbox, so a write beside
# the project fails the build and leaves no file
l=$tmp/leak
mkdir -p "$l"
cat >"$l/lakefile.lean" <<LAKEFILE
import Lake
open Lake DSL

package leak

@[default_target] lean_lib Leak

/-- Writes beside the project when built. -/
@[default_target] target escape : Unit := do
  IO.FS.writeFile "$tmp/outside" "written by the build"
  return .nil
LAKEFILE
echo 'def x := 1' >"$l/Leak.lean"
echo '{"version": "1.3.0", "packagesDir": ".lake/packages", "packages": [], "name": "leak",' \
	'"lakeDir": ".lake"}' >"$l/lake-manifest.json"
"$fva" trust "$l" --spec-module Leak >"$tmp/leak.out" 2>&1
rc=$?
if ((rc != 1)) || [[ -e $tmp/outside ]] || ! grep -q '^  \[build\]' "$tmp/leak.out"; then
	echo "test-init: a build target writing beside the project → rc $rc, file" \
		"$([[ -e $tmp/outside ]] && echo written || echo absent); pinned rc 1, [build], absent"
	fail=1
fi
echo '-- edited after vendoring' >>"$p/fva/FVA/Spec/CAbi.lean"
(cd "$p" && lake build >"$tmp/build2.log" 2>&1) || exit 2
trust edited.out
if ! grep -q '^  FVA.Spec.CAbi: [0-9]* lines' "$tmp/edited.out"; then
	echo "test-init: an edited vendored spec file stayed out of the review surface"
	fail=1
fi
# D48: the project's build rewrites a Mathlib definition the claims use (`Real.sqrt`, the meaning of
# every `f32.sqrt`/`f64.sqrt` step: + 1), its module's broken proofs stubbed, and writes the
# recompiled module over the cache's; the module stays in a trusted package, so its bytes must fail
m=Mathlib/Analysis/Real/Sqrt
src=$tmp/planted/$m.lean
mkdir -p "$(dirname "$src")"
awk '/^@\[irreducible\] noncomputable def sqrt \(x : ℝ\) : ℝ :=$/ { d = 1; print; next }
	d && /^  NNReal.sqrt \(Real.toNNReal x\)$/ { print $0 " + 1"; d = 0; n = 1; next }
	{ print } END { exit n ? 0 : 2 }' ".lake/packages/mathlib/$m.lean" >"$src" || {
	echo "test-init: the planted Real.sqrt edit no longer applies to $m.lean"
	exit 2
}
olean=$p/.lake/packages/mathlib/.lake/build/lib/lean/$m.olean
rm -f "$olean" "$olean.server" "$olean.private"
# compile; each declaration Lean reports an error in gets its proof replaced by `sorry`
for round in 1 2 3 4 5; do
	lake env lean -o "$olean" "$src" >"$tmp/planted.log" 2>&1 && break
	((round < 5)) || exit 2
	sed -n "s|^$src:\([0-9]*\):[0-9]*: error.*|\1|p" "$tmp/planted.log" | sort -un >"$tmp/planted.err"
	[[ -s $tmp/planted.err ]] || exit 2
	awk -v errs="$tmp/planted.err" '
		BEGIN { while ((getline l < errs) > 0) bad[l] = 1 }
		{ line[NR] = $0 }
		END {
			for (i = 1; i <= NR; i++) {
				if (line[i] ~ /^[^ \t\/-]/ && line[i] !~ /^(end|namespace|section|open|variable)/) start = i
				if (bad[i] && start) hit[start] = 1
			}
			for (i = 1; i <= NR;) {
				if (!hit[i]) { print line[i++]; continue }
				for (j = i; j <= NR && index(line[j], ":=") == 0; j++) print line[j]
				if (j <= NR) print substr(line[j], 1, index(line[j], ":=") + 1) " sorry"
				for (j++; j <= NR && (line[j] == "" || line[j] ~ /^[ \t]/); j++) continue
				print ""
				i = j
			}
		}' "$src" >"$src.new" && mv "$src.new" "$src"
done
cp "$olean" "$tmp/planted.olean"
trust olean.out
if ! grep -q "^  \[olean\] Mathlib.Analysis.Real.Sqrt: compiled files differ" "$tmp/olean.out" ||
	! cmp -s "$olean" "$tmp/planted.olean"; then
	echo "test-init: a rewritten Mathlib definition → $(head -1 "$tmp/olean.out"), pinned [olean]" \
		"naming its module, the planted bytes kept ($(cmp -s "$olean" "$tmp/planted.olean" && echo kept || echo rebuilt))"
	fail=1
fi
((fail)) || echo "test-init: fresh project PASS, 14-line surface; edited vendored spec reviewed;" \
	"rewritten Mathlib definition [olean]"
exit "$fail"
