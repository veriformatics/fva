#!/usr/bin/env bash
# Official execution scripts through Exec.Ref; exact per-command counts prevent shrinking runs.
# Four workers; --fast omits the three long bulk scripts; names select checks for iteration.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
export PATH="$PWD/.tools/bin:$PATH"
started=$SECONDS
scripts/fetch-corpus || exit 1
lake build fvatest >/dev/null || exit 1
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
root=$PWD
# script pass fail skip; longest scripts first keeps the parallel tail short.
pinned="memory_copy 4386 0 64
memory_fill 36 0 64
bulk 117 0 0
address 259 0 1
align 73 0 92
annotations 4 0 70
binary 20 0 109
binary-leb128 33 0 58
block 53 0 170
br 77 0 20
br_if 89 0 30
call 73 0 18
call_indirect 137 0 35
comments 4 0 4
const 702 0 76
conversions 594 0 25
custom 3 0 8
data 42 0 26
elem 98 0 56
endianness 69 0 0
exports 65 0 32
f32 2501 0 13
f32_bitwise 361 0 3
f32_cmp 2401 0 6
f64 2501 0 13
f64_bitwise 361 0 3
f64_cmp 2401 0 6
fac 8 0 0
float_exprs 927 0 0
float_literals 101 0 78
float_memory 90 0 0
float_misc 471 0 0
forward 5 0 0
func 100 0 75
func_ptrs 29 0 7
global 6 0 118
i32 375 0 85
i64 385 0 31
id 1 0 6
if 125 0 116
imports 93 0 125
inline-module 1 0 0
int_exprs 108 0 0
int_literals 31 0 20
labels 26 0 3
left-to-right 96 0 0
linking 114 0 49
load 38 0 59
local_get 20 0 16
local_set 20 0 33
local_tee 56 0 42
loop 79 0 42
memory 64 0 26
memory_init 183 0 67
memory_redundancy 8 0 0
memory_size 40 0 2
memory_trap 182 0 0
names 486 0 0
nop 84 0 4
ref_func 14 0 3
return 64 0 20
select 127 0 30
skip-stack-guard-page 11 0 0
stack 7 0 0
start 16 0 4
store 10 0 58
switch 27 0 1
table 11 0 35
table_copy 1728 0 0
table_fill 36 0 9
table_get 11 0 5
table_grow 54 0 7
table_init 723 0 69
table_set 19 0 7
table_size 37 0 2
token 35 0 26
traps 36 0 0
type 1 0 2
unreachable 64 0 0
unreached-valid 2 0 11
unwind 50 0 0
utf8-invalid-encoding 0 0 183"
fast=false
if [[ ${1-} == --fast ]]; then
	fast=true
	shift
fi
if (($#)); then
	names=("$@")
elif $fast; then
	mapfile -t names < <(awk '$1 !~ /^(bulk|memory_copy|memory_fill)$/ {print $1}' <<<"$pinned")
else
	# memory_copy waits for the optimized machine (> 900 s on the reference stepper): deferred D30
	mapfile -t names < <(awk '$1 != "memory_copy" {print $1}' <<<"$pinned")
fi
for name in "${names[@]}"; do
	if $fast && [[ $name =~ ^(bulk|memory_copy|memory_fill)$ ]]; then
		echo "test-spec: $name requires the full mode" >&2
		exit 1
	fi
	row=$(awk -v name="$name" '$1 == name {print}' <<<"$pinned")
	if [[ -z $row ]]; then
		echo "test-spec: script is not pinned: $name" >&2
		exit 1
	fi
	printf '%s\n' "$row" >>"$work/expected.txt"
done
if [[ $(printf '%s\n' "${names[@]}" | sort -u | wc -l) != "${#names[@]}" ]]; then
	echo "test-spec: duplicate script names" >&2
	exit 1
fi

# Exported for the xargs child shells.
# shellcheck disable=SC2329
run_script() {
	local name=$1 start=$SECONDS rc
	mkdir -p "$work/$name"
	if ! wasm-tools json-from-wast "$root/.cache/corpus/testsuite/$name.wast" \
		-o "$work/$name/$name.json" --wasm-dir "$work/$name/" 2>"$work/$name.err"; then
		echo "test-spec: json-from-wast failed on $name" >>"$work/$name.err"
		return 1
	fi
	timeout 900s "$root/.lake/build/bin/fvatest" spec "$work/$name/$name.json" \
		>"$work/$name.out" 2>>"$work/$name.err"
	rc=$?
	if ((rc)); then
		echo "test-spec: $name rc=$rc (124 = 900-second execution limit)" >>"$work/$name.err"
	fi
	printf '%s %s\n' "$((SECONDS - start))" "$name" >"$work/$name.time"
	return "$rc"
}
export -f run_script
export work root
# The child shell expands $1.
# shellcheck disable=SC2016
printf '%s\n' "${names[@]}" | xargs -r -P 4 -n 1 bash -c 'run_script "$1"' _
rc=$?
: >"$work/actual.txt"
for name in "${names[@]}"; do
	if [[ -f $work/$name.out ]]; then
		awk '!/^  /' "$work/$name.out" >>"$work/actual.txt"
		awk '/^  FAIL/ {if (n++ < 20) print}' "$work/$name.out"
	fi
	if [[ -s $work/$name.err ]]; then tail -5 "$work/$name.err"; fi
done
if ! diff <(sort "$work/actual.txt") <(sort "$work/expected.txt") >"$work/diff.txt"; then
	echo "test-spec: counts differ from the pinned table (< actual, > pinned):"
	cat "$work/diff.txt"
	rc=1
fi
echo "test-spec: ${#names[@]} scripts; $((SECONDS - started))s; rc=$rc"
if compgen -G "$work/*.time" >/dev/null; then
	echo "test-spec: slowest scripts (seconds name):"
	sort -nr "$work/"*.time | head -5
fi
exit "$rc"
