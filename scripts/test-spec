differential table_fill 1 9 0
validation table_fill 1 0 0 9 0 0 0
differential table_get 1 5 0
validation table_get 1 0 0 5 0 0 0
differential table_grow 9 7 0
validation table_grow 9 0 0 7 0 0 0
differential table_init 40 67 1
validation table_init 40 0 0 67 0 1 0
differential table_set 1 7 0
validation table_set 1 0 0 7 0 0 0
differential table_size 1 2 0
validation table_size 1 0 0 2 0 0 0
differential token 35 0 0
validation token 35 0 0 0 26 0 0
differential traps 4 0 0
validation traps 4 0 0 0 0 0 0
differential type 1 0 0
validation type 1 0 0 0 2 0 0
differential unreachable 1 0 0
validation unreachable 1 0 0 0 0 0 0
differential unreached-valid 1 0 2
validation unreached-valid 1 0 0 0 0 2 0
differential unwind 1 0 0
validation unwind 1 0 0 0 0 0 0
differential utf8-invalid-encoding 0 0 0
validation utf8-invalid-encoding 3 0 0 0 180 0 0"
fast=false
if [[ ${1-} == --fast ]]; then
	fast=true
	shift
fi
if (($#)); then
	names=("$@")
elif $fast; then
	mapfile -t names < <(awk '$1 !~ /^(bulk|memory_fill)$/ {print $1}' <<<"$pinned")
else
	mapfile -t names < <(awk '{print $1}' <<<"$pinned")
fi
for name in "${names[@]}"; do
	if $fast && [[ $name =~ ^(bulk|memory_fill)$ ]]; then
		echo "test-spec: $name requires the full mode" >&2
		exit 2
	fi
	row=$(awk -v name="$name" '$1 == name {print}' <<<"$pinned")
	if [[ -z $row ]]; then
		echo "test-spec: script is not pinned: $name" >&2
		exit 2
	fi
	printf '%s\n' "$row" >>"$work/expected.txt"
	rows=$(awk -v name="$name" '$2 == name {print}' <<<"$coverage")
	if [[ $(wc -l <<<"$rows") != 2 ]]; then
		echo "test-spec: validation/differential counts are not pinned: $name" >&2
		exit 2
	fi
	printf '%s\n' "$rows" >>"$work/expected.txt"
done
if [[ $(printf '%s\n' "${names[@]}" | sort -u | wc -l) != "${#names[@]}" ]]; then
	echo "test-spec: duplicate script names" >&2
	exit 2
fi

# Compare every decoded binary candidate, including negative cases; decoder exclusions count.
# shellcheck disable=SC2329
diff_script() {
	local name=$1 file verdict oracle rc bad=0 positive=0 negative=0 excluded=0
	local -a files
	if ! jq -r --arg dir "$work/$name" '.commands[]
		| select(.type == "module" or .type == "assert_invalid" or
			.type == "assert_unlinkable" or .type == "assert_uninstantiable")
		| select((.module_type // "binary") == "binary")
		| $dir + "/" + .filename' "$work/$name/$name.json" >"$work/$name.candidates"; then
		: >"$work/$name.infra"
		return 2
	fi
	mapfile -t files <"$work/$name.candidates"
	if ((${#files[@]})); then
		"$root/.lake/build/bin/fvatest" validate "${files[@]}" >"$work/$name.valid"
		rc=$?
		if ((rc == 2 || rc == 126 || rc == 127)); then
			: >"$work/$name.infra"
			return 2
		fi
		if ((rc >= 128)); then
			: >"$work/$name.crash"
			return 3
		fi
		if ((rc > 1)) || ! cmp -s <(cut -f1 "$work/$name.valid") "$work/$name.candidates"; then
			echo "  FAIL $name: validator batch result count or status" >>"$work/$name.out"
			bad=1
		fi
		while IFS=$'\t' read -r file verdict; do
			case $verdict in
			valid | invalid)
				wasm-tools validate --features=wasm2,-simd "$file" >"$work/$name.oracle" 2>&1
				rc=$?
				if ((rc > 1)); then
					: >"$work/$name.infra"
					return 2
				fi
				oracle=invalid
				if ((rc == 0)); then oracle=valid; fi
				if [[ $oracle != "$verdict" ]]; then
					echo "  FAIL $name: differential $file FVA=$verdict wasm-tools=$oracle" >>"$work/$name.out"
					bad=1
				fi
				if [[ $verdict == valid ]]; then positive=$((positive + 1)); else negative=$((negative + 1)); fi
				;;
			malformed | unsupported) excluded=$((excluded + 1)) ;;
			*)
				echo "  FAIL $name: unknown validator verdict: $verdict" >>"$work/$name.out"
				bad=1
				;;
			esac
		done <"$work/$name.valid"
	fi
	printf 'differential %s %s %s %s\n' "$name" "$positive" "$negative" "$excluded" >>"$work/$name.out"
	return "$bad"
}

# Exported for the xargs child shells.
# shellcheck disable=SC2329
run_script() {
	local name=$1 start=$SECONDS rc diff_rc validation_only=${FVA_SPEC_VALIDATE_ONLY-0}
	mkdir -p "$work/$name"
	if ! wasm-tools json-from-wast "$root/.cache/corpus/testsuite/$name.wast" \
		-o "$work/$name/$name.json" --wasm-dir "$work/$name/" 2>"$work/$name.err"; then
		echo "test-spec: json-from-wast failed on $name" >>"$work/$name.err"
		: >"$work/$name.infra"
		return 1
	fi
	if [[ $name == memory_copy ]]; then validation_only=1; fi
	FVA_SPEC_VALIDATE_ONLY=$validation_only timeout 900s \
		"$root/.lake/build/bin/fvatest" spec "$work/$name/$name.json" \
		>"$work/$name.out" 2>>"$work/$name.err"
	rc=$?
	if ((rc)); then
		echo "test-spec: $name rc=$rc (124 = 900-second execution limit)" >>"$work/$name.err"
	fi
	# no verdict (U12 K4): the 900-second limit or a signal = crash, a missing program = setup
	if ((rc == 124 || rc >= 128)); then : >"$work/$name.crash"; fi
	if ((rc == 2 || rc == 126 || rc == 127)); then : >"$work/$name.infra"; fi
	diff_script "$name"
	diff_rc=$?
	if ((diff_rc)); then rc=$diff_rc; fi
	printf '%s %s\n' "$((SECONDS - start))" "$name" >"$work/$name.time"
	return "$rc"
}
export -f run_script diff_script
export work root
# The child shell expands $1.
# shellcheck disable=SC2016
printf '%s\n' "${names[@]}" | xargs -r -P 4 -n 1 bash -c 'run_script "$1"' _
rc=$?
: >"$work/actual.txt"
for name in "${names[@]}"; do
	if [[ -f $work/$name.out ]]; then
		awk '!/^  /' "$work/$name.out" >>"$work/actual.txt"
		awk '/^  FAIL/ {if (n++ < 20) print}' "$work/$name.out"
	fi
	if [[ -s $work/$name.err ]]; then tail -5 "$work/$name.err"; fi
done
corpus=(.cache/corpus/lz4-wasm-block-codec.wasm .cache/corpus/edgeR.so
	bench/subjects/wasm/*.wasm FVATest/Examples/*/*.wasm)
"$root/.lake/build/bin/fvatest" validate "${corpus[@]}" >"$work/corpus.valid"
corpus_rc=$?
if ((corpus_rc == 2 || corpus_rc == 126 || corpus_rc == 127)); then : >"$work/corpus.infra"; fi
if ((corpus_rc >= 128)); then : >"$work/corpus.crash"; fi
if ((corpus_rc)); then rc=1; fi
if ! cmp -s <(cut -f1 "$work/corpus.valid") <(printf '%s\n' "${corpus[@]}"); then
	echo "  FAIL corpus: validator batch filenames differ"
	rc=1
fi
oracle_count=0
for file in "${corpus[@]}"; do
	wasm-tools validate --features=wasm2,-simd "$file" >"$work/corpus.oracle" 2>&1
	oracle_rc=$?
	if ((oracle_rc == 0)); then oracle_count=$((oracle_count + 1)); else
		cat "$work/corpus.oracle" >&2
		if ((oracle_rc > 1)); then : >"$work/corpus.infra"; fi
		rc=1
	fi
done
valid_count=$(awk '$2 == "valid" {n++} END {print n+0}' "$work/corpus.valid")
printf 'corpus %s %s %s\n' "${#corpus[@]}" "$valid_count" "$oracle_count" >>"$work/actual.txt"
printf 'corpus 7 7 7\n' >>"$work/expected.txt"
if [[ -n ${FVA_SPEC_COUNTS-} ]]; then cp "$work/actual.txt" "$FVA_SPEC_COUNTS" || exit 2; fi
if ! diff <(sort "$work/actual.txt") <(sort "$work/expected.txt") >"$work/diff.txt"; then
	echo "test-spec: counts differ from the pinned table (< actual, > pinned):"
	cat "$work/diff.txt"
	rc=1
fi
echo "test-spec: ${#names[@]} scripts; $((SECONDS - started))s; rc=$rc"
if compgen -G "$work/*.time" >/dev/null; then
	echo "test-spec: slowest scripts (seconds name):"
	sort -nr "$work/"*.time | head -5
fi
compgen -G "$work/*.infra" >/dev/null && exit 2
compgen -G "$work/*.crash" >/dev/null && exit 3
((rc == 0)) || exit 1
