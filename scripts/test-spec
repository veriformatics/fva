table_grow 61 0 0
table_init 790 0 2
table_set 26 0 0
table_size 39 0 0
token 35 0 26
traps 36 0 0
type 1 0 2
unreachable 64 0 0
unreached-valid 2 0 11
unwind 50 0 0
utf8-invalid-encoding 3 0 180"
coverage="differential address 4 0 0
validation address 4 0 0 0 0 0 1
differential align 25 42 2
validation align 25 0 0 42 48 0 2
differential annotations 4 0 0
validation annotations 10 0 0 0 64 0 0
differential binary 20 0 1
validation binary 20 0 0 0 108 0 1
differential binary-leb128 33 0 0
