left-to-right 96 0 0
linking 133 0 30
load 84 0 13
local_get 36 0 0
local_set 53 0 0
local_tee 97 0 1
loop 106 0 15
memory 80 0 10
memory_init 250 0 0
memory_redundancy 8 0 0
memory_size 42 0 0
memory_trap 182 0 0
names 486 0 0
nop 88 0 0
ref_func 17 0 0
