#!/usr/bin/env bash
# Official validation + execution scripts; exact counts prevent shrinking runs.
# Four workers; --fast omits bulk + memory_fill. memory_copy validates without executing (D30).
# Validation columns: module unlinkable uninstantiable invalid malformed outside undecodable.
# Differential columns: valid invalid undecoded (binary candidates; wasm2,-simd oracle).
# FVA_SPEC_COUNTS=<file> records actual rows without bypassing comparison; names select scripts.
# Exit status (U12 K4): 0 pass, 1 assertion failure, 2 setup/infrastructure, 3 the program
# under test crashed (signal).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
export PATH="$PWD/.tools/bin:$PATH"
started=$SECONDS
scripts/fetch-corpus || exit 2
lake build fvatest >/dev/null || exit 2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
root=$PWD
if [[ ${1-} == --kernel ]]; then
	(($# == 1)) || exit 2
	lake build fva >/dev/null || exit 2
	.lake/build/bin/fva lift .cache/corpus/edgeR.so "$work/ValidSubject.lean" --ns ValidSubject || exit 2
	begin=$(date +%s%N)
	lake env lean -R "$work" -o "$work/ValidSubject.olean" "$work/ValidSubject.lean" \
		>"$work/lift.log" 2>&1
	rc=$?
	if ((rc)); then
		tail -20 "$work/lift.log"
		((rc < 128)) || exit 3
		exit 1
	fi
	echo "test-spec kernel: edgeR 96558 bytes, lifted subject wall_ms=$((($(date +%s%N) - begin) / 1000000))"
	cat >"$work/Smoke.lean" <<'LEAN'
import ValidSubject
import FVA.Impl.Valid
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
theorem accepted : FVA.Wasm.Valid.validate ValidSubject.module = true := by decide +kernel
#print axioms accepted
LEAN
	begin=$(date +%s%N)
	# The child expands Lake's LEAN_PATH plus the temporary lifted module.
	# shellcheck disable=SC2016
	lake env bash -c 'export LEAN_PATH="$1:$LEAN_PATH"; lean -R "$1" "$1/Smoke.lean"' _ "$work" \
		>"$work/kernel.log" 2>&1
	rc=$?
	cat "$work/kernel.log"
	echo "test-spec kernel: validate wall_ms=$((($(date +%s%N) - begin) / 1000000)); rc=$rc"
	((rc < 128)) || exit 3
	((rc == 0)) || exit 1
	exit 0
fi
# script pass fail skip; longest scripts first keeps the parallel tail short.
pinned="memory_copy 97 0 4353
memory_fill 100 0 0
bulk 117 0 0
address 259 0 1
align 115 0 50
annotations 10 0 64
binary 20 0 109
