#!/usr/bin/env bash
# mutation-plan N: split the mutation scope into shards for .github/workflows/mutation.yml
# (user ruling: updates run sharded over GitHub-hosted runners). Prints {"indices": [0..M-1],
# "total": t, "shards": [{"files", "decls", "slice", "mutants"}…]}: N packed shards, then one
# shard per slice of each declaration holding more than 1.8 × the per-shard target (`slice` =
# "K/S", fvamut `--slice`: one runner + one worker would exceed the 6 h job limit on a whole one,
# Ref.instrStep: 378 mutants); S = ⌈3 × count ÷ target⌉, since such a declaration's mutants
# rebuild more downstream proofs (instrStep 137 s, atInstr 177 s per mutant vs ≈ 60 s typical);
# packed shards carry `slice` null.
# A shard runs `scripts/test-mutation update --files F… --decls D… [--slice K/S]`: an ad-hoc run
# writes its executions to the content-keyed cache (.cache/mutate/exec), never results.tsv; a
# later full `--update` over the merged caches writes the table (scripts/mutation-ci). Units =
# whole files (one probe each per shard), a file above the per-shard target split by declaration;
# packing = largest unit first into the least-loaded shard. Counts = every listed mutant (a landing
# re-keys nearly every row; current rows cost a shard nothing). rc 0 ok, 2 usage or setup.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
[[ ${1:-} =~ ^[1-9][0-9]*$ && $# == 1 ]] || {
	echo 'usage: scripts/mutation-plan N' >&2
	exit 2
}
n=$1
list=$(mktemp) && trap 'rm -f "$list"' EXIT
scripts/test-mutation list >"$list" 2>&1 || {
	tail -5 "$list" >&2
	exit 2
}
# id = file:decl:OP:k (Lean names hold no ':' in this scope)
grep -P '\tline [0-9]+\t' "$list" | cut -f1 | awk -F: '
	{ decl = $2; for (i = 3; i <= NF - 2; i++) decl = decl ":" $i; c[$1 "\t" decl]++ }
	END { for (k in c) print c[k] "\t" k }' |
	jq -R -s --argjson n "$n" '
	[split("\n")[] | select(length > 0) | split("\t") | {count: (.[0] | tonumber), file: .[1], decl: .[2]}] as $rows |
	($rows | map(.count) | add) as $total |
	(($total + $n - 1) / $n | floor) as $target |
	($rows | map(select(.count > 1.8 * $target))) as $big |
	($rows | map(select(.count <= 1.8 * $target))) as $rows |
	[$big[] | (((3 * .count + $target - 1) / $target) | floor) as $s | . as $d | range($s) as $k |
		{files: [$d.file], decls: [$d.decl], slice: "\($k)/\($s)",
		 mutants: (((($d.count - $k) + $s - 1) / $s) | floor)}] as $slices |
	[$rows | group_by(.file)[] |
		(map(.count) | add) as $c |
		if $c <= $target then {files: [.[0].file], decls: map(.decl), mutants: $c}
		else
			(sort_by(-.count) | reduce .[] as $d ([];
				if length > 0 and (.[-1].mutants + $d.count) <= $target
				then .[-1].decls += [$d.decl] | .[-1].mutants += $d.count
				else . + [{files: [$d.file], decls: [$d.decl], mutants: $d.count}] end))[]
		end] |
	sort_by(-.mutants) |
	reduce .[] as $u ([range($n)] | map({files: [], decls: [], slice: null, mutants: 0});
		(to_entries | min_by(.value.mutants) | .key) as $i |
		.[$i].files = (.[$i].files + $u.files | unique) |
		.[$i].decls += $u.decls | .[$i].mutants += $u.mutants) |
	(. + $slices) | {indices: [range(length)], total: $total, shards: .}' || exit 2
