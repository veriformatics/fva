#!/usr/bin/env bash
# Lean source format (no official formatter exists): lines <= 100 columns, no tabs,
# no trailing whitespace, final newline. Prints each violation; rc 1 if any. `fva lift` and
# `fva blob` output (line 3 = its "Generated by" header) is exempt from the column rule: it is
# regenerated byte-identically, and `fva trust` rejects any edit to it.
set -euo pipefail
cd "$(dirname "$0")/.."
mapfile -t files < <(git ls-files -co --exclude-standard -- '*.lean' ':!:prototype/**' ':!:bench/runs/**')
bad=0
for f in "${files[@]}"; do
	[[ -f $f ]] || continue
	awk -v f="$f" '
		NR == 3 && /^\/-! Generated by `fva (lift|blob)`/ { lifted = 1 }
		length($0) > 100 && !lifted { printf "%s:%d: line longer than 100 columns\n", f, NR; bad = 1 }
		/\t/ { printf "%s:%d: tab character\n", f, NR; bad = 1 }
		/[ \t]+$/ { printf "%s:%d: trailing whitespace\n", f, NR; bad = 1 }
		END { exit bad }' "$f" || bad=1
	[[ -s $f && $(tail -c1 "$f" | od -An -c | tr -d ' ') == '\n' ]] || {
		echo "$f: missing final newline"
		bad=1
	}
done
exit "$bad"
