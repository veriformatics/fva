#!/usr/bin/env bash
# fva trust (U7 S2, E1): the glue checks (FVATest.Trust) hold; FVA's self package must PASS; every
# cheat project under FVATest/Cheats/ must FAIL with exactly its pinned tag set (Clean = PASS);
# planted canary sets fail `[checker]`. rc 0 = all as pinned.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
scripts/fetch-canaries || exit 2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
set=trust/canaries/set.tsv
: >"$tmp/empty.tsv"
# a positive control listed as known-false: every kernel accepts it
grep -P '^arena/good/tutorial/001_basicDef\t' "$set" | sed 's/\tgood$/\tbad/' >"$tmp/good.tsv"
printf 'leanchecker\tarena/good/tutorial/001_basicDef\tplanted\ncon-leche\tarena/good/tutorial/001_basicDef\tplanted\n' >"$tmp/good-known.tsv"
# a canary whose pinned sha256 its file misses: never run
grep -P '^arena/bad/bugs/constlevels\t' "$set" | sed 's/\t[0-9a-f]\{64\}\t/\t'"$(printf '0%.0s' {1..64})"'\t/' >"$tmp/altered.tsv"
# Lean's kernel accepts the #15704 export by design: covered by con-leche's reject when known
grep -P '^prelude-15704/replaced-prelude\t' "$set" >"$tmp/prelude.tsv"
for f in good altered prelude; do [[ -s $tmp/$f.tsv ]] || exit 2; done
# project, wanted tag set, extra `fva trust` arguments
pinned="Clean PASS
Clean checker --canary-set $tmp/empty.tsv
Clean checker --canary-set $tmp/good.tsv
Clean checker --canary-set $tmp/good.tsv --known $tmp/good-known.tsv
Clean checker --canary-set $tmp/altered.tsv
Clean checker --canary-set $tmp/prelude.tsv --known $tmp/empty.tsv
Clean PASS --canary-set $tmp/prelude.tsv
Clean surface --surface-budget 4
Clean PASS --surface-budget 5
Unmarked PASS
Axiom axiom,replay
Sorry axiom,replay
SkipKernel replay
Decline link,replay,vacuous
NativeDecide axiom,replay
Vacuous vacuous
Syntax syntax
Syntax syntax --subject FVATest.Cheats.Syntax.Vocab
SubjectInstance subject --subject FVATest.Cheats.SubjectInstance.Impl
SubjectArg PASS --subject FVATest.Cheats.SubjectArg.Impl
Layout layout
LinkSource link
LinkMissing link
LinkEscape link
LinkNoDecodeEq link,vacuous
LinkOtherNumeral link,vacuous
LinkExtra link,syntax
Prelude prelude
Override override
OverridePartial override
OverrideExtern override
CertEditedOut link
CertEditedIn link"
mapfile -t cheats < <(cut -d" " -f1 <<<"$pinned" | sort -u)
# the cheat roots are no default target: build them by module name
lake build fva FVA "${cheats[@]/#/FVATest.Cheats.}" >/dev/null || exit 2
examples=(Toy Mem Rust)
# the examples are proofs FVA ships: warnings fail them (the cheats warn by design)
lake --wfail build "${examples[@]/#/FVATest.Examples.}" FVATest.Examples.Mislabeled \
	FVATest.Examples.Planted FVATest.Examples.Relational >/dev/null || exit 2
fva=.lake/build/bin/fva
fail=0
log=$tmp/log
if ! lake build FVATest.Trust FVATest.Explain >"$log" 2>&1; then
	echo "test-trust: glue checks (FVATest.Trust, FVATest.Explain) failed"
	grep '^error' "$log" | head -5
	fail=1
fi
lake --wfail build FVATest.Certs FVATest.Certs.Custom.Rev >/dev/null || exit 2
subjects=()
for m in FVA.Impl.Decode FVA.Impl.Decode.Reader FVA.Impl.Decode.Instr FVA.Impl.Decode.Module \
	FVA.Impl.Exec.Ref FVA.Impl.Exec.Det FVA.Impl.Numerics.Float FVA.Trust.Verdict \
	FVA.Impl.Cert.Sort FVA.Impl.Cert.Compile FVA.Impl.Valid; do
	subjects+=(--subject "$m")
done
# a relative project directory, from a directory outside it where `lean` finds no toolchain
# (elan without a default: the nearest `lean-toolchain` alone names one): the toolchain comes from
# the project, and trust-run works inside the project
real=$(command -v lean) || exit 2
mkdir "$tmp/bin"
cat >"$tmp/bin/lean" <<EOF
#!/usr/bin/env bash
d=\$PWD
until [[ -e \$d/lean-toolchain ]]; do
	[[ \$d == / ]] && { echo 'error: no default toolchain configured' >&2; exit 1; }
	d=\$(dirname "\$d")
done
exec '$real' "\$@"
EOF
chmod +x "$tmp/bin/lean"
rel=$(realpath --relative-to="$tmp" "$PWD")
# shellcheck disable=SC2329 # run through job
relative() {
	cd "$tmp" && PATH=$tmp/bin:$PATH "$rel/$fva" trust "$rel" \
		--spec-module FVATest.Cheats.Clean.Spec --root-module FVATest.Cheats.Clean
}
# D38: every run is a background job, FVA_TRUST_JOBS at a time (default nproc / 2, at least 1;
# each a few GB at most), the longest first; every pinned outcome is checked after
jobs=${FVA_TRUST_JOBS:-$(($(nproc) / 2))}
((jobs >= 1)) || jobs=1
throttle() { while (($(jobs -rp | wc -l) >= jobs)); do wait -n; done; }
job() { # NAME CMD… → $tmp/NAME.{log,rc,sec}
	local name=$1
	shift
	throttle
	{
		local s=$SECONDS
		"$@" >"$tmp/$name.log" 2>&1
		echo $? >"$tmp/$name.rc"
		echo $((SECONDS - s)) >"$tmp/$name.sec"
	} &
}
rc() { cat "$tmp/$1.rc" 2>/dev/null || echo 255; } # a missing rc = a run that died
tags() { sed -n 's/^  \[\([a-z]*\)\].*/\1/p' "$tmp/$1.log" | sort -u | paste -sd,; }
t0=$SECONDS
self=(trust . --spec-module FVA.Self.Spec --root-module FVA.Self "${subjects[@]}")
job paranoid "$fva" "${self[@]}" --paranoid
job self "$fva" "${self[@]}"
# D61: lean4lean decides by its final exception's message alone: a true theorem named like its
# heartbeat-limit message, printed inside the refutation of a false proof, leaves that a reject
job decline "$fva" trust . --spec-module FVATest.Cheats.Decline.Spec \
	--root-module FVATest.Cheats.Decline --paranoid
# worked examples (U8): each must PASS; `fva explain` runs `fva trust` itself, then shows the
# saved explanation (U10: rc 0 = trust PASS + every intent check `matches` + the text current);
# beside them the accepted certificates (U9), one aggregate run, must PASS
job certs "$fva" trust . --spec-module FVATest.Certs.Spec --root-module FVATest.Certs
for ex in "${examples[@]}" Mislabeled Planted Relational; do
	job "ex.$ex" "$fva" explain . --spec-module "FVATest.Examples.$ex.Spec" \
		--root-module "FVATest.Examples.$ex"
done
n=0
while read -r c want args; do
	n=$((n + 1))
	# shellcheck disable=SC2086 # extra arguments split on purpose
	job "cheat.$n" "$fva" trust . --spec-module "FVATest.Cheats.$c.Spec" \
		--root-module "FVATest.Cheats.$c" $args
done <<<"$pinned"
# D13: an unmarked Prop of the spec module is no claim, and the report lists it apart
job unmarked "$fva" trust . --spec-module FVATest.Cheats.Unmarked.Spec \
	--root-module FVATest.Cheats.Unmarked
# a project relation is read in the project's review surface (10 lines with its spec: budget 5)
job rev "$fva" trust . --spec-module FVATest.Certs.Custom.Rev.Spec \
	--root-module FVATest.Certs.Custom.Rev --surface-budget 5
# a certificate without a valid proof fails its build at the kernel check
negs=(NaiveR Dup Unsorted JsRound Trailing Tampered UnusedInvalid)
for neg in "${negs[@]}"; do job "neg.$neg" lake build "FVATest.Certs.Neg.$neg"; done
job relative relative
# the spec module declared a subject (which would leave the review surface) = usage error
job usage "$fva" trust . --spec-module FVATest.Cheats.Clean.Spec \
	--root-module FVATest.Cheats.Clean --subject FVATest.Cheats.Clean.Spec
wait
runs=$(find "$tmp" -maxdepth 1 -name '*.sec' | wc -l)
slowest=$(for f in "$tmp"/*.sec; do printf '%s %s\n' "$(<"$f")" "$(basename "$f" .sec)"; done |
	sort -rn | head -3 | awk '{printf "%s%s %s s", (NR > 1 ? ", " : ""), $2, $1}')
echo "test-trust: $runs runs in $((SECONDS - t0)) s ($jobs at a time); slowest: $slowest"
grep -A3 'Kernel replay' "$tmp/self.log"
if (($(rc self) != 0)); then
	echo "test-trust: self package rc $(rc self)"
	head -20 "$tmp/self.log"
	fail=1
fi
grep -A7 'Kernel replay' "$tmp/paranoid.log"
if (($(rc paranoid) != 0)); then
	echo "test-trust: self package --paranoid rc $(rc paranoid)"
	head -20 "$tmp/paranoid.log"
	fail=1
fi
n=0
while read -r c want args; do
	n=$((n + 1))
	got=$(tags "cheat.$n")
	[[ -z $got ]] && grep -q '^fva trust: PASS' "$tmp/cheat.$n.log" && got=PASS
	if [[ $got != "$want" ]]; then
		echo "test-trust: FVATest.Cheats.$c $args → $got, pinned $want"
		fail=1
	fi
done <<<"$pinned"
if [[ $(tags decline) != link,replay,vacuous ]] ||
	! grep -q '^  lean4lean (lean): rejected' "$tmp/decline.log"; then
	echo "test-trust: Decline --paranoid → $(tags decline), $(grep '^  lean4lean (' \
		"$tmp/decline.log");" "pinned link,replay,vacuous + lean4lean rejected"
	fail=1
fi
if ! grep -q '^Prop definitions without @\[fva_claim\]' "$tmp/unmarked.log" ||
	! grep -qx '  Cheats.Unmarked.empty' "$tmp/unmarked.log"; then
	echo "test-trust: Unmarked → the unmarked Prop is not listed apart"
	fail=1
fi
for ex in "${examples[@]}"; do
	if (($(rc "ex.$ex") != 0)) || ! grep -q '^  Proof check (fva trust): PASS$' "$tmp/ex.$ex.log"; then
		echo "test-trust: example $ex → explain rc $(rc "ex.$ex")"
		grep -E '^  (Proof check|STALE)|Intent check|✗' "$tmp/ex.$ex.log" | head -5
		fail=1
	fi
done
# D5: a proven claim named and documented `clamp` that returns `x`, checked against the
# requirement R1 (clamp) under neutral names → R1 DIFFERENT, rc 1 (saved text, current)
l=$tmp/ex.Mislabeled.log
if (($(rc ex.Mislabeled) != 1)) || ! grep -q '^  Proof check (fva trust): PASS$' "$l" ||
	! grep -q '^  ✗ R1: DIFFERENT' "$l" || grep -q STALE "$l"; then
	echo "test-trust: example Mislabeled → explain rc $(rc ex.Mislabeled), pinned 1 with R1 DIFFERENT"
	grep -E '^  (Proof check|STALE|✗|✓)' "$l" | head -5
	fail=1
fi
# D16: the planted `sumBelow` (compiled code returns 0) shows its kernel value: each saved
# `sumToSpec` example agrees with the binary, one of them past the fixed inputs 0 and 1
l=$tmp/ex.Planted.log
block=$(sed -n '/^Examples.Planted.sumToSpec$/,/^Examples\./p' "$l")
if grep -q STALE "$l" || grep -q '✗ binary' <<<"$block" ||
	! grep -qE 'sum_to\(([2-9]|[1-9][0-9]+)\) → [0-9]+ binary agrees' <<<"$block"; then
	echo "test-trust: example Planted → sumToSpec's examples are stale or disagree with the binary"
	fail=1
fi
# D18: relational claims get rows: a `Returns … → r ≤ n` claim shows a failing case of the
# binary's result, a decidable claim its decided cases
l=$tmp/ex.Relational.log
block=$(sed -n '/^Examples.Relational.sumToAtMost$/,/^Examples\./p' "$l")
if grep -q STALE "$l" || ! grep -qE '^    sum_to\([0-9]+\) → [0-9]+: the condition fails' <<<"$block" ||
	! grep -qE '^    a = [0-9]+, b = [0-9]+: the statement holds' "$l"; then
	echo "test-trust: example Relational → no relational rows (or stale)"
	fail=1
fi
if (($(rc certs) != 0)) || ! grep -q '^fva trust: PASS' "$tmp/certs.log"; then
	echo "test-trust: accepted certificates → rc $(rc certs)"
	grep '^  \[' "$tmp/certs.log" | head -5
	fail=1
fi
for neg in "${negs[@]}"; do
	if (($(rc "neg.$neg") == 0)) || ! grep -q 'declaration type mismatch' "$tmp/neg.$neg.log"; then
		echo "test-trust: certificate Neg.$neg built, or failed for another reason"
		fail=1
	fi
done
if ! grep -q '^  \[surface\] .* code lines to review, budget 5' "$tmp/rev.log" ||
	! grep -q 'FVATest.Certs.Custom.Rel' "$tmp/rev.log"; then
	echo "test-trust: project relation outside the surface or budget not enforced"
	fail=1
fi
if (($(rc relative) != 0)); then
	echo "test-trust: relative project directory → rc $(rc relative), pinned 0"
	grep -E '^(fva trust|uncaught|error|  [[])' "$tmp/relative.log" | head -5
	fail=1
fi
if (($(rc usage) != 2)); then
	echo "test-trust: spec module as subject → rc $(rc usage), pinned 2"
	fail=1
fi
((fail)) || echo "test-trust: glue checks + self package + $n cheat runs + 2 usage cases checked"
exit "$fail"
