#!/usr/bin/env bash
# Mount one working directory; arguments name paths relative to that directory.
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
if [[ $# == 0 || $1 == --help ]]; then
	echo 'Usage: bench/tools/frama-c [--check-wp] WORKDIR [FRAMA_C_ARGUMENT ...]'
	exit 0
fi
check=false
if [[ $1 == --check-wp ]]; then
	check=true
	shift
fi
[[ $# -gt 0 ]] || exit 2
work=$(realpath -e -- "$1")
shift
[[ -d $work ]] || {
	echo 'frama-c: WORKDIR must be a directory' >&2
	exit 2
}
image=$("$root/scripts/fetch-bench-tools" --print-frama-image)
args=("$@")
# A podman container outlives its client, so the container is named + labelled and killed on
# TERM/INT/EXIT here and by label in tool-broker; memory capped without swap; pinned to the run's
# CPUs when the broker passes them (rubric addendum 2026-10-28).
name=fva-frama-$$-$(date +%s%N)
limits=(--memory "${FVA_TOOL_MEMORY:-16g}" --memory-swap "${FVA_TOOL_MEMORY:-16g}")
[[ -z ${FVA_TOOL_CPUS:-} ]] || limits+=(--cpuset-cpus "$FVA_TOOL_CPUS")
[[ -z ${FVA_TOOL_LABEL:-} ]] || limits+=(--label "$FVA_TOOL_LABEL")
report=
cleanup() {
	podman kill "$name" >/dev/null 2>&1 || true
	[[ -z $report ]] || rm -rf -- "$report"
}
trap cleanup EXIT
trap 'exit 143' TERM INT
if $check; then
	for arg in "$@"; do
		[[ $arg != -wp-report-json* ]] || {
			echo 'frama-c: --check-wp owns its report' >&2
			exit 2
		}
	done
	report=$(mktemp -d "$work/.fva-wp.XXXXXXXX")
	args+=(-wp -wp-report-json "/work/${report##*/}/report.json")
fi
# background + wait: a trapped signal interrupts `wait`, never a foreground child
podman run --rm --name "$name" "${limits[@]}" --pull never --network none --userns keep-id \
	--volume "$work:/work:rw" --workdir /work \
	--volume "$root/.tools/frama-c:/opt/fva-frama:ro" \
	"$image" env OCAMLPATH=/opt/fva-frama/lib /opt/fva-frama/bin/frama-c "${args[@]}" &
rc=0
wait $! || rc=$?
((rc == 0)) || exit "$rc"
# Frama-C's raw rc 0 means analysis completed, including unproved goals.
if $check; then
	jq -e 'type == "array" and length > 0 and
    all(.[]; .passed == true and .verdict == "valid" and .smoke == false)' \
		"$report/report.json" >/dev/null || {
		echo 'frama-c: WP did not prove every reported goal' >&2
		exit 1
	}
fi
