#!/usr/bin/env bash
# The archived benchmark runs (Decisions: Repository contents) → bench/runs/, unpacked from the
# archive bench/subjects/manifest.json pins (`archives`, fetched from veriformatics/fva-artifacts
# by scripts/fetch-bench, sha256-checked). bench/runs/.archive-sha256 records the unpacked
# archive: a matching stamp keeps the tree, any other state unpacks afresh (a partial unpack
# leaves no stamp). rc 0 ok, 2 setup or fetch failure.
set -uo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
id=bench-runs-v2
line=$("$root/scripts/fetch-bench" "$id" | tail -1) || exit 2
sha=${line%% *} archive=${line#*  }
stamp=$root/bench/runs/.archive-sha256
[[ -f $stamp && $(<"$stamp") == "$sha" ]] && exit 0
rm -rf "$root/bench/runs" || exit 2
xz -dc "$archive" | tar -xf - -C "$root" || exit 2
printf '%s\n' "$sha" >"$stamp" || exit 2
