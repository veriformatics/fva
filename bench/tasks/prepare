#!/usr/bin/env bash
# Assembles one run's input directory for bench/harness/run-session: the task's README.md +
# CHECK.md, its artifacts and sources from the pinned downloads (scripts/fetch-bench), and a Lake
# project on the shared read-only Mathlib (FVA_BENCH_PACKAGES, default
# ~/.cache/fva-bench/packages-v4.35.0: packagesDir points there, so nothing is copied or
# fetched). Arm fva: the project is `fva init`'s layout (FVA vendored in fva/, prebuilt from
# FVA_BENCH_FVA_BUILD, default this checkout's .lake/build); other arms: a project requiring
# Mathlib alone. FVA_BENCH_FVA_BIN = the `fva` whose package is vendored (default this
# checkout's). No symlinks: the harness refuses them.
set -euo pipefail
[[ $# == 3 ]] || {
	echo 'Usage: bench/tasks/prepare TASK ARM OUTDIR' >&2
	exit 2
}
task=$1 arm=$2 out=$3
root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
dl=$root/.cache/bench/downloads
pkgs=${FVA_BENCH_PACKAGES:-$HOME/.cache/fva-bench/packages-v4.35.0}
fvabuild=${FVA_BENCH_FVA_BUILD:-$root/.lake/build}
fva=${FVA_BENCH_FVA_BIN:-$root/.lake/build/bin/fva}
[[ -d $pkgs/mathlib/.lake/build ]] || {
	echo "prepare: no prebuilt Mathlib at $pkgs" >&2
	exit 2
}
[[ ! -e $out ]] || {
	echo "prepare: $out exists" >&2
	exit 2
}
case $arm in bare | prompted | tool | fva) ;; *) exit 2 ;; esac
if [[ $arm == fva ]]; then
	"$fva" init "$out" --lib Proofs >/dev/null
	mkdir -p "$out/fva/.lake"
	cp -a "$fvabuild" "$out/fva/.lake/build"
else
	mkdir -p "$out"
	cp "$root/lean-toolchain" "$out/"
	cat >"$out/lakefile.toml" <<'TOML'
name = "proofs"
defaultTargets = ["Proofs"]
allowNonModules = true

[[require]]
name = "mathlib"
git = "https://github.com/leanprover-community/mathlib4"
rev = "v4.35.0"

[[lean_lib]]
name = "Proofs"
TOML
	jq '.name = "proofs" | .packages |= map(.inherited = (.name != "mathlib"))' \
		"$root/lake-manifest.json" >"$out/lake-manifest.json"
	mkdir -p "$out/Proofs"
	printf '%s\n' '-- Library root: import your proof modules here.' >"$out/Proofs.lean"
fi
jq --arg d "$pkgs" '.packagesDir = $d' "$out/lake-manifest.json" >"$out/.m" &&
	mv "$out/.m" "$out/lake-manifest.json"
cp "$root/bench/tasks/CHECK.md" "$root/bench/tasks/$task/README.md" "$out/"
case $task in
lz4-wasm)
	"$root/scripts/fetch-bench" lz4-wasm lz4-wasm-source lz4-block-doc >/dev/null
	cp "$dl/lz4-wasm/lz4-block-codec.wasm" "$dl/lz4-wasm-source/lz4-block-codec.wat" \
		"$dl/lz4-block-doc/lz4_Block_format.md" "$out/"
	;;
edger-cpm)
	"$root/scripts/fetch-bench" edger-wasm edger-source >/dev/null
	cp "$dl/edger-wasm/edgeR.so" "$out/"
	mkdir -p "$out/src" "$out/R" "$out/man"
	t=$dl/edger-source/edgeR_4.99.10.tar.gz
	tar -xOzf "$t" edgeR/src/compute_cpm.c >"$out/src/compute_cpm.c"
	tar -xOzf "$t" edgeR/src/edgeR.h >"$out/src/edgeR.h"
	tar -xOzf "$t" edgeR/R/cpm.R >"$out/R/cpm.R"
	tar -xOzf "$t" edgeR/R/filterByExpr.R >"$out/R/filterByExpr.R"
	tar -xOzf "$t" edgeR/man/cpm.Rd >"$out/man/cpm.Rd"
	tar -xOzf "$t" edgeR/man/filterByExpr.Rd >"$out/man/filterByExpr.Rd"
	;;
*)
	echo "prepare: no inputs defined for task $task" >&2
	exit 2
	;;
esac
[[ -z $(find "$out" -type l -print -quit) ]]
