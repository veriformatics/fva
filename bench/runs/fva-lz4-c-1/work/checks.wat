(module
  (import "lz4" "memory" (memory 32 32))
  (import "lz4" "LZ4_decompress_safe" (func $decode (param i32 i32 i32 i32) (result i32)))
  (func $expect (param i32 i32)
    (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
  (data (i32.const 131072) "\10\41")
  (data (i32.const 131584) "\13\41\01\00\50\42\43\44\45\46")
  (data (i32.const 132096) "\1f\41\01\00\01\50\42\43\44\45\46")
  (data (i32.const 132608) "\03\00\00\50\42\43\44\45\46")
  (data (i32.const 133120) "\83\41\42\43\44\45\46\47\48\08\00\f0\00\61\62\63\64\65\66\67\68\69\6a\6b\6c\6d\6e\6f")
  (func (export "check") (result i32)
    ;; literal: output 41
    (memory.fill (i32.const 196608) (i32.const 165) (i32.const 1))
    (call $expect (call $decode (i32.const 131072) (i32.const 196608)
      (i32.const 2) (i32.const 1)) (i32.const 1))
    (call $expect (i32.load8_u (i32.const 196608)) (i32.const 65))
    ;; overlap: output 41414141414141414243444546
    (memory.fill (i32.const 197120) (i32.const 165) (i32.const 13))
    (call $expect (call $decode (i32.const 131584) (i32.const 197120)
      (i32.const 10) (i32.const 13)) (i32.const 13))
    (call $expect (i32.load (i32.const 197120)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197124)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197128)) (i32.const 0x45444342))
    (call $expect (i32.load8_u (i32.const 197132)) (i32.const 70))
    ;; longMatch: output 4141414141414141414141414141414141414141414243444546
    (memory.fill (i32.const 197632) (i32.const 165) (i32.const 26))
    (call $expect (call $decode (i32.const 132096) (i32.const 197632)
      (i32.const 11) (i32.const 26)) (i32.const 26))
    (call $expect (i32.load (i32.const 197632)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197636)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197640)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197644)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197648)) (i32.const 0x41414141))
    (call $expect (i32.load (i32.const 197652)) (i32.const 0x44434241))
    (call $expect (i32.load8_u (i32.const 197656)) (i32.const 69))
    (call $expect (i32.load8_u (i32.const 197657)) (i32.const 70))
    ;; zeroOffset: output 000000000000004243444546
    (memory.fill (i32.const 198144) (i32.const 165) (i32.const 12))
    (call $expect (call $decode (i32.const 132608) (i32.const 198144)
      (i32.const 9) (i32.const 12)) (i32.const 12))
    (call $expect (i32.load (i32.const 198144)) (i32.const 0x00000000))
    (call $expect (i32.load (i32.const 198148)) (i32.const 0x42000000))
    (call $expect (i32.load (i32.const 198152)) (i32.const 0x46454443))
    ;; shortcut: output 4142434445464748414243444546476162636465666768696a6b6c6d6e6f
    (memory.fill (i32.const 198656) (i32.const 165) (i32.const 64))
    (call $expect (call $decode (i32.const 133120) (i32.const 198656)
      (i32.const 28) (i32.const 64)) (i32.const 30))
    (call $expect (i32.load (i32.const 198656)) (i32.const 0x44434241))
    (call $expect (i32.load (i32.const 198660)) (i32.const 0x48474645))
    (call $expect (i32.load (i32.const 198664)) (i32.const 0x44434241))
    (call $expect (i32.load (i32.const 198668)) (i32.const 0x61474645))
    (call $expect (i32.load (i32.const 198672)) (i32.const 0x65646362))
    (call $expect (i32.load (i32.const 198676)) (i32.const 0x69686766))
    (call $expect (i32.load (i32.const 198680)) (i32.const 0x6d6c6b6a))
    (call $expect (i32.load8_u (i32.const 198684)) (i32.const 110))
    (call $expect (i32.load8_u (i32.const 198685)) (i32.const 111))
    (i32.const 0))
)
