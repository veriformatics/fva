theorem fastModule_eq : fastModule = Lifted.module := by
  kernel_rfl

noncomputable def initial : Store × ModuleInst :=
  (instantiate 4096 {} fastModule []).getD ({}, {})

theorem initial_some : (instantiate 4096 {} fastModule []).isSome = true := by
  kernel_rfl

theorem initial_instance (H : HostSem) : Instance Lifted.module H initial.1 initial.2 := by
  obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp initial_some
  rcases p with ⟨s, inst⟩
  have hi : Instance fastModule H s inst := instantiate_sound (by exact .nil) hp
  have he : initial = (s, inst) := by unfold initial; rw [hp]; rfl
  simpa only [he, fastModule_eq] using hi

end Proofs
