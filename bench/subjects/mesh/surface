#!/usr/bin/env bash
# D8: `fva trust`'s review surface on schildep/verified-3d-mesh-intersection (its README: "93 lines
# of formal specification") at 804ab774, ported to FVA's Lean 4.35 + Mathlib by port-v4.35.patch
# (proof-body repairs only; the four files its README names for review stay byte-identical). By
# hand (a 60k-line proof build), not a gate step. Usage: bench/subjects/mesh/surface [DIR]
# (default ~/.cache/fva-bench/mesh; an existing DIR at the patched tree is reused). Prints the
# report's "Read these" block; every CSG module of the spec's import closure except the four
# reviewed files is declared a subject (implementation + proofs).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
dir=${1:-${FVA_BENCH_HOME:-$HOME/.cache/fva-bench}/mesh}
spec=CSG.MeshIntersectWithPreconditionCheck
if [[ ! -d $dir/.git ]]; then
	git clone -q https://github.com/schildep/verified-3d-mesh-intersection.git "$dir"
	git -C "$dir" checkout -q 804ab774f1d059b3bdb7cf606b155553dccccdfd
	git -C "$dir" apply "$here/port-v4.35.patch"
fi
for f in DataStructures Def MeshIntersectWithPreconditionCheck WellFormedCheckMsg; do
	git -C "$dir" diff --quiet 804ab774f1d059b3bdb7cf606b155553dccccdfd -- "CSG/$f.lean" || {
		echo "surface: CSG/$f.lean differs from the upstream file" >&2
		exit 2
	}
done
# Mathlib + its dependencies by hard link (FVA's pins: the same revisions)
[[ -e $dir/.lake/packages ]] || { mkdir -p "$dir/.lake" && cp -al "$root/.lake/packages" "$dir/.lake/packages"; }
(cd "$dir" && lake build CSG >/dev/null)
# the spec module's import closure inside CSG
declare -A seen
queue=("$spec")
while ((${#queue[@]})); do
	m=${queue[0]}
	queue=("${queue[@]:1}")
	[[ -n ${seen[$m]:-} ]] && continue
	seen[$m]=1
	f=$dir/${m//.//}.lean
	[[ -f $f ]] || continue
	mapfile -t -O "${#queue[@]}" queue < <(sed -n 's/^\(public \)\?import \(all \)\?\(CSG[A-Za-z0-9_.]*\).*/\3/p' "$f")
done
subjects=()
for m in "${!seen[@]}"; do
	case $m in CSG.DataStructures | CSG.Def | "$spec" | CSG.WellFormedCheckMsg) ;; *) subjects+=(--subject "$m") ;; esac
done
"$root/.lake/build/bin/fva" trust "$dir" --spec-module "$spec" --root-module "$spec" "${subjects[@]}" |
	sed -n '/^Read these/,/^$/p'
