#!/usr/bin/env bash
# Builds glm-iround.wasm (T7): GLM 1.0.3 headers (unmodified) + bench/subjects/glm-shim/iround.cpp,
# a release build (NDEBUG: GLM's non-negativity assert compiled out, as in release code).
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
if [[ ${1:-} == --help ]]; then
	echo 'Usage: bench/subjects/build-glm [OUTPUT_DIR]'
	exit 0
fi
out=${1:-$root/.cache/bench/wasm}
mkdir -p "$out" "$root/.cache/bench"
out=$(realpath -e -- "$out")
"$root/scripts/fetch-bench" glm >/dev/null
export PATH=$root/.tools/bin:$PATH
clang=$root/.tools/wasi-sdk/bin/clang++
[[ $("$clang" -dumpversion) == 23.1.0-wasi-sdk ]] || {
	echo 'Expected WASI SDK clang 23.1.0' >&2
	exit 1
}
stage=$(mktemp -d "$root/.cache/bench/build.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
tar -xzf "$root/.cache/bench/downloads/glm/glm-1.0.3.tar.gz" -C "$stage"
"$clang" --target=wasm32-wasip1 -mcpu=generic -mno-simd128 -mno-relaxed-simd -std=c++17 \
	-DNDEBUG -O2 -fno-exceptions -nostdlib -I"$stage/glm-1.0.3" \
	-ffile-prefix-map="$stage=/build" -ffile-prefix-map="$root=/fva" \
	-Wl,--no-entry -Wl,--strip-all -Wl,--export=iround \
	"$root/bench/subjects/glm-shim/iround.cpp" -o "$stage/glm-iround.wasm"
wasm-tools validate --features=wasm2,-simd "$stage/glm-iround.wasm"
if wasm-tools print "$stage/glm-iround.wasm" | grep -q '(import '; then
	echo 'build-glm: unexpected imports' >&2
	exit 1
fi
mv "$stage/glm-iround.wasm" "$out/glm-iround.wasm"
(cd "$out" && sha256sum glm-iround.wasm)
