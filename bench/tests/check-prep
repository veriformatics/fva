#!/usr/bin/env bash
# Offline behavior: checked downloads + mock Codex only, never a real agent.
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
mkdir -p "$root/.cache/bench/tests"
tmp=$(mktemp -d "$root/.cache/bench/tests/prep.XXXXXXXX")
run_prefix=$(realpath -e -- "$HOME")/.cache/fva-bench/runs/bare-mock-$$
runs=()
cleanup() {
	rm -rf -- "$tmp"
	for run in "${runs[@]}"; do rm -rf -- "$run"; done
	rm -f -- "$(realpath -e -- "$HOME")"/.cache/fva-bench/harness-logs/*-mock-$$-*.log
	rm -f -- "$(realpath -e -- "$HOME")"/.cache/fva-bench/batches/mock-$$-*.order
}
trap cleanup EXIT
expect_rc() {
	local expected=$1 actual
	shift
	set +e
	"$@" >"$tmp/last.log" 2>&1
	actual=$?
	set -e
	if [[ $actual != "$expected" ]]; then
		printf 'Expected rc %s; got %s: %s\n' "$expected" "$actual" "$*" >&2
		cat "$tmp/last.log" >&2
		exit 1
	fi
}

printf 'verified subject fixture\n' >"$tmp/payload"
sha=$(sha256sum "$tmp/payload")
sha=${sha%% *}
jq -n --arg url "file://$tmp/payload" --arg sha "$sha" \
	'{schema:1,subjects:[{id:"fixture",name:"fixture",version:"1",upstream:$url,
    url:$url,file:"payload",sha256:$sha,license:"CC0-1.0"}]}' >"$tmp/manifest.json"
expect_rc 0 "$root/scripts/fetch-bench" --manifest "$tmp/manifest.json" --cache "$tmp/good"
cmp "$tmp/payload" "$tmp/good/fixture/payload"
jq '.subjects[0].sha256 = ("0" * 64)' "$tmp/manifest.json" >"$tmp/bad.json"
expect_rc 1 "$root/scripts/fetch-bench" --manifest "$tmp/bad.json" --cache "$tmp/bad"
grep -q 'sha256 mismatch for fixture' "$tmp/last.log"
printf 'tamper' >>"$tmp/good/fixture/payload"
expect_rc 1 "$root/scripts/fetch-bench" --manifest "$tmp/manifest.json" --cache "$tmp/good"
grep -q 'cached file' "$tmp/last.log"
jq '.subjects[0].id = "../escape"' "$tmp/manifest.json" >"$tmp/invalid.json"
expect_rc 1 "$root/scripts/fetch-bench" --manifest "$tmp/invalid.json" --cache "$tmp/invalid"
echo 'fetch: verified fixture, downloaded mismatch, cached mismatch, invalid manifest → pass'
jq -c 'del(.usage.cache_write_input_tokens, .usage.reasoning_output_tokens)' \
	"$root/bench/tests/fixtures/codex-events.jsonl" |
	jq -s -f "$root/bench/harness/codex-result.jq" |
	jq -e '.usage_complete and .usage.cache_write_input_tokens == null and
    .usage.reasoning_output_tokens == null and .usage.cost_usd == null' >/dev/null
echo 'parser: missing optional counters and dollar cost remain null → pass'

mkdir "$tmp/bin" "$tmp/inputs" "$tmp/inputs/.claude" "$tmp/inputs/.codex" "$tmp/inputs/.agents"
cp "$root/bench/tests/fixtures/mock-codex" "$tmp/bin/codex"
cp "$root/bench/tests/fixtures/codex-events.jsonl" "$tmp/bin/codex-events.jsonl"
chmod +x "$tmp/bin/codex"
printf 'task bytes\n' >"$tmp/inputs/input.txt"
for name in AGENTS.md AGENTS.override.md CLAUDE.md; do
	printf 'excluded configuration\n' >"$tmp/inputs/$name"
done
printf '{}\n' >"$tmp/inputs/.claude/settings.json"
printf '{}\n' >"$tmp/inputs/.mcp.json"
printf 'model = "contamination"\n' >"$tmp/inputs/.codex/config.toml"
printf '{"fixture":"fixture-auth-value"}\n' >"$tmp/auth.json"
: >"$tmp/jail-sentinel" # beside the mock's bound directory: the jail must hide it
export PATH=$tmp/bin:$PATH FVA_BENCH_MODEL=fixture-model FVA_BENCH_EFFORT=low
export FVA_BENCH_SECONDS=10 FVA_BENCH_AUTH_FILE=$tmp/auth.json
# Inert sentinels prove env -i does not inherit provider/model routing.
export CLAUDECODE=fixture-parent CLAUDE_CODE_SUBAGENT_MODEL=fixture-routing
export OPENAI_API_KEY=fixture-key ANTHROPIC_BASE_URL=https://example.invalid CODEX_HOME=$tmp/wrong-home
unset FVA_BENCH_PATH
cpus=$(awk '/^Cpus_allowed_list:/ { print $2 }' /proc/self/status)
printf 'success' >"$tmp/prompt"
expect_rc 0 "$root/bench/harness/run-session" --dry-run bare "mock-$$" 1 "$cpus" \
	"$tmp/prompt" "$tmp/inputs"
[[ ! -e $run_prefix-1 ]]
grep -q -- '--ignore-user-config' "$tmp/last.log"
grep -q -- '< /dev/null' "$tmp/last.log"
grep -q -- '--unshare-pid' "$tmp/last.log"
if grep -q fixture-auth-value "$tmp/last.log"; then exit 1; fi
index=0
for scenario in success agent-error malformed process-error timeout incomplete bad-usage partial-error; do
	index=$((index + 1))
	printf '%s' "$scenario" >"$tmp/prompt"
	export FVA_BENCH_SECONDS=10
	case $scenario in
	success)
		expected=0
		status=completed
		;;
	agent-error | partial-error)
		expected=1
		status=agent_error
		;;
	malformed | bad-usage)
		expected=1
		status=invalid_result
		;;
	process-error)
		expected=7
		status=process_error
		;;
	timeout)
		expected=124
		status=timeout
		export FVA_BENCH_SECONDS=1
		;;
	incomplete)
		expected=1
		status=incomplete_result
		;;
	esac
	run=$run_prefix-$index
	runs+=("$run")
	expect_rc "$expected" "$root/bench/harness/run-session" bare "mock-$$" "$index" \
		"$cpus" "$tmp/prompt" "$tmp/inputs"
	[[ -f $run/work/mock-invoked.txt && ! -e $run/codex/auth.json && -f $run/jail-tmp/mock-tmp-sentinel ]]
	jq -e --arg status "$status" --argjson rc "$expected" --arg bin "$tmp/bin" \
		'.status == $status and .exit_code == $rc and .wall_ms >= 0 and
      .duration_ms == .wall_ms and .codex_version == "codex-cli mock-1" and
      (.jail.tool | startswith("bubblewrap")) and (.jail.visible | index($bin)) != null and
      (.harness_commit | length) >= 40' "$run/result.json" >/dev/null
	if [[ $scenario == success || $scenario == partial-error ]]; then
		jq -e '.usage.input_tokens == 123 and .usage.output_tokens == 45 and
      .usage.cache_write_input_tokens == 6 and .usage.cache_read_input_tokens == 7 and
      .usage.cost_usd == null and .usage.reasoning_output_tokens == 2 and
      .usage.duration_api_ms == null and .turns_completed == 2' "$run/result.json" >/dev/null
	else
		jq -e '.usage == null' "$run/result.json" >/dev/null
	fi
	jq -e --argjson complete "$([[ $scenario == success ]] && echo true || echo false)" \
		'.usage_complete == $complete' "$run/result.json" >/dev/null
	jq -e '[.cpu_user_s, .cpu_sys_s, .max_rss_kb, .load1_start, .load1_end] | all(type == "number")' \
		"$run/result.json" >/dev/null
	if grep -q fixture-auth-value "$run/command.sh" "$run/metadata.json" "$run/result.json"; then exit 1; fi
	printf 'harness: mock %s → rc %s, metrics/status pass\n' "$scenario" "$expected"
done
expect_rc 1 "$root/bench/harness/run-session" bare "mock-$$" 1 "$cpus" "$tmp/prompt" "$tmp/inputs"
grep -q 'run already exists' "$tmp/last.log"
echo 'harness: dry-run, auth-only home/cleanup, config exclusion, env isolation, jail, overwrite refusal → pass'

# run-order (rubric addendum 2026-10-28 (3)): one run at a time in the file's order, memory gate,
# CHECK lines, run-batch's TSV rows.
mkdir "$tmp/order-inputs" "$tmp/prompts"
for arm in bare prompted; do cp -a "$tmp/inputs" "$tmp/order-inputs/$arm-mock-$$"; done
printf 'timeout' >"$tmp/prompts/prompted.txt" # mock: one event, then 5 s
printf 'success' >"$tmp/prompts/bare.txt"
printf 'prompted 21\nbare 22\n' >"$tmp/order"
order_env=(env FVA_BENCH_CPUS="$cpus" FVA_BENCH_PROMPTS="$tmp/prompts"
	FVA_BENCH_INPUTS="$tmp/order-inputs" FVA_BENCH_SECONDS=10)
expect_rc 2 env FVA_BENCH_CPUS="2 3" "$root/bench/harness/run-order" "mock-$$" "$tmp/order"
expect_rc 0 "${order_env[@]}" "$root/bench/harness/run-order" --dry-run "mock-$$" "$tmp/order"
[[ $(grep -o 'start: [a-z]* [0-9]*' "$tmp/last.log" | tr '\n' ' ') == 'start: prompted 21 start: bare 22 ' ]]
[[ ! -e ${run_prefix%/*}/prompted-mock-$$-21 && ! -e $run_prefix-22 ]]
runs+=("${run_prefix%/*}/prompted-mock-$$-21" "$run_prefix-22" "$run_prefix-23")
expect_rc 0 "${order_env[@]}" FVA_BENCH_CHECK_FIRST=1 FVA_BENCH_CHECK_EVERY=1 FVA_BENCH_MIN_FREE_GB=0 \
	"$root/bench/harness/run-order" "mock-$$" "$tmp/order"
(($(grep -c 'CHECK prompted 21 elapsed=' "$tmp/last.log") >= 2))
[[ $(grep -o -e 'end: prompted 21' -e 'start: bare 22' "$tmp/last.log" | tr '\n' ' ') == 'end: prompted 21 start: bare 22 ' ]]
grep -q -P '^prompted\t21\t.*\tincomplete_result\t' "$tmp/last.log"
grep -q -P '^bare\t22\t.*\tcompleted\t' "$tmp/last.log"
printf 'bare 23\n' >"$tmp/order-gate"
expect_rc 124 "${order_env[@]}" FVA_BENCH_MIN_FREE_GB=1000000 timeout 3 \
	"$root/bench/harness/run-order" "mock-$$" "$tmp/order-gate"
grep -q 'wait: bare 23' "$tmp/last.log"
[[ ! -e $run_prefix-23 ]]
echo 'run-order: one CPU, dry-run order, sequential runs, CHECK lines, TSV rows, memory gate → pass'
expect_rc 0 env FVA_BENCH_N=2 "$root/bench/harness/run-batch" --order-only "mock-$$" 7 bare prompted
order=$(tail -n 1 "$tmp/last.log")
cp "$order" "$tmp/order-first"
expect_rc 0 env FVA_BENCH_N=2 "$root/bench/harness/run-batch" --order-only "mock-$$" 7 bare prompted
cmp "$order" "$tmp/order-first"
[[ $(sort "$order" | tr '\n' ' ') == 'bare 1 bare 2 prompted 1 prompted 2 ' ]]
[[ ! -e $(realpath -e -- "$HOME")/.cache/fva-bench/inputs/mock-$$ ]]
echo 'run-batch --order-only: seeded order reproduced byte for byte, every run once, no inputs prepared → pass'

# archive refuses a run whose event log or agent files hold a secret of the auth file
fake=$tmp/fake-run
mkdir -p "$fake/work"
printf '{"status":"completed"}\n' >"$fake/result.json"
printf '{}\n' >"$fake/metadata.json"
: >"$fake/inputs.sha256"
printf 'agent proof\n' >"$fake/work/Proof.lean"
printf '{"tokens":{"access_token":"fixture-secret-0123456789abcdefghij"}}\n' >"$tmp/fake-auth.json" # gitleaks:allow (fixture)
printf '{"type":"item.completed","item":{"aggregated_output":"no secret"}}\n' >"$fake/stdout.jsonl"
expect_rc 0 env FVA_BENCH_AUTH_FILE="$tmp/fake-auth.json" "$root/bench/grade/archive" "$fake" \
	"$tmp/arch-clean"
[[ -f $tmp/arch-clean/work/Proof.lean && -f $tmp/arch-clean/stdout.jsonl.gz ]]
mkdir -p "$tmp/home/.codex"
cp -- "$tmp/fake-auth.json" "$tmp/home/.codex/auth.json"
expect_rc 2 env -u FVA_BENCH_AUTH_FILE HOME="$tmp/home" "$root/bench/grade/archive" "$fake" \
	"$tmp/arch-unset"
grep -q 'FVA_BENCH_AUTH_FILE must name' "$tmp/last.log"
[[ ! -e $tmp/arch-unset ]]
printf '{"item":{"aggregated_output":"fixture-secret-0123456789abcdefghij"}}\n' >>"$fake/stdout.jsonl"
expect_rc 1 env FVA_BENCH_AUTH_FILE="$tmp/fake-auth.json" "$root/bench/grade/archive" "$fake" \
	"$tmp/arch-leak"
grep -q 'refusing to archive' "$tmp/last.log"
[[ ! -e $tmp/arch-leak ]]
echo 'archive: clean run archived, unset screen list refused (no home default), run holding an auth secret refused → pass'
