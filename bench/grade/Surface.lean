import Lean

/-! M5 statement closure for one rebuilt run project (`bench/grade/surface`): every run-authored
declaration the named theorems' statements reach, through definition bodies, constructors and
structure fields, never through proofs, with its source lines. Run-authored = its module's
`.lean` file sits in the project outside `fva/` and `.lake/` and is not `fva lift` / `fva blob`
output (generated subject bytes stop the walk, as in `fva trust`). Theorems count their statement
lines alone (up to the proof's `:=`); a declaration whose source spans more than 200 lines with
mostly numerals is reported as data. Output (TSV): `decl` rows, then `total`, then `shared` =
constants outside the project the closure reaches, by top-level namespace. -/

open Lean

/-- Worklist closure over constant names. -/
partial def walk (env : Environment) (inProject : Name → Bool) (todo : List Name)
    (seen : NameSet) (frontier : NameSet) : NameSet × NameSet :=
  match todo with
  | [] => (seen, frontier)
  | c :: rest =>
    if seen.contains c || frontier.contains c then walk env inProject rest seen frontier
    else if !inProject c then walk env inProject rest seen (frontier.insert c)
    else
      let next := match env.find? c with
        | some (.defnInfo d) => d.type.getUsedConstants ++ d.value.getUsedConstants
        | some (.opaqueInfo d) => d.type.getUsedConstants ++ d.value.getUsedConstants
        | some (.thmInfo t) => t.type.getUsedConstants
        | some (.inductInfo i) => i.type.getUsedConstants ++ i.ctors.toArray
        | some ci => ci.type.getUsedConstants
        | none => #[]
      walk env inProject (next.toList ++ rest) (seen.insert c) frontier

/-- The line holding the start of a theorem's proof: the first `:=` ending a line or followed by
`by`, else the first `:=`, from line `from` on. -/
def proofLine (lines : Array String) (start stop : Nat) : Nat := Id.run do
  let mut first := none
  for i in [start:stop + 1] do
    let l := lines.getD (i - 1) ""
    for part in (l.splitOn ":=").drop 1 do
      let p := String.ofList (part.toList.dropWhile Char.isWhitespace)
      if first.isNone then first := some i
      if p.isEmpty || p.startsWith "by" then return i
  return first.getD stop

def main (args : List String) : IO UInt32 := do
  let root :: modName :: thms := args | do
    IO.eprintln "Usage: lake env lean --run Surface.lean PROJECT_ROOT MODULE[,MODULE…] THEOREM..."
    return 2
  initSearchPath (← findSysroot)
  let mods := (modName.splitOn ",").toArray.map fun m => ({ module := m.toName } : Import)
  let env ← importModules mods {} (loadExts := false)
  let pathOf (m : Name) : System.FilePath :=
    (m.components.foldl (fun p c => p / c.toString) (root : System.FilePath)).addExtension "lean"
  let mut projMods : NameSet := {}
  let mut generated : NameSet := {}
  for m in env.header.moduleNames do
    let p := pathOf m
    let top := m.components.headD .anonymous
    if top.toString != "fva" && (← p.pathExists) then
      let head := String.intercalate "\n" (((← IO.FS.readFile p).splitOn "\n").take 4)
      if (head.splitOn "Generated by `fva").length > 1 then generated := generated.insert m
      else projMods := projMods.insert m
  let modOf (c : Name) : Option Name := do
    let idx ← env.getModuleIdxFor? c
    env.header.moduleNames[idx.toNat]?
  let inProject (c : Name) : Bool := match modOf c with
    | some m => projMods.contains m
    | none => false
  let roots := thms.map String.toName
  for t in roots do
    unless env.contains t do
      IO.eprintln s!"surface: unknown theorem {t}"
      return 2
  let (seen, frontier) := walk env inProject roots {} {}
  -- one row per source range (auxiliary declarations share their parent's range)
  let ctx : Core.Context := { fileName := "<surface>", fileMap := default }
  let (found, _) ← (seen.toList.mapM fun c => return (c, ← findDeclarationRanges? c) :
    CoreM _).toIO ctx { env }
  let mut rows : Array (String × Nat × Nat × String × String) := #[]
  let mut ranges : Std.HashSet (String × Nat) := {}
  let mut files : Std.HashMap String (Array String) := {}
  for (c, r?) in found do
    let some m := modOf c | continue
    let some r := r? | continue
    let file := (pathOf m).toString
    unless files.contains file do
      files := files.insert file ((← IO.FS.readFile file).splitOn "\n").toArray
    let src := files.getD file #[]
    let s := r.range.pos.line
    let mut e := r.range.endPos.line
    let kind := match env.find? c with
      | some (.thmInfo _) => "theorem"
      | some (.defnInfo _) => "def"
      | some (.inductInfo _) => "inductive"
      | some (.opaqueInfo _) => "opaque"
      | some (.axiomInfo _) => "axiom"
      | _ => "other"
    if kind == "theorem" then e := proofLine src s e
    if ranges.contains (file, s) then continue
    ranges := ranges.insert (file, s)
    let body := String.intercalate "\n" ((src.extract (s - 1) e).toList)
    let digits := body.foldl (fun n ch => if ch.isDigit then n + 1 else n) 0
    let kind := if e + 1 - s > 200 && digits * 2 > body.length then "data" else kind
    rows := rows.push (m.toString, s, e, c.toString, kind)
  let mut total := 0
  let mut data := 0
  for (m, s, e, c, kind) in rows.qsort (fun a b => a.1 < b.1 || (a.1 == b.1 && a.2.1 < b.2.1)) do
    let n := e + 1 - s
    if kind == "data" then data := data + n else total := total + n
    IO.println s!"decl\t{m}\t{c}\t{kind}\t{s}\t{e}\t{n}"
  IO.println s!"total\t{total}\tlines\t{rows.size}\tranges\tdata {data}"
  let mut shared : Std.HashMap String Nat := {}
  for c in frontier.toList do
    let top := match modOf c with
      | some m =>
        if generated.contains m then "subject" else (m.components.headD .anonymous).toString
      | none => "?"
    shared := shared.insert top (shared.getD top 0 + 1)
  for (k, n) in shared.toList do IO.println s!"shared\t{k}\t{n}"
  return 0
