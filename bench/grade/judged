#!/usr/bin/env bash
# Judgment-derived M5 figures (D73) from committed state: each run's figure, then the arm's
# median [min–max]. Checker scripts = non-blank lines of the run's archived .sh/.py/.mjs/.js files
# (results.md M5); judgments/glm-iround-checker.tsv adds T7's documented check commands. T2's
# tool partition = judgments/lz4-c-m5.tsv (statement = ACSL lines, link/model = C code lines of
# the selected ranges, `acsl-lines`); T3's = m5-tool (statement + model code, results.md T3/M5).
# Every judgment row's source is sha256-pinned. Usage: judged lz4-c|lz4-rust|glm-iround.
set -euo pipefail
grade=$(dirname "$(realpath -e "${BASH_SOURCE[0]}")")
repo=$(realpath -e "$grade/../..")
judgments=${FVA_GRADE_JUDGMENTS:-$grade/judgments}
cd "$repo"
[[ $# == 1 && $1 =~ ^(lz4-c|lz4-rust|glm-iround)$ ]] || {
	echo "usage: bench/grade/judged lz4-c|lz4-rust|glm-iround" >&2
	exit 2
}
task=$1
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
# median [min–max] per arm of `arm<TAB>value` lines
summary() {
	sort -k1,1 -k2,2n | awk -F'\t' -v label="$1" '
	{v[$1][++n[$1]]=$2}
	END {for(a in n){k=n[a];m=k%2?v[a][(k+1)/2]:(v[a][k/2]+v[a][k/2+1])/2
		printf "%s\t%s\t%g [%g–%g]\n",label,a,m,v[a][1],v[a][k]}}' | sort
}
# a judgment row's source, pinned: realpath inside the run's work dir + sha256
source_of() { # run file sha256
	local f
	f=$(realpath -e "bench/runs/$1/work/$2") || exit 2
	[[ $f == "$repo/bench/runs/$1/work/"* && $(sha256sum "$f" | cut -d' ' -f1) == "$3" ]] || {
		echo "judged: $1 $2 is not the pinned source" >&2
		exit 2
	}
	printf '%s\n' "$f"
}
runs=$(cut -f1 "$grade/manifests/m8-$task.tsv")
for m in "$grade/manifests/"{wp,verus}-cmds-"$task".tsv; do
	[[ ! -f $m ]] || runs+=$'\n'$(cut -f1 "$m" | sort -u)
done
for r in $runs; do
	n=$(git ls-files -z "bench/runs/$r/work" | grep -zE '\.(sh|py|mjs|js)$' | xargs -0 -r cat | grep -c . || true)
	printf '%s\t%s\n' "$r" "$n"
done >"$tmp/scripts"
if [[ $task == glm-iround ]]; then
	j=$judgments/glm-iround-checker.tsv
	[[ -f $j ]] || exit 2
	# documented check commands: non-blank lines of the selected ranges
	while IFS=$'\t' read -r r file ranges _src sha _reason; do
		[[ -z $r || $r == \#* || $file == - ]] && continue
		f=$(source_of "$r" "$file" "$sha")
		awk -v rs="$ranges" 'BEGIN{n=split(rs,p,",");for(i=1;i<=n;i++){split(p[i],x,"-");a[i]=x[1];b[i]=(x[2]==""?x[1]:x[2])}}
			{for(i=1;i<=n;i++) if(FNR>=a[i]&&FNR<=b[i]&&$0~/[^[:space:]]/){c++;break}} END{printf "%s\t%d\n",run,c}' run="$r" "$f"
	done <"$j" >>"$tmp/scripts"
fi
awk -F'\t' '{s[$1]+=$2} END {for(r in s){a=r;sub(/-.*/,"",a);print a "\t" s[r]}}' "$tmp/scripts" | summary checker
case $task in
lz4-c)
	j=$judgments/lz4-c-m5.tsv
	[[ -f $j ]] || exit 2
	while IFS=$'\t' read -r r kind file ranges _src sha _reason; do
		[[ -z $r || $r == \#* ]] && continue
		[[ $file != - ]] || {
			printf '%s\t%s\t0\n' "$r" "$kind"
			continue
		}
		f=$(source_of "$r" "$file" "$sha")
		IFS=, read -ra rs <<<"$ranges"
		for x in "${rs[@]}"; do "$grade/acsl-lines" "$f:$x"; done |
			awk -F'\t' -v r="$r" -v k="$kind" '{sub(/^acsl /,"",$2);sub(/^c /,"",$3);n+=(k=="statement"?$2:$3)}
				END{print r "\t" k "\t" n+0}'
	done <"$j" | awk -F'\t' '{v[$1][$2]+=$3} END {for(r in v) print r "\t" v[r]["statement"]+0 "\t" v[r]["link-model"]+0}' >"$tmp/m5"
	;;
lz4-rust)
	"$grade/m5-tool" lz4-rust | awk -F'\t' '{s=$2;m=$3;sub(/.* /,"",s);sub(/.* /,"",m);print $1 "\t" s "\t" m}' >"$tmp/m5"
	;;
esac
if [[ -s $tmp/m5 ]]; then
	awk -F'\t' '{print "tool\t" $2+$3}' "$tmp/m5" | summary M5-tool-total
	awk -F'\t' '{print "tool\t" $2}' "$tmp/m5" | summary M5-tool-statement
	awk -F'\t' '{print "tool\t" $3}' "$tmp/m5" | summary M5-tool-link-model
fi
