#!/usr/bin/env bash
# Archives one finished run for grading and the record: result.json, metadata.json, the
# gzipped event log, and every work file the agent created or changed (the inputs are
# re-derivable from bench/tasks/prepare; build outputs are not kept).
set -euo pipefail
[[ $# == 2 ]] || {
	echo 'Usage: bench/grade/archive RUN_DIR OUT_DIR' >&2
	exit 2
}
run=$(realpath -e -- "$1") out=$2
[[ -f $run/result.json && -f $run/inputs.sha256 ]] || {
	echo "archive: $run is not a finished run" >&2
	exit 2
}
[[ ! -e $out ]] || {
	echo "archive: $out exists" >&2
	exit 2
}
# The run could read its copy of the Codex auth file (inside the run directory); a secret in the
# event log or the agent's files would reach the repo inside a .gz, which gitleaks does not open.
auth=${FVA_BENCH_AUTH_FILE:-$HOME/.codex/auth.json}
[[ -f $auth ]] || {
	echo "archive: no auth file $auth to screen against (set FVA_BENCH_AUTH_FILE)" >&2
	exit 2
}
while IFS= read -r secret; do
	if grep -rqF --exclude-dir=.lake --exclude-dir=.git --exclude-dir=target -- "${secret:0:24}" \
		"$run/stdout.jsonl" "$run/work" 2>/dev/null; then
		echo "archive: $run holds a secret of $auth; refusing to archive" >&2
		exit 1
	fi
done < <(jq -r '.. | strings | select(length >= 24)' "$auth")
mkdir -p "$out/work"
cp "$run/result.json" "$run/metadata.json" "$out/"
gzip -9 -c "$run/stdout.jsonl" >"$out/stdout.jsonl.gz"
declare -A input
while read -r sha path; do input[$path]=$sha; done <"$run/inputs.sha256"
# derived outputs stay out: build trees, caches, kernel exports (each rerun regenerates them)
(cd "$run/work" && find . \( -path ./.lake -o -path ./fva/.lake -o -path '*/target' -o \
	-path ./.git -o -name __pycache__ -o -name .cache -o -name .lake \) -prune -o -type f \
	! -name '*.olean' ! -name '*.ilean' ! -name '*.olean.hash' ! -name '*.ilean.hash' \
	! -name '*.trace' ! -name '*.ndjson' -print0) |
	while IFS= read -r -d '' f; do
		sha=$(sha256sum "$run/work/$f")
		sha=${sha%% *}
		[[ ${input[$f]:-} == "$sha" ]] && continue
		mkdir -p "$out/work/$(dirname "$f")"
		cp -p "$run/work/$f" "$out/work/$f"
	done
echo "archive: $(find "$out/work" -type f | wc -l) agent files → $out"
