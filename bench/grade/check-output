#!/usr/bin/env bash
# Completion = every selected claim checked, every surface measured, every cheat + C0 recorded.
set -euo pipefail
[[ $# == 2 ]] || exit 2
grade=$(dirname "$(realpath -e "${BASH_SOURCE[0]}")")
task=$1 out=$(realpath -e "$2")
[[ -f $grade/manifests/m8-$task.tsv ]] || exit 2
awk -F '\t' '
ARGIND==1 {runs[$1]=1;next}
FILENAME ~ /\.claims$/ {
	run=FILENAME;sub(/.*\//,"",run);sub(/\.claims$/,"",run)
	if(!(run in runs)) {print "check-output: stale claims " run > "/dev/stderr";bad=1;next}
	claims[run SUBSEP $1 SUBSEP $2]=1;claimCount[run]++;next
}
FILENAME ~ /\/m[158](-base)?\.tsv$/ && !($1 in runs) {
	print "check-output: unexpected run " $1 > "/dev/stderr";bad=1;next
}
FILENAME ~ /\/m1.tsv$/ && $4 ~ /^axioms=/ &&
$5 ~ /^leanchecker=(accept|reject\([0-9]+\))$/ &&
$6 ~ /^con-leche=(accept|reject\([0-9]+\))$/ {
	# Launcher/timeout (124..127) + signal-style (128+) statuses need a rerun.
	if($5 ~ /reject\((12[4-9]|1[3-9][0-9]|2[0-9][0-9])\)/ ||
	   $6 ~ /reject\((12[4-9]|1[3-9][0-9]|2[0-9][0-9])\)/) {
		print "check-output: checker resource/crash status " $1 " " $3 > "/dev/stderr";bad=1;next
	}
	checked[$1 SUBSEP $2 SUBSEP $3]=1;next
}
FILENAME ~ /\/m5.tsv$/ {
	if($2=="rc") {surfaceRC[$1]=$3;surfaceSeen[$1]=1}
	if($2=="total") surface[$1]++
	next
}
FILENAME ~ /\/m8.tsv$/ && $2 ~ /^C[1-4]/ {
	split($2,cheat,"-");cheats[$1 SUBSEP cheat[1]]++
	if($3 !~ /^rc=[0-9]+$/ || $4 !~ /^named=(yes|no)$/) bad=1
	next
}
FILENAME ~ /\/m8-base.tsv$/ && $2=="C0-clean" {
	baseline[$1]++;if($3 !~ /^rc=[0-9]+$/) bad=1
}
END {
	for(k in claims) if(!checked[k]) {
		split(k,p,SUBSEP)
		print "check-output: unconfirmed claim " p[1] " " p[2] " " p[3] > "/dev/stderr";bad=1
	}
	for(r in runs) {
		if(!claimCount[r]) {print "check-output: empty claims " r > "/dev/stderr";bad=1}
		if(surface[r]!=1 || !surfaceSeen[r] || surfaceRC[r]!=0) {
			print "check-output: missing/failed surface " r > "/dev/stderr";bad=1
		}
		if(baseline[r]!=1) {print "check-output: missing/duplicate C0 " r > "/dev/stderr";bad=1}
		for(c=1;c<=4;c++) if(cheats[r SUBSEP "C" c]!=1) {
			print "check-output: missing/duplicate C" c " " r > "/dev/stderr";bad=1
		}
	}
	exit bad ? 2 : 0
}' "$grade/manifests/m8-$task.tsv" "$out/"*.claims \
	"$out/m1.tsv" "$out/m5.tsv" "$out/m8.tsv" "$out/m8-base.tsv"
# Tool arm (T2 Frama-C, T3 Verus): one M1 row per documented command, each cheat once per planting
# row, one C0 per run; every status numeric (C3 may be n/a).
tool=$grade/manifests/m8-tool-$task.tsv
if [[ -f $tool ]]; then
	cmds=
	for f in "$grade/manifests/"{wp,verus}-cmds-"$task".tsv; do
		[[ ! -f $f ]] || {
			[[ -z $cmds ]] || exit 2
			cmds=$f
		}
	done
	[[ -n $cmds ]] || exit 2
	awk -F '\t' '
	ARGIND==1 && $1 !~ /^(#|$)/ {cmd++;next}
	ARGIND==2 && $1 !~ /^(#|$)/ {rows[$1]++;next}
	ARGIND==3 {m1++;if($3 !~ /^rc=[0-9]+$/) {print "check-output: tool M1 " $1 " " $3 > "/dev/stderr";bad=1};next}
	ARGIND==4 {
		for(i=2;i<=NF;i++) if($i ~ /^C[1-4]-/) break
		if(i>NF || $(i+1) !~ /^rc=([0-9]+|n\/a)$/) {print "check-output: tool M8 row " $0 > "/dev/stderr";bad=1;next}
		cheats[$1 SUBSEP substr($i,1,2)]++;next
	}
	ARGIND==5 && $2=="C0-clean" {base[$1]++;if($3 !~ /^rc=[0-9]+$/) bad=1}
	END {
		if(m1!=cmd) {print "check-output: tool M1 rows " m1 " of " cmd > "/dev/stderr";bad=1}
		for(r in rows) {
			if(base[r]!=1) {print "check-output: missing/duplicate tool C0 " r > "/dev/stderr";bad=1}
			for(c=1;c<=4;c++) if(cheats[r SUBSEP "C" c]!=rows[r]) {
				print "check-output: missing/duplicate tool C" c " " r > "/dev/stderr";bad=1
			}
		}
		exit bad ? 2 : 0
	}' "$cmds" "$tool" "$out/m1-tool.tsv" "$out/m8-tool.tsv" "$out/m8-tool-base.tsv"
fi
printf 'check-output: %s claims/surfaces/cheats/baselines complete\n' "$task"
