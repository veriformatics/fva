#!/usr/bin/env bash
# M8 independence (rubric): copies a finished project once per cheat — C1 `sorry`, C2
# `axiom False`, C3 kernel bypass (`debug.skipKernelTC`), C4 one changed byte of the artifact —
# plants it in THEOREM (C1–C3) or the artifact (C4), runs the arm's own check command CMD in
# the copy, and writes one line per cheat: cheat, rc, whether the output names the cheat. A
# catch = rc ≠ 0 or the output naming it; confirm each catch's cause in its log, since a
# planting that breaks the file's syntax also exits nonzero.
set -euo pipefail
[[ $# == 6 ]] || {
	echo 'Usage: bench/grade/inject PROJECT LEAN_FILE THEOREM ARTIFACT CMD OUT_DIR' >&2
	exit 2
}
proj=$(realpath -e -- "$1") lean=$2 artifact=$4 cmd=$5 out=$6
# the declaration may spell its last one or two name components (`lemma LogCert.sound`)
thm=${3##*.}
two=${3%.*}
two=${two##*.}.$thm
[[ $3 == *.*.* || $3 == *.* ]] || two=$thm
limit=${FVA_BENCH_INJECT_SECONDS:-3600}
mkdir -p "$out"
plant() { # file theorem pre proof
	awk -v thm="$2" -v two="$two" -v pre="$3" -v proof="$4" '
	function decl(l) { return l ~ /^(@\[|\/--|\/-!|private |protected |theorem |lemma |def |abbrev |structure |inductive |instance |example |end |namespace |section |open |#|set_option |run_cmd |axiom |noncomputable )/ }
	{ line[NR] = $0 }
	END {
		for (i = 1; i <= NR; i++) if (line[i] ~ ("^(private |protected )?(theorem|lemma) (" thm "|" two ")([ :({[]|$)")) { t = i; break }
		if (!t) { print "inject: no theorem " thm > "/dev/stderr"; exit 2 }
		# attributes and the docstring stay above the planted text; a docstring may span lines, so its
		# closing `-/` line walks back to the `/--` that opens it (a plain `/-` comment stops the walk)
		s = t
		while (s > 1) {
			if (line[s - 1] ~ /^(@\[|\/--)/) { s--; continue }
			if (line[s - 1] ~ /-\/[ \t]*$/) {
				for (j = s - 1; j >= 1 && index(line[j], "/-") == 0; j--);
				if (j >= 1 && line[j] ~ /^\/--/) { s = j; continue }
			}
			break
		}
		e = NR + 1; for (j = t + 1; j <= NR; j++) if (decl(line[j])) { e = j; break }
		block = ""; for (j = s; j < e; j++) block = block line[j] "\n"
		# the proof starts at the first `:=` ending a line or followed by `by` (a `let … :=` inside the
		# statement does neither), else at the first `:=`
		k = 0; rest = block; off = 0
		while ((i = index(rest, ":=")) > 0) {
			after = substr(rest, i + 2)
			if (after ~ /^[ \t]*(\n|by([ \t\n]|$))/) { k = off + i; break }
			off += i + 1; rest = substr(rest, i + 2)
		}
		if (!k) k = index(block, ":=")
		if (!k) { print "inject: no := in " thm > "/dev/stderr"; exit 2 }
		for (j = 1; j < s; j++) print line[j]
		printf "%s%s:= %s\n\n", pre, substr(block, 1, k - 1), proof
		for (j = e; j <= NR; j++) print line[j]
	}' "$1" >"$1.new" && mv "$1.new" "$1"
}
for cheat in C1-sorry C2-axiom C3-kernel-bypass C4-artifact-byte; do
	w=$out/$cheat
	rm -rf "$w"
	cp -a "$proj" "$w"
	case $cheat in
	C1-sorry) plant "$w/$lean" "$thm" "" "by sorry" ;;
	C2-axiom) plant "$w/$lean" "$thm" $'axiom fvaCheatAx : False\n\n' "fvaCheatAx.elim" ;;
	C3-kernel-bypass)
		plant "$w/$lean" "$thm" $'open Lean Elab Command in\nset_option debug.skipKernelTC true in\nrun_cmd liftCoreM <| addDecl <| .thmDecl {\n  name := `fvaCheatOneEqTwo, levelParams := [],\n  type := mkApp3 (mkConst ``Eq [1]) (mkConst ``Nat) (mkNatLit 1) (mkNatLit 2),\n  value := mkApp2 (mkConst ``Eq.refl [1]) (mkConst ``Nat) (mkNatLit 1) }\n\n' \
			"absurd fvaCheatOneEqTwo (by decide)"
		# `import Lean` goes after a leading `prelude` or `module` line, else first
		if ! grep -q '^import Lean$' "$w/$lean"; then
			if head -n1 "$w/$lean" | grep -qxE 'prelude|module'; then
				sed -i '1a import Lean' "$w/$lean"
			else
				sed -i '1i import Lean' "$w/$lean"
			fi
		fi
		;;
	C4-artifact-byte)
		size=$(stat -c %s "$w/$artifact")
		b=$(od -An -tu1 -j $((size - 2)) -N1 "$w/$artifact" | tr -d ' ')
		printf '%b' "$(printf '\\%03o' $(((b + 1) % 256)))" |
			dd of="$w/$artifact" bs=1 seek=$((size - 2)) conv=notrunc status=none
		;;
	esac
	set +e
	(cd "$w" && timeout "$limit" bash -c "$cmd") >"$w.log" 2>&1
	rc=$?
	set -e
	# named = the output names this cheat itself (generic words such as `axioms` or `kernel` also
	# appear in clean output, so they are no evidence)
	case $cheat in
	C1-sorry) pat='sorryAx|declaration uses .sorry' ;;
	C2-axiom) pat='fvaCheatAx' ;;
	C3-kernel-bypass) pat='fvaCheatOneEqTwo' ;;
	C4-artifact-byte) pat='mismatch|FAILED|differ|changed' ;;
	esac
	named=no
	grep -qiE "$pat" "$w.log" && named=yes
	printf '%s\trc=%s\tnamed=%s\n' "$cheat" "$rc" "$named"
done | tee "$out/summary.tsv"
